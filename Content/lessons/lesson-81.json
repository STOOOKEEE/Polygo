    {
      "id": "block-lesson-81-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你是几年级的学生？",
          "pinyin": "nǐ shì jǐ nián jí de xué shēng?",
          "translation": {
            "fr": "Tu es en quelle année scolaire ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我上三年级。其实我喜欢说普通话。",
          "pinyin": "wǒ shàng sān nián jí. qí shí wǒ xǐ huan shuō pǔ tōng huà.",
          "translation": {
            "fr": "Je suis en troisième année. En fait, j’aime parler mandarin standard."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "其他同学用铅笔写吗？",
          "pinyin": "qí tā tóng xué yòng qiān bǐ xiě ma?",
          "translation": {
            "fr": "Les autres élèves écrivent-ils au crayon ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，老师说这样比较清楚。",
          "pinyin": "shì, lǎo shī shuō zhè yàng bǐ jiào qīng chu.",
          "translation": {
            "fr": "Oui, le professeur dit que c’est plus clair ainsi."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 77
      }
    },
    {
