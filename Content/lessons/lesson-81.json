      "paragraphs": [
        {
          "id": "lesson-81-p1",
          "hanzi": "Tao上三年级，喜欢在课堂上说普通话。",
          "pinyin": "Tao shàng sān nián jí, xǐ huan zài kè táng shàng shuō pǔ tōng huà.",
          "translation": {
            "fr": "Tao est en troisième année et aime parler mandarin standard en classe."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-81-p2",
          "hanzi": "其他同学用铅笔写，老师觉得字很清楚。",
          "pinyin": "qí tā tóng xué yòng qiān bǐ xiě, lǎo shī jué de zì hěn qīng chu.",
          "translation": {
            "fr": "Les autres élèves écrivent au crayon et le professeur trouve les caractères très clairs."
          },
          "segmentation": [],
          "audio": null
        }
