    {
      "id": "block-lesson-63-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "我来介绍一下，这是我哥哥。",
          "pinyin": "wǒ lái jiè shào yí xià, zhè shì wǒ gē ge.",
          "translation": {
            "fr": "Je te présente mon grand frère."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你好！很高兴认识你。",
          "pinyin": "nǐ hǎo! hěn gāo xìng rèn shi nǐ.",
          "translation": {
            "fr": "Bonjour ! Enchantée de te rencontrer."
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "欢迎来我们家！你想喝红茶还是喝水？",
          "pinyin": "huān yíng lái wǒ men jiā! nǐ xiǎng hē hóng chá hái shi hē shuǐ?",
          "translation": {
            "fr": "Bienvenue chez nous ! Tu veux du thé rouge ou de l’eau ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "红茶！在法国，我们叫它黑茶。",
          "pinyin": "hóng chá! zài fǎ guó, wǒ men jiào tā hēi chá.",
          "translation": {
            "fr": "Du thé rouge ! En France, on l’appelle thé noir."
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "是吗？我们的红茶，水是红的，所以叫红茶。",
          "pinyin": "shì ma? wǒ men de hóng chá, shuǐ shì hóng de, suǒ yǐ jiào hóng chá.",
          "translation": {
            "fr": "Ah bon ? Chez nous, l’eau de ce thé est rouge, alors on dit thé rouge."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "来，吃菜吧！我哥哥做的菜很好吃。",
          "pinyin": "lái, chī cài ba! wǒ gē ge zuò de cài hěn hǎo chī.",
          "translation": {
            "fr": "Allez, mangeons ! Les plats de mon frère sont délicieux."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这个菜太好吃了！",
          "pinyin": "zhè ge cài tài hǎo chī le!",
          "translation": {
            "fr": "Ce plat est trop bon !"
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "你喜欢，就多吃一点。",
          "pinyin": "nǐ xǐ huān, jiù duō chī yì diǎn.",
          "translation": {
            "fr": "Si tu aimes, reprends-en."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "吃完了，我们出去走走吧。",
          "pinyin": "chī wán le, wǒ men chū qù zǒu zou ba.",
          "translation": {
            "fr": "Quand on aura fini, allons faire un tour dehors."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好！谢谢你的红茶和菜。",
          "pinyin": "hǎo! xiè xie nǐ de hóng chá hé cài.",
          "translation": {
            "fr": "D’accord ! Merci pour le thé et le repas."
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "不客气，下次再来！",
          "pinyin": "bú kè qi, xià cì zài lái!",
          "translation": {
            "fr": "De rien, reviens la prochaine fois !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 59
      }
    },
    {
      "id": "block-lesson-63-reading",
      "storyID": "story-lesson-63",
      "level": "HSK classique 2",
      "title": {
        "fr": "Le restaurant du frère de mon ami"
      },
      "paragraphs": [
        {
          "id": "lesson-63-p1",
          "hanzi": "上个星期，我的朋友介绍我认识了他的哥哥。他在一家饭馆工作，做的菜很好吃。",
          "pinyin": "shàng gè xīng qī, wǒ de péng yǒu jiè shào wǒ rèn shi le tā de gē ge. tā zài yì jiā fàn guǎn gōng zuò, zuò de cài hěn hǎo chī.",
          "translation": {
            "fr": "La semaine dernière, mon ami m’a présenté son grand frère. Il travaille dans un restaurant et ses plats sont délicieux."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-63-p2",
          "hanzi": "昨天我去他的饭馆，那里有红茶，也有黑茶。我都想喝，他笑着请我喝红茶。红茶很热，菜也很好吃，我很高兴。",
          "pinyin": "zuó tiān wǒ qù tā de fàn guǎn, nà lǐ yǒu hóng chá, yě yǒu hēi chá. wǒ dōu xiǎng hē, tā xiào zhe qǐng wǒ hē hóng chá. hóng chá hěn rè, cài yě hěn hǎo chī, wǒ hěn gāo xìng.",
          "translation": {
            "fr": "Hier, je suis allé à son restaurant, où il y a du thé rouge et du thé noir. J’avais envie des deux, mais il m’a proposé en souriant du thé rouge. Le thé était bien chaud, les plats étaient bons, et j’étais content."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l63-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 59
      }
    },
