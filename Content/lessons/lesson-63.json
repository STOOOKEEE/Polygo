    {
      "id": "block-lesson-63-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你敢讲这个故事吗？",
          "pinyin": "nǐ gǎn jiǎng zhè ge gù shi ma?",
          "translation": {
            "fr": "Oseras-tu raconter cette histoire ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "敢。根据邻居的话，他跟朋友走了另一条路。",
          "pinyin": "gǎn. gēn jù lín jū de huà, tā gēn péng you zǒu le lìng yì tiáo lù.",
          "translation": {
            "fr": "Oui. D’après les paroles du voisin, il a pris une autre route avec un ami."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这条路更容易吗？",
          "pinyin": "zhè tiáo lù gèng róng yì ma?",
          "translation": {
            "fr": "Cette route était-elle plus facile ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，所以他们终于到了公园。",
          "pinyin": "shì, suǒ yǐ tā men zhōng yú dào le gōng yuán.",
          "translation": {
            "fr": "Oui, alors ils sont finalement arrivés au parc."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 59
      }
    },
    {
      "id": "block-lesson-63-reading",
      "storyID": "story-lesson-63",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une route racontée par le voisin"
      },
      "paragraphs": [
        {
          "id": "lesson-63-p1",
          "hanzi": "邻居讲了一个故事：他跟朋友一起走路。",
          "pinyin": "lín jū jiǎng le yí ge gù shi: tā gēn péng you yì qǐ zǒu lù.",
          "translation": {
            "fr": "Le voisin raconte une histoire : il a marché avec un ami."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-63-p2",
          "hanzi": "根据他的说明，另一条路更容易，他们终于到了公园。",
          "pinyin": "gēn jù tā de shuō míng, lìng yì tiáo lù gèng róng yì, tā men zhōng yú dào le gōng yuán.",
          "translation": {
            "fr": "D’après ses explications, l’autre route était plus facile et ils sont finalement arrivés au parc."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l63-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 59
      }
    },
