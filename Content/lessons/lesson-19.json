    {
      "id": "block-lesson-19-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你在医院！你生病了吗？",
          "pinyin": "nǐ zài yī yuàn! nǐ shēng bìng le ma?",
          "translation": {
            "fr": "Tu es à l’hôpital ! Tu es tombé malade ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，我身体很热，不想吃米饭。",
          "pinyin": "shì, wǒ shēn tǐ hěn rè, bù xiǎng chī mǐ fàn.",
          "translation": {
            "fr": "Oui, j’ai de la fièvre et je n’ai pas envie de manger du riz."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你妈妈来过了吗？",
          "pinyin": "nǐ mā ma lái guo le ma?",
          "translation": {
            "fr": "Ta maman est déjà venue ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "来过了。我要在医院多喝水。",
          "pinyin": "lái guo le. wǒ yào zài yī yuàn duō hē shuǐ.",
          "translation": {
            "fr": "Oui. Je dois rester à l’hôpital et boire beaucoup d’eau."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我买了牛奶，你也多喝牛奶。",
          "pinyin": "wǒ mǎi le niú nǎi, nǐ yě duō hē niú nǎi.",
          "translation": {
            "fr": "J’ai acheté du lait, bois-en beaucoup toi aussi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "谢谢！牛奶热吗？我不喝热的。",
          "pinyin": "xiè xie! niú nǎi rè ma? wǒ bù hē rè de.",
          "translation": {
            "fr": "Merci ! Il est chaud, le lait ? Je n’en bois pas de chaud."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "不热。你爸爸呢？",
          "pinyin": "bú rè. nǐ bà ba ne?",
          "translation": {
            "fr": "Non, il n’est pas chaud. Et ton papa ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我爸爸下午来。",
          "pinyin": "wǒ bà ba xià wǔ lái.",
          "translation": {
            "fr": "Mon papa vient cet après-midi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "多喝水，明天你的身体不热了，你能回家！",
          "pinyin": "duō hē shuǐ, míng tiān nǐ de shēn tǐ bú rè le, nǐ néng huí jiā!",
          "translation": {
            "fr": "Bois beaucoup d’eau : demain tu n’auras plus de fièvre et tu pourras rentrer !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "明天回家，我很想吃米饭！",
          "pinyin": "míng tiān huí jiā, wǒ hěn xiǎng chī mǐ fàn!",
          "translation": {
            "fr": "Rentrer demain, j’ai très envie de manger du riz !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 15
      }
    },
    {
      "id": "block-lesson-19-reading",
      "storyID": "story-lesson-19",
      "level": "HSK classique 1",
      "title": {
        "fr": "Un ami à l’hôpital"
      },
      "paragraphs": [
        {
          "id": "lesson-19-p1",
          "hanzi": "今天我的朋友生病了，他在医院。医院里的人很多，我朋友的妈妈也在那里。",
          "pinyin": "jīn tiān wǒ de péng you shēng bìng le, tā zài yī yuàn. yī yuàn lǐ de rén hěn duō, wǒ péng you de mā ma yě zài nà lǐ.",
          "translation": {
            "fr": "Aujourd’hui, mon ami est tombé malade et il est à l’hôpital. Il y a beaucoup de monde à l’hôpital, et la maman de mon ami est là aussi."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-19-p2",
          "hanzi": "我朋友的身体很热，他不吃米饭。我买了牛奶，请他喝。明天我也来医院。",
          "pinyin": "wǒ péng you de shēn tǐ hěn rè, tā bù chī mǐ fàn. wǒ mǎi le niú nǎi, qǐng tā hē. míng tiān wǒ yě lái yī yuàn.",
          "translation": {
            "fr": "Mon ami a de la fièvre et ne mange pas de riz. J’ai acheté du lait et je lui propose d’en boire. Demain, je viendrai aussi à l’hôpital."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l19-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 15
      }
    },
