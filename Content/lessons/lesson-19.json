    {
      "id": "block-lesson-19-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你的身体怎么样？",
          "pinyin": "nǐ de shēn tǐ zěn me yàng？",
          "translation": {
            "fr": "Comment vas-tu ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我生病了，今天很冷。",
          "pinyin": "wǒ shēng bìng le， jīn tiān hěn lěng。",
          "translation": {
            "fr": "Je suis malade, il fait très froid aujourd’hui."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "医院里热吗？",
          "pinyin": "yī yuàn lǐ rè ma？",
          "translation": {
            "fr": "Fait-il chaud dans l’hôpital ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "里面很暖，我觉得好多了。",
          "pinyin": "lǐ miàn hěn nuǎn， wǒ jué de hǎo duō le。",
          "translation": {
            "fr": "Il fait bien chaud à l’intérieur, je me sens beaucoup mieux."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "医生给你什么药？",
          "pinyin": "yī shēng gěi nǐ shén me yào？",
          "translation": {
            "fr": "Quel médicament le médecin te donne-t-il ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "给我药。我希望很快好起来。",
          "pinyin": "gěi wǒ yào。 wǒ xī wàng hěn kuài hǎo qǐ lái。",
          "translation": {
            "fr": "Il me donne un médicament. J’espère aller mieux rapidement."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 15
      }
    },
    {
      "id": "block-lesson-19-reading",
      "storyID": "story-lesson-19",
      "level": "HSK classique 2",
      "title": {
        "fr": "Une visite à l’hôpital"
      },
      "paragraphs": [
        {
          "id": "lesson-19-p1",
          "hanzi": "Tao生病了，身体不舒服，所以去医院看医生。",
          "pinyin": "Tao shēng bìng le， shēn tǐ bù shū fú， suǒ yǐ qù yī yuàn kàn yī shēng。",
          "translation": {
            "fr": "Tao est malade et ne se sent pas bien, alors il va à l’hôpital voir le médecin."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-19-p2",
          "hanzi": "外面很冷，医院里面很热。医生给他药，他希望明天好起来。",
          "pinyin": "wài miàn hěn lěng， yī yuàn lǐ miàn hěn rè。 yī shēng gěi tā yào， tā xī wàng míng tiān hǎo qǐ lái。",
          "translation": {
            "fr": "Il fait froid dehors et chaud dans l’hôpital. Le médecin lui donne un médicament ; il espère aller mieux demain."
          },
          "segmentation": [],
          "audio": null
        }
      ],
