      },
      "paragraphs": [
        {
          "id": "lesson-12-p1",
          "hanzi": "我有五个兄弟姐妹：一个弟弟、两个妹妹、一个哥哥和一个姐姐。",
          "pinyin": "wǒ yǒu wǔ gè xiōng dì jiě mèi： yí gè dì di、 liǎng gè mèi mèi、 yí gè gē gē hé yí gè jiě jiě。",
          "translation": {
            "fr": "J’ai cinq frères et sœurs : un petit frère, deux petites sœurs, un grand frère et une grande sœur."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-12-p2",
          "hanzi": "他们回来以后，那个男人和女人在饭馆工作，服务员给他们水。",
          "pinyin": "tā men huí lái yǐ hòu， nà ge nán rén hé nǚ rén zài fàn guǎn gōng zuò， fú wù yuán gěi tā men shuǐ。",
          "translation": {
            "fr": "Après leur retour, l’homme et la femme travaillent au restaurant ; la serveuse leur donne de l’eau."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l12-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 8
      }
