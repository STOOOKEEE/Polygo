    {
      "id": "block-lesson-12-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "你好！你来了！",
          "pinyin": "nǐ hǎo! nǐ lái le!",
          "translation": {
            "fr": "Salut ! Te voilà !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我来了。你妹妹在家吗？",
          "pinyin": "wǒ lái le. nǐ mèi mei zài jiā ma?",
          "translation": {
            "fr": "Me voilà. Ta petite sœur est à la maison ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "在，妹妹在家。哥哥星期日回来。",
          "pinyin": "zài, mèi mei zài jiā. gē ge xīng qī rì huí lái.",
          "translation": {
            "fr": "Oui, elle est là. Mon grand frère rentre dimanche."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你哥哥是学生吗？",
          "pinyin": "nǐ gē ge shì xué shēng ma?",
          "translation": {
            "fr": "Ton frère est étudiant ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，他在法国。",
          "pinyin": "shì, tā zài fǎ guó.",
          "translation": {
            "fr": "Oui, il est en France."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "他在法国？我也是法国人！",
          "pinyin": "tā zài fǎ guó? wǒ yě shì fǎ guó rén!",
          "translation": {
            "fr": "Il est en France ? Moi aussi, je suis française !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我知道！你有哥哥吗？",
          "pinyin": "wǒ zhī dào! nǐ yǒu gē ge ma?",
          "translation": {
            "fr": "Je sais ! Et toi, tu as un frère ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "有，我哥哥也是学生，他在中国。",
          "pinyin": "yǒu, wǒ gē ge yě shì xué shēng, tā zài zhōng guó.",
          "translation": {
            "fr": "Oui, mon frère est aussi étudiant, il est en Chine."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "他也回家吗？",
          "pinyin": "tā yě huí jiā ma?",
          "translation": {
            "fr": "Lui aussi, il rentre à la maison ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "回，星期日回。",
          "pinyin": "huí, xīng qī rì huí.",
          "translation": {
            "fr": "Oui, dimanche."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 8
      }
    },
    {
      "id": "block-lesson-12-reading",
      "storyID": "story-lesson-12",
      "level": "HSK classique 1",
      "title": {
        "fr": "Le frère de mon ami"
      },
      "paragraphs": [
        {
          "id": "lesson-12-p1",
          "hanzi": "我朋友有哥哥和妹妹。哥哥是学生，他在法国。妹妹也是学生，今天在家。",
          "pinyin": "wǒ péng yǒu yǒu gē ge hé mèi mei. gē ge shì xué shēng, tā zài fǎ guó. mèi mei yě shì xué shēng, jīn tiān zài jiā.",
          "translation": {
            "fr": "Mon ami a un grand frère et une petite sœur. Son frère est étudiant, il est en France. Sa sœur est aussi étudiante, elle est à la maison aujourd’hui."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-12-p2",
          "hanzi": "星期日哥哥回来，我也去朋友家。朋友家的人都在，我笑了！",
          "pinyin": "xīng qī rì gē ge huí lái, wǒ yě qù péng yǒu jiā. péng yǒu jiā de rén dōu zài, wǒ xiào le!",
          "translation": {
            "fr": "Dimanche, le frère rentre et moi aussi je vais chez mon ami. Toute la famille de mon ami est là, et je souris !"
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l12-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 8
      }
    },
