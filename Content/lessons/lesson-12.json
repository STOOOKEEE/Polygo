    {
      "id": "block-lesson-12-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你有几个兄弟姐妹？",
          "pinyin": "nǐ yǒu jǐ gè xiōng dì jiě mèi？",
          "translation": {
            "fr": "Combien de frères et sœurs as-tu ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我有五个兄弟姐妹：一个弟弟、两个妹妹，还有哥哥和姐姐。",
          "pinyin": "wǒ yǒu wǔ gè xiōng dì jiě mèi： yí gè dì di、 liǎng gè mèi mèi， hái yǒu gē gē hé jiě jiě。",
          "translation": {
            "fr": "J’ai cinq frères et sœurs : un petit frère, deux petites sœurs, un grand frère et une grande sœur."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你的哥哥也是学生吗？",
          "pinyin": "nǐ dī gē gē yě shì xué shēng ma？",
          "translation": {
            "fr": "Ton grand frère est aussi étudiant ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，他和姐姐在学校。",
          "pinyin": "shì， tā hé jiě jiě zài xué xiào。",
          "translation": {
            "fr": "Oui, il est à l’école avec ma grande sœur."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那位男人是谁？",
          "pinyin": "nà wèi nán rén shì shuí？",
          "translation": {
            "fr": "Qui est cet homme ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "他是我丈夫；那位女人是服务员。",
          "pinyin": "tā shì wǒ zhàng fū； nà wèi nǚ rén shì fú wù yuán。",
          "translation": {
            "fr": "C’est mon mari ; cette femme est serveuse."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 8
      }
    },
    {
      "id": "block-lesson-12-reading",
      "storyID": "story-lesson-12",
      "level": "HSK classique 2",
      "title": {
        "fr": "Les proches"
      },
      "paragraphs": [
        {
          "id": "lesson-12-p1",
          "hanzi": "我有五个兄弟姐妹：一个弟弟、两个妹妹、一个哥哥和一个姐姐。",
          "pinyin": "wǒ yǒu wǔ gè xiōng dì jiě mèi： yí gè dì di、 liǎng gè mèi mèi、 yí gè gē gē hé yí gè jiě jiě。",
          "translation": {
            "fr": "J’ai cinq frères et sœurs : un petit frère, deux petites sœurs, un grand frère et une grande sœur."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-12-p2",
          "hanzi": "他们回来以后，那个男人和女人在饭馆工作，服务员给他们水。",
          "pinyin": "tā men huí lái yǐ hòu， nà ge nán rén hé nǚ rén zài fàn guǎn gōng zuò， fú wù yuán gěi tā men shuǐ。",
          "translation": {
            "fr": "Après leur retour, l’homme et la femme travaillent au restaurant ; la serveuse leur donne de l’eau."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l12-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 8
      }
    },
