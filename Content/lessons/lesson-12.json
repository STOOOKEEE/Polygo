  "blocks": [
    {
      "kind": "introduction",
      "id": "block-lesson-12-grammar-01",
      "title": {
        "fr": "Grammaire — 有 + nom"
      },
      "body": {
        "fr": "有 exprime ici l’existence ou la possession.\nExemple 1 : 我家有两个孩子。\nwǒ jiā yǒu liǎng gè hái zi。\nIl y a deux enfants dans ma famille."
      },
      "metadata": {
        "stage": "introduce",
        "skill": "recognition",
        "lessonDay": 8
      }
