    {
      "id": "block-l8-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你好！你去火车站吗？",
          "pinyin": "nǐ hǎo! nǐ qù huǒ chē zhàn ma?",
          "translation": {
            "fr": "Salut ! Tu vas à la gare ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "去，我去火车站的商店。你也想去吗？",
          "pinyin": "qù, wǒ qù huǒ chē zhàn de shāng diàn. nǐ yě xiǎng qù ma?",
          "translation": {
            "fr": "Oui, je vais au magasin de la gare. Tu veux venir aussi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "想！我想买茶。",
          "pinyin": "xiǎng! wǒ xiǎng mǎi chá.",
          "translation": {
            "fr": "Oui ! Je voudrais acheter du thé."
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "你好！想买什么？",
          "pinyin": "nǐ hǎo! xiǎng mǎi shén me?",
          "translation": {
            "fr": "Bonjour ! Vous désirez ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "有红茶吗？几块？",
          "pinyin": "yǒu hóng chá ma? jǐ kuài?",
          "translation": {
            "fr": "Vous avez du thé noir ? C’est combien ?"
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "红茶、绿茶都有。红茶七块，绿茶十块。",
          "pinyin": "hóng chá, lǜ chá dōu yǒu. hóng chá qī kuài, lǜ chá shí kuài.",
          "translation": {
            "fr": "Il y a du thé noir et du thé vert. Le noir coûte 7 yuans, le vert 10."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我想买书。这书几块？",
          "pinyin": "wǒ xiǎng mǎi shū. zhè shū jǐ kuài?",
          "translation": {
            "fr": "Moi, je voudrais un livre. Il coûte combien ?"
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "这书十五块。",
          "pinyin": "zhè shū shí wǔ kuài.",
          "translation": {
            "fr": "Ce livre coûte 15 yuans."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我买红茶。",
          "pinyin": "wǒ mǎi hóng chá.",
          "translation": {
            "fr": "Moi, j’achète le thé noir."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我买书。",
          "pinyin": "wǒ mǎi shū.",
          "translation": {
            "fr": "Et moi, le livre."
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "谢谢！再见！",
          "pinyin": "xiè xie! zài jiàn!",
          "translation": {
            "fr": "Merci ! Au revoir !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 4
      }
    },
    {
      "id": "block-l8-reading",
      "storyID": "story-l8-shop",
      "title": {
        "fr": "Un tour à la gare"
      },
      "paragraphs": [
        {
          "id": "lesson-08-p1",
          "hanzi": "今天我去火车站。火车站有商店，水四块，茶七块。",
          "pinyin": "jīn tiān wǒ qù huǒ chē zhàn. huǒ chē zhàn yǒu shāng diàn, shuǐ sì kuài, chá qī kuài.",
          "translation": {
            "fr": "Aujourd’hui, je vais à la gare. Il y a un magasin à la gare : l’eau coûte 4 yuans, le thé 7."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-08-p2",
          "hanzi": "我想买水，也想买书。书十五块，我不买。",
          "pinyin": "wǒ xiǎng mǎi shuǐ, yě xiǎng mǎi shū. shū shí wǔ kuài, wǒ bù mǎi.",
          "translation": {
            "fr": "Je voudrais acheter de l’eau, et aussi un livre. Le livre coûte 15 yuans, je ne l’achète pas."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l8-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 4
      }
    },
