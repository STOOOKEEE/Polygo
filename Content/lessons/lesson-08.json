    {
      "id": "block-l8-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "现在几点？",
          "pinyin": "xiàn zài jǐ diǎn?",
          "translation": {
            "fr": "Quelle heure est-il ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "现在三点。",
          "pinyin": "xiàn zài sān diǎn.",
          "translation": {
            "fr": "Il est trois heures."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我想去商店买苹果。",
          "pinyin": "wǒ xiǎng qù shāng diàn mǎi píng guǒ.",
          "translation": {
            "fr": "Je veux aller au magasin acheter des pommes."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "苹果多少钱？",
          "pinyin": "píng guǒ duō shao qián?",
          "translation": {
            "fr": "Combien coûtent les pommes ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "苹果三块。",
          "pinyin": "píng guǒ sān kuài.",
          "translation": {
            "fr": "Les pommes coûtent trois yuans."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我买。",
          "pinyin": "wǒ mǎi.",
          "translation": {
            "fr": "J’achète."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 4
      }
    },
