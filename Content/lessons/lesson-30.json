    {
      "id": "block-lesson-30-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "您好，请问去车站的路怎么走？",
          "pinyin": "nín hǎo， qǐng wèn qù chē zhàn de lù zěn me zǒu？",
          "translation": {
            "fr": "Bonjour, excusez-moi, comment va-t-on à la gare ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "您先走这条路，每天都有车。",
          "pinyin": "nín xiān zǒu zhè tiáo lù， měi tiān dōu yǒu chē。",
          "translation": {
            "fr": "Prenez d’abord cette route ; il y a des véhicules chaque jour."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "车站在商店旁边吗？",
          "pinyin": "chē zhàn zài shāng diàn páng biān ma？",
          "translation": {
            "fr": "La gare est-elle à côté du magasin ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不，在学校旁边，离这里不远。",
          "pinyin": "bù， zài xué xiào páng biān， lí zhè lǐ bù yuǎn。",
          "translation": {
            "fr": "Non, elle est à côté de l’école, pas loin d’ici."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我什么时候可以到？",
          "pinyin": "wǒ shén me shí hòu kě yǐ dào？",
          "translation": {
            "fr": "Quand puis-je arriver ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "走十分钟就到。请让孩子先过。",
          "pinyin": "zǒu shí fēn zhōng jiù dào。 qǐng ràng hái zi xiān guò。",
          "translation": {
            "fr": "Vous y serez en dix minutes. Laissez d’abord passer les enfants."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 26
      }
    },
    {
      "id": "block-lesson-30-reading",
      "storyID": "story-lesson-30",
      "level": "HSK classique 2",
      "title": {
        "fr": "Une direction"
      },
      "paragraphs": [
        {
          "id": "lesson-30-p1",
          "hanzi": "客人问去车站的路。车站在学校旁边，离商店不远。",
          "pinyin": "kè rén wèn qù chē zhàn de lù。 chē zhàn zài xué xiào páng biān， lí shāng diàn bù yuǎn。",
          "translation": {
            "fr": "Un visiteur demande le chemin de la gare. La gare est à côté de l’école, pas loin du magasin."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-30-p2",
          "hanzi": "他走十分钟就到。路上有很多孩子，所以他让孩子先过。",
          "pinyin": "tā zǒu shí fēn zhōng jiù dào。 lù shàng yǒu hěn duō hái zi， suǒ yǐ tā ràng hái zi xiān guò。",
          "translation": {
            "fr": "Il y arrive en dix minutes. Il y a beaucoup d’enfants sur la route, alors il les laisse passer d’abord."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l30-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 26
      }
    },
