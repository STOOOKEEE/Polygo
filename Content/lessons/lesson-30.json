    {
      "id": "block-lesson-30-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你好！火车站在哪里？我不知道路。",
          "pinyin": "nǐ hǎo! huǒ chē zhàn zài nǎ lǐ? wǒ bù zhī dào lù.",
          "translation": {
            "fr": "Bonjour ! Où est la gare ? Je ne connais pas le chemin."
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "火车站在商店旁边。",
          "pinyin": "huǒ chē zhàn zài shāng diàn páng biān.",
          "translation": {
            "fr": "La gare est à côté du magasin."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "商店在哪里？我们怎么去？",
          "pinyin": "shāng diàn zài nǎ lǐ? wǒ men zěn me qù?",
          "translation": {
            "fr": "Et le magasin, il est où ? Comment y va-t-on ?"
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "商店在学校前面。从这里去，要十分钟。",
          "pinyin": "shāng diàn zài xué xiào qián miàn. cóng zhè lǐ qù, yào shí fēn zhōng.",
          "translation": {
            "fr": "Le magasin est devant l’école. D’ici, il faut dix minutes."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "十分钟，很好！现在三点，我哥哥五点来火车站。",
          "pinyin": "shí fēn zhōng, hěn hǎo! xiàn zài sān diǎn, wǒ gē ge wǔ diǎn lái huǒ chē zhàn.",
          "translation": {
            "fr": "Dix minutes, parfait ! Il est trois heures et mon frère arrive à la gare à cinq heures."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那我们有很多时间！我想和你哥哥说话。",
          "pinyin": "nà wǒ men yǒu hěn duō shí jiān! wǒ xiǎng hé nǐ gē ge shuō huà.",
          "translation": {
            "fr": "Alors on a largement le temps ! J’ai envie de parler avec ton frère."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好！他也想和你说话。",
          "pinyin": "hǎo! tā yě xiǎng hé nǐ shuō huà.",
          "translation": {
            "fr": "Avec plaisir ! Lui aussi, il veut te parler."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "谢谢你，再见！",
          "pinyin": "xiè xie nǐ, zài jiàn!",
          "translation": {
            "fr": "Merci beaucoup, au revoir !"
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "不客气，再见！",
          "pinyin": "bú kè qi, zài jiàn!",
          "translation": {
            "fr": "De rien, au revoir !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 26
      }
    },
    {
      "id": "block-lesson-30-reading",
      "storyID": "story-lesson-30",
      "level": "HSK classique 1",
      "title": {
        "fr": "Ma maison, mon école"
      },
      "paragraphs": [
        {
          "id": "lesson-30-p1",
          "hanzi": "我家在学校旁边，路很好。从我家去学校，要十分钟。学校前面有一个商店，商店旁边是医院。",
          "pinyin": "wǒ jiā zài xué xiào páng biān, lù hěn hǎo. cóng wǒ jiā qù xué xiào, yào shí fēn zhōng. xué xiào qián miàn yǒu yí gè shāng diàn, shāng diàn páng biān shì yī yuàn.",
          "translation": {
            "fr": "Ma maison est à côté de l’école, et la route est agréable. De chez moi à l’école, il faut dix minutes. Devant l’école, il y a un magasin, et à côté du magasin, il y a un hôpital."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-30-p2",
          "hanzi": "你的学校在哪里？你怎么去学校？",
          "pinyin": "nǐ de xué xiào zài nǎ lǐ? nǐ zěn me qù xué xiào?",
          "translation": {
            "fr": "Où est ton école ? Comment y vas-tu ?"
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l30-reading"
      ],
      "kind": "reading",
      "metadata": {
