    {
      "id": "block-lesson-90-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你以为银行已经关门了吗？",
          "pinyin": "nǐ yǐ wéi yín háng yǐ jīng guān mén le ma?",
          "translation": {
            "fr": "Tu croyais que la banque était déjà fermée ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，但是它又开了。",
          "pinyin": "shì, dàn shì tā yòu kāi le.",
          "translation": {
            "fr": "Oui, mais elle a rouvert."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "可以用手机转钱吗？",
          "pinyin": "kě yǐ yòng shǒu jī zhuǎn qián ma?",
          "translation": {
            "fr": "Peut-on transférer de l’argent avec le téléphone ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "可以。这家银行很有名，办理业务很方便。",
          "pinyin": "kě yǐ. zhè jiā yín háng hěn yǒu míng, bàn lǐ yè wù hěn fāng biàn.",
          "translation": {
            "fr": "Oui. Cette banque est très connue et ses services sont pratiques."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 86
      }
    },
