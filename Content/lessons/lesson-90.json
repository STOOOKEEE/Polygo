      ],
      "metadata": {
        "stage": "observe",
        "skill": "recognition",
        "lessonDay": 86
      }
    },
    {
      "id": "block-lesson-90-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你以为银行已经关门了吗？",
          "pinyin": "nǐ yǐ wéi yín háng yǐ jīng guān mén le ma?",
          "translation": {
            "fr": "Tu croyais que la banque était déjà fermée ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，但是它又开了。",
          "pinyin": "shì, dàn shì tā yòu kāi le.",
          "translation": {
            "fr": "Oui, mais elle a rouvert."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "可以用手机转钱吗？",
          "pinyin": "kě yǐ yòng shǒu jī zhuǎn qián ma?",
          "translation": {
            "fr": "Peut-on transférer de l’argent avec le téléphone ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "可以。这家银行很有名，办理业务很方便。",
          "pinyin": "kě yǐ. zhè jiā yín háng hěn yǒu míng, bàn lǐ yè wù hěn fāng biàn.",
          "translation": {
            "fr": "Oui. Cette banque est très connue et ses services sont pratiques."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 86
      }
    },
    {
      "id": "block-lesson-90-reading",
      "storyID": "story-lesson-90",
      "level": "HSK classique 3",
      "title": {
        "fr": "La banque finalement ouverte"
      },
      "paragraphs": [
        {
          "id": "lesson-90-p1",
          "hanzi": "Tao以为银行关门了，其实银行又开了。",
          "pinyin": "Tao yǐ wéi yín háng guān mén le, qí shí yín háng yòu kāi le.",
          "translation": {
            "fr": "Tao croyait que la banque était fermée ; en fait elle a rouvert."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-90-p2",
          "hanzi": "Mina教他用手机办理事情，他们很快完成了。",
          "pinyin": "Mina jiāo tā yòng shǒu jī bàn lǐ shì qing, tā men hěn kuài wán chéng le.",
          "translation": {
            "fr": "Mina lui apprend à utiliser le téléphone pour faire la démarche et ils terminent rapidement."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l90-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 86
      }
    },
