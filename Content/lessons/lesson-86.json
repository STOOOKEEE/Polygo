    {
      "id": "block-lesson-86-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你为什么每天走这么远？",
          "pinyin": "nǐ wèi shén me měi tiān zǒu zhè me yuǎn?",
          "translation": {
            "fr": "Pourquoi marches-tu si loin chaque jour ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "为了锻炼，也为了养成好习惯。",
          "pinyin": "wèi le duàn liàn, yě wèi le yǎng chéng hǎo xí guàn.",
          "translation": {
            "fr": "Pour faire de l’exercice et prendre une bonne habitude."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "西边有洗手间吗？",
          "pinyin": "xī biān yǒu xǐ shǒu jiān ma?",
          "translation": {
            "fr": "Y a-t-il des toilettes à l’ouest ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有。路线虽然长，但是很方便。",
          "pinyin": "yǒu. lù xiàn suī rán cháng, dàn shì hěn fāng biàn.",
          "translation": {
            "fr": "Oui. Même si l’itinéraire est long, il est pratique."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 82
      }
    },
