    {
      "id": "block-lesson-87-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你看今天的新闻了吗？",
          "pinyin": "nǐ kàn jīn tiān de xīn wén le ma?",
          "translation": {
            "fr": "As-tu vu les informations d’aujourd’hui ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "先洗澡，然后再看。",
          "pinyin": "xiān xǐ zǎo, rán hòu zài kàn.",
          "translation": {
            "fr": "Je prends d’abord une douche, puis je regarde."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你相信这个消息吗？",
          "pinyin": "nǐ xiāng xìn zhè ge xiāo xi ma?",
          "translation": {
            "fr": "Crois-tu cette nouvelle ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "照片里的月亮像真的，我要先检查。",
          "pinyin": "zhào piàn lǐ de yuè liang xiàng zhēn de, wǒ yào xiān jiǎn chá.",
          "translation": {
            "fr": "La lune sur la photo semble réelle ; je dois d’abord vérifier."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 83
      }
    },
