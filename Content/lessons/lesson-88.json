    {
      "id": "block-lesson-88-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你对什么有兴趣？",
          "pinyin": "nǐ duì shén me yǒu xìng qù?",
          "translation": {
            "fr": "Qu’est-ce qui t’intéresse ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我想买新鲜的水果，但是不知道选哪一种。",
          "pinyin": "wǒ xiǎng mǎi xīn xiān de shuǐ guǒ, dàn shì bù zhī dào xuǎn nǎ yì zhǒng.",
          "translation": {
            "fr": "Je veux acheter des fruits frais, mais je ne sais pas lequel choisir."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你需要写信的纸吗？",
          "pinyin": "nǐ xū yào xiě xìn de zhǐ ma?",
          "translation": {
            "fr": "As-tu besoin de papier pour écrire une lettre ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "需要。先选水果，再写信。",
          "pinyin": "xū yào. xiān xuǎn shuǐ guǒ, zài xiě xìn.",
          "translation": {
            "fr": "Oui. Je choisis d’abord les fruits, puis j’écris la lettre."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 84
      }
    },
    {
      "id": "block-lesson-88-reading",
      "storyID": "story-lesson-88",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une liste au marché"
      },
      "paragraphs": [
        {
          "id": "lesson-88-p1",
          "hanzi": "Tao需要新鲜水果，也需要纸和笔写信。",
          "pinyin": "Tao xū yào xīn xiān shuǐ guǒ, yě xū yào zhǐ hé bǐ xiě xìn.",
          "translation": {
            "fr": "Tao a besoin de fruits frais et aussi de papier et d’un stylo pour écrire une lettre."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-88-p2",
          "hanzi": "他有兴趣了解不同种水果，最后选择了最好的一种。",
          "pinyin": "tā yǒu xìng qù liǎo jiě bù tóng zhǒng shuǐ guǒ, zuì hòu xuǎn zé le zuì hǎo de yì zhǒng.",
          "translation": {
            "fr": "Il s’intéresse aux différentes sortes de fruits et choisit finalement la meilleure."
          },
          "segmentation": [],
          "audio": null
        }
      ],
