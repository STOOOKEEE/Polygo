    {
      "id": "block-l5-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你好！你饿吗？",
          "pinyin": "nǐ hǎo! nǐ è ma?",
          "translation": {
            "fr": "Salut ! Tu as faim ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "饿！你有什么菜？",
          "pinyin": "è! nǐ yǒu shén me cài?",
          "translation": {
            "fr": "Oui ! Qu’as-tu comme plats ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我有米饭、鱼和菜。",
          "pinyin": "wǒ yǒu mǐ fàn, yú hé cài.",
          "translation": {
            "fr": "J’ai du riz, du poisson et des légumes."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我不吃鱼，我吃菜和米饭。",
          "pinyin": "wǒ bù chī yú, wǒ chī cài hé mǐ fàn.",
          "translation": {
            "fr": "Je ne mange pas de poisson, je mange des légumes et du riz."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "菜不多，米饭多。",
          "pinyin": "cài bù duō, mǐ fàn duō.",
          "translation": {
            "fr": "Il n’y a pas beaucoup de légumes, mais il y a beaucoup de riz."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "没关系！你有水吗？我渴。",
          "pinyin": "méi guān xì! nǐ yǒu shuǐ ma? wǒ kě.",
          "translation": {
            "fr": "Ce n’est pas grave ! Tu as de l’eau ? J’ai soif."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "有，我有茶和水。你喝茶吗？",
          "pinyin": "yǒu, wǒ yǒu chá hé shuǐ. nǐ hē chá ma?",
          "translation": {
            "fr": "Oui, j’ai du thé et de l’eau. Tu bois du thé ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "喝！茶热吗？",
          "pinyin": "hē! chá rè ma?",
          "translation": {
            "fr": "Oui ! Il est chaud, le thé ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "热，请喝。",
          "pinyin": "rè, qǐng hē.",
          "translation": {
            "fr": "Il est chaud. Bois, je t’en prie."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "谢谢！我吃米饭，你吃鱼。",
          "pinyin": "xiè xie! wǒ chī mǐ fàn, nǐ chī yú.",
          "translation": {
            "fr": "Merci ! Moi, je mange du riz, et toi, du poisson."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 1
      }
    },
