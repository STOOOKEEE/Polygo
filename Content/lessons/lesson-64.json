      }
    },
    {
      "id": "block-lesson-64-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "昨天我们因为下雨改变了计划。",
          "pinyin": "zuó tiān wǒ men yīn wèi xià yǔ gǎi biàn le jì huà.",
          "translation": {
            "fr": "Hier, nous avons changé nos plans parce qu’il pleuvait."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我把地图放在桌上，大家就明白了。",
          "pinyin": "wǒ bǎ dì tú fàng zài zhuō shàng, dà jiā jiù míng bai le.",
          "translation": {
            "fr": "J’ai posé la carte sur la table et tout le monde a compris."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "虽然路很长，但是我们终于到了。",
          "pinyin": "suī rán lù hěn cháng, dàn shì wǒ men zhōng yú dào le.",
          "translation": {
            "fr": "Même si la route était longue, nous sommes finalement arrivés."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "现在请听问题，再用完整的句子回答。",
          "pinyin": "xiàn zài qǐng tīng wèn tí, zài yòng wán zhěng de jù zi huí dá.",
          "translation": {
            "fr": "Maintenant, écoute la question puis réponds avec une phrase complète."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 60
      }
    },
    {
      "id": "block-lesson-64-reading",
      "storyID": "story-lesson-64",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une journée de révision"
      },
      "paragraphs": [
        {
          "id": "lesson-64-p1",
          "hanzi": "下雨以后，大家根据地图改变了路线。",
          "pinyin": "xià yǔ yǐ hòu, dà jiā gēn jù dì tú gǎi biàn le lù xiàn.",
          "translation": {
            "fr": "Après la pluie, tout le monde a changé d’itinéraire en fonction de la carte."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-64-p2",
          "hanzi": "路虽然很长，但是大家互相帮忙，终于到了目的地。",
          "pinyin": "lù suī rán hěn cháng, dàn shì dà jiā hù xiāng bāng máng, zhōng yú dào le mù dì dì.",
          "translation": {
            "fr": "Même si la route était longue, tout le monde s’est aidé et a finalement atteint sa destination."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l64-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 60
      }
    },
