      "paragraphs": [
        {
          "id": "lesson-89-p1",
          "hanzi": "活动一般要求两个人一组，一边读一边记录。",
          "pinyin": "huó dòng yì bān yāo qiú liǎng ge rén yì zǔ, yì biān dú yì biān jì lù.",
          "translation": {
            "fr": "L’activité demande en général deux personnes par groupe, qui lisent tout en prenant des notes."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-89-p2",
          "hanzi": "一共四个小组，每组的任务不一样。",
          "pinyin": "yí gòng sì ge xiǎo zǔ, měi zǔ de rèn wù bù yí yàng.",
          "translation": {
            "fr": "Il y a quatre groupes au total et la tâche de chaque groupe est différente."
          },
          "segmentation": [],
