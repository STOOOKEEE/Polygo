      "id": "block-lesson-89-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "活动有什么要求？",
          "pinyin": "huó dòng yǒu shén me yāo qiú?",
          "translation": {
            "fr": "Quelles sont les consignes de l’activité ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "一般要两个人一组，一边读，一边记录。",
          "pinyin": "yì bān yào liǎng ge rén yì zǔ, yì biān dú, yì biān jì lù.",
          "translation": {
            "fr": "En général, il faut deux personnes par groupe : on lit tout en prenant des notes."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "一共几个小组？",
          "pinyin": "yí gòng jǐ ge xiǎo zǔ?",
          "translation": {
            "fr": "Combien de groupes y a-t-il au total ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "四个。每组的任务不一样。",
          "pinyin": "sì ge. měi zǔ de rèn wù bù yí yàng.",
          "translation": {
            "fr": "Quatre. La tâche de chaque groupe est différente."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 85
      }
