    {
      "id": "block-lesson-21-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你好！你现在在家吗？",
          "pinyin": "nǐ hǎo! nǐ xiàn zài zài jiā ma?",
          "translation": {
            "fr": "Salut ! Tu es à la maison en ce moment ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "在，今天下雨，我不去商店。",
          "pinyin": "zài, jīn tiān xià yǔ, wǒ bù qù shāng diàn.",
          "translation": {
            "fr": "Oui. Il pleut aujourd’hui, je ne vais pas au magasin."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你姐姐也在家吗？",
          "pinyin": "nǐ jiě jie yě zài jiā ma?",
          "translation": {
            "fr": "Ta grande sœur est là aussi ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "在，她在睡觉。她的工作很多。",
          "pinyin": "zài, tā zài shuì jiào. tā de gōng zuò hěn duō.",
          "translation": {
            "fr": "Oui, elle dort. Elle a beaucoup de travail."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "对不起，我不知道她在睡觉。",
          "pinyin": "duì bù qǐ, wǒ bù zhī dào tā zài shuì jiào.",
          "translation": {
            "fr": "Désolée, je ne savais pas qu’elle dormait."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "没关系！你有什么问题吗？",
          "pinyin": "méi guān xì! nǐ yǒu shén me wèn tí ma?",
          "translation": {
            "fr": "Ce n’est pas grave ! Tu as une question ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "没有。明天你工作吗？",
          "pinyin": "méi yǒu. míng tiān nǐ gōng zuò ma?",
          "translation": {
            "fr": "Non. Tu travailles demain ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我不工作。你来我家，我们吃鱼，喝茶。",
          "pinyin": "wǒ bù gōng zuò. nǐ lái wǒ jiā, wǒ men chī yú, hē chá.",
          "translation": {
            "fr": "Je ne travaille pas. Viens chez moi, on mangera du poisson et on boira du thé."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "谢谢！我买菜和米饭。",
          "pinyin": "xiè xie! wǒ mǎi cài hé mǐ fàn.",
          "translation": {
            "fr": "Merci ! Je vais acheter des légumes et du riz."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不客气！明天再见！",
          "pinyin": "bú kè qi! míng tiān zài jiàn!",
          "translation": {
            "fr": "De rien ! À demain !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 17
      }
    },
    {
      "id": "block-lesson-21-reading",
      "storyID": "story-lesson-21",
      "level": "HSK classique 1",
      "title": {
        "fr": "Le carnet de Mina"
      },
      "paragraphs": [
        {
          "id": "lesson-21-p1",
          "hanzi": "今天下雨，我在家学习汉语。我朋友有一个姐姐，她的工作很多，现在她在睡觉。",
          "pinyin": "jīn tiān xià yǔ, wǒ zài jiā xué xí hàn yǔ. wǒ péng you yǒu yī gè jiě jie, tā de gōng zuò hěn duō, xiàn zài tā zài shuì jiào.",
          "translation": {
            "fr": "Aujourd’hui il pleut, j’étudie le chinois à la maison. Mon ami a une grande sœur ; elle a beaucoup de travail et elle dort en ce moment."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-21-p2",
          "hanzi": "明天他不工作，我去他家。我想买菜和米饭。",
          "pinyin": "míng tiān tā bù gōng zuò, wǒ qù tā jiā. wǒ xiǎng mǎi cài hé mǐ fàn.",
          "translation": {
            "fr": "Demain il ne travaille pas, j’irai chez lui. Je voudrais acheter des légumes et du riz."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l21-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 17
      }
    },
