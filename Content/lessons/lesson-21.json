    {
      "id": "block-lesson-21-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "喂，谁在说话？",
          "pinyin": "wèi， shuí zài shuō huà？",
          "translation": {
            "fr": "Allô, qui parle ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是我。你今天喝水了吗？",
          "pinyin": "shì wǒ。 nǐ jīn tiān hē shuǐ le ma？",
          "translation": {
            "fr": "C’est moi. As-tu bu de l’eau aujourd’hui ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我喝了十杯水，但是现在想睡觉。",
          "pinyin": "wǒ hē le shí bēi shuǐ， dàn shì xiàn zài xiǎng shuì jiào。",
          "translation": {
            "fr": "J’ai bu dix verres d’eau, mais maintenant je veux dormir."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "因为你太累，所以想睡觉。",
          "pinyin": "yīn wèi nǐ tài lèi， suǒ yǐ xiǎng shuì jiào。",
          "translation": {
            "fr": "Comme tu es trop fatiguée, tu veux dormir."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "他也在听吗？",
          "pinyin": "tā yě zài tīng ma？",
          "translation": {
            "fr": "Est-ce qu’il écoute aussi ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "他在。他四岁，正在听我们说话。",
          "pinyin": "tā zài。 tā sì suì， zhèng zài tīng wǒ men shuō huà。",
          "translation": {
            "fr": "Oui, il est là. Il a quatre ans et nous écoute parler."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 17
      }
    },
    {
      "id": "block-lesson-21-reading",
      "storyID": "story-lesson-21",
      "level": "HSK classique 2",
      "title": {
        "fr": "Le coup de fil"
      },
      "paragraphs": [
        {
          "id": "lesson-21-p1",
          "hanzi": "晚上我给朋友打电话。她喝了十杯水，还是觉得累。",
          "pinyin": "wǎn shàng wǒ gěi péng yǒu dǎ diàn huà。 tā hē le shí bēi shuǐ， hái shì jué de lèi。",
          "translation": {
            "fr": "Le soir, j’appelle une amie. Elle a bu dix verres d’eau mais se sent toujours fatiguée."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-21-p2",
          "hanzi": "因为她今天工作太多，所以她要睡觉。她的孩子也在听电话。",
          "pinyin": "yīn wèi tā jīn tiān gōng zuò tài duō， suǒ yǐ tā yào shuì jiào。 tā de hái zi yě zài tīng diàn huà。",
          "translation": {
            "fr": "Comme elle a beaucoup travaillé aujourd’hui, elle doit dormir. Son enfant écoute aussi l’appel."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l21-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 17
      }
    },
