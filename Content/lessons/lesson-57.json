    {
      "id": "block-lesson-57-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "文件放在哪里？",
          "pinyin": "wén jiàn fàng zài nǎ lǐ?",
          "translation": {
            "fr": "Où met-on les documents ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我把文件放在这个盒子里。",
          "pinyin": "wǒ bǎ wén jiàn fàng zài zhè ge hé zi lǐ.",
          "translation": {
            "fr": "Je mets les documents dans cette boîte."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这里方便吗？附近有打印机吗？",
          "pinyin": "zhè lǐ fāng biàn ma? fù jìn yǒu dǎ yìn jī ma?",
          "translation": {
            "fr": "Est-ce pratique ici ? Y a-t-il une imprimante à proximité ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "很方便，你放心吧。五分钟就能完成。",
          "pinyin": "hěn fāng biàn, nǐ fàng xīn ba. wǔ fēn zhōng jiù néng wán chéng.",
          "translation": {
            "fr": "C’est très pratique, rassure-toi. Ce sera terminé en cinq minutes."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 53
      }
    },
    {
      "id": "block-lesson-57-reading",
      "storyID": "story-lesson-57",
      "level": "HSK classique 3",
      "title": {
        "fr": "Un bureau bien rangé"
      },
      "paragraphs": [
        {
          "id": "lesson-57-p1",
          "hanzi": "Tao把文件放在盒子里，把桌面留出来。",
          "pinyin": "Tao bǎ wén jiàn fàng zài hé zi lǐ, bǎ zhuō miàn liú chū lái.",
          "translation": {
            "fr": "Tao met les documents dans la boîte et libère le bureau."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-57-p2",
          "hanzi": "打印机在附近，所以同事不用担心。",
          "pinyin": "dǎ yìn jī zài fù jìn, suǒ yǐ tóng shì bú yòng dān xīn.",
          "translation": {
            "fr": "L’imprimante est à proximité, la collègue n’a donc pas à s’inquiéter."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l57-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 53
      }
