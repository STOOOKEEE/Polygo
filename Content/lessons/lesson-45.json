    {
      "id": "block-lesson-45-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你吃饱了吗？",
          "pinyin": "nǐ chī bǎo le ma？",
          "translation": {
            "fr": "As-tu assez mangé ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "吃饱了，谢谢你帮忙。",
          "pinyin": "chī bǎo le， xiè xiè nǐ bāng máng。",
          "translation": {
            "fr": "Oui, merci de m’aider."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "北方的天气和这里一样吗？",
          "pinyin": "běi fāng de tiān qì hé zhè lǐ yī yàng ma？",
          "translation": {
            "fr": "Le temps du Nord est-il comme ici ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不一样，天气变化很大。",
          "pinyin": "bù yí yàng， tiān qì biàn huà hěn dà。",
          "translation": {
            "fr": "Non, il est différent ; le temps change beaucoup."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你要参加比赛吗？",
          "pinyin": "nǐ yào cān jiā bǐ sài ma？",
          "translation": {
            "fr": "Vas-tu participer à la compétition ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "要。我把时间改一下，就能参加。",
          "pinyin": "yào。 wǒ bǎ shí jiān gǎi yī xià， jiù néng cān jiā。",
          "translation": {
            "fr": "Oui. Je change un peu l’horaire et je pourrai participer."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 41
      }
    },
    {
      "id": "block-lesson-45-reading",
      "storyID": "story-lesson-45",
      "level": "HSK classique 3",
      "title": {
        "fr": "Un nouvel horaire"
      },
      "paragraphs": [
        {
          "id": "lesson-45-p1",
          "hanzi": "Tao吃饱以后感谢朋友帮忙。他发现北方和这里的天气不一样。",
          "pinyin": "Tao chī bǎo yǐ hòu gǎn xiè péng yǒu bāng máng。 tā fā xiàn běi fāng hé zhè lǐ de tiān qì bù yí yàng。",
          "translation": {
            "fr": "Après avoir mangé à sa faim, Tao remercie son ami de son aide. Il découvre que le temps du Nord est différent d’ici."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-45-p2",
          "hanzi": "天气变化以后，他把时间改好，准备参加比赛。",
          "pinyin": "tiān qì biàn huà yǐ hòu， tā bǎ shí jiān gǎi hǎo， zhǔn bèi cān jiā bǐ sài。",
          "translation": {
            "fr": "Après le changement de temps, il ajuste l’horaire et se prépare à participer à la compétition."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l45-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 41
      }
    },
