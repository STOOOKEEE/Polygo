      },
      "paragraphs": [
        {
          "id": "lesson-51-p1",
          "hanzi": "街道很干净，只有入口还需要打扫。",
          "pinyin": "jiē dào hěn gān jìng, zhǐ yǒu rù kǒu hái xū yào dǎ sǎo.",
          "translation": {
            "fr": "La rue est propre ; seul le porche doit encore être nettoyé."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-51-p2",
          "hanzi": "入口很矮，雨水被风吹到里面。",
          "pinyin": "rù kǒu hěn ǎi, yǔ shuǐ bèi fēng chuī dào lǐ miàn.",
          "translation": {
            "fr": "L’entrée est basse et l’eau de pluie est poussée à l’intérieur par le vent."
          },
          "segmentation": [],
          "audio": null
        }
      ],
