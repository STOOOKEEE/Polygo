    {
      "id": "block-lesson-51-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "这里的路很漂亮！你知道这是哪里吗？",
          "pinyin": "zhè lǐ de lù hěn piào liàng! nǐ zhī dào zhè shì nǎ lǐ ma?",
          "translation": {
            "fr": "Cette rue est très jolie ! Tu sais où on est ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "知道，这是北京最漂亮的路。",
          "pinyin": "zhī dào, zhè shì běi jīng zuì piào liàng de lù.",
          "translation": {
            "fr": "Oui, c’est la plus belle rue de Pékin."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你看，那家商店很大！我们进去看看吧？",
          "pinyin": "nǐ kàn, nà jiā shāng diàn hěn dà! wǒ men jìn qù kàn kàn ba?",
          "translation": {
            "fr": "Regarde, ce magasin est grand ! On va jeter un œil à l’intérieur ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好。你想买什么？",
          "pinyin": "hǎo. nǐ xiǎng mǎi shén me?",
          "translation": {
            "fr": "D’accord. Tu veux acheter quoi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我想买衣服。你知道哪个好吗？",
          "pinyin": "wǒ xiǎng mǎi yī fu. nǐ zhī dào nǎ ge hǎo ma?",
          "translation": {
            "fr": "Je voudrais acheter un vêtement. Tu sais lequel est bien ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "红的最漂亮，那个蓝的也很好。",
          "pinyin": "hóng de zuì piào liàng, nà ge lán de yě hěn hǎo.",
          "translation": {
            "fr": "Le rouge est le plus joli, et le bleu est bien aussi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "红的多少钱？",
          "pinyin": "hóng de duō shǎo qián?",
          "translation": {
            "fr": "Le rouge, c’est combien ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "一百块。",
          "pinyin": "yì bǎi kuài.",
          "translation": {
            "fr": "Cent yuans."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "一百块？我的钱不多！蓝的呢？",
          "pinyin": "yì bǎi kuài? wǒ de qián bù duō! lán de ne?",
          "translation": {
            "fr": "Cent yuans ? Je n’ai pas beaucoup d’argent ! Et le bleu ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "蓝的五十块，便宜很多。",
          "pinyin": "lán de wǔ shí kuài, pián yi hěn duō.",
          "translation": {
            "fr": "Le bleu coûte cinquante yuans, c’est bien moins cher."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那我买蓝的，谢谢你！",
          "pinyin": "nà wǒ mǎi lán de, xiè xie nǐ!",
          "translation": {
            "fr": "Alors je prends le bleu, merci !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 47
      }
    },
    {
      "id": "block-lesson-51-reading",
      "storyID": "story-lesson-51",
      "level": "HSK classique 2",
      "title": {
        "fr": "Un jour de pluie"
      },
      "paragraphs": [
        {
          "id": "lesson-51-p1",
          "hanzi": "这是北京最漂亮的路。下雨的时候，很多人进商店。",
          "pinyin": "zhè shì běi jīng zuì piào liàng de lù. xià yǔ de shí hou, hěn duō rén jìn shāng diàn.",
          "translation": {
            "fr": "C’est la plus belle rue de Pékin. Quand il pleut, beaucoup de gens entrent dans les magasins."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-51-p2",
          "hanzi": "有一家小商店的杯子很便宜，一个五块。今天有一百个人进了这家商店。",
          "pinyin": "yǒu yī jiā xiǎo shāng diàn de bēi zi hěn pián yi, yí gè wǔ kuài. jīn tiān yǒu yì bǎi gè rén jìn le zhè jiā shāng diàn.",
          "translation": {
            "fr": "Dans un petit magasin, les tasses sont très bon marché : cinq yuans pièce. Aujourd’hui, cent personnes sont entrées dans ce magasin."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l51-reading"
      ],
      "kind": "reading",
      "metadata": {
