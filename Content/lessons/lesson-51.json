    {
      "id": "block-lesson-51-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你看，这条街很干净。",
          "pinyin": "nǐ kàn, zhè tiáo jiē hěn gān jìng.",
          "translation": {
            "fr": "Regarde, cette rue est très propre."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "那栋楼很长，但是入口有点矮。",
          "pinyin": "nà dòng lóu hěn cháng, dàn shì rù kǒu yǒu diǎn ǎi.",
          "translation": {
            "fr": "Cet immeuble est long, mais l’entrée est un peu basse."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "打扫的人很聪明，知道哪里最差。",
          "pinyin": "dǎ sǎo de rén hěn cōng ming, zhī dào nǎ lǐ zuì chà.",
          "translation": {
            "fr": "Les personnes qui nettoient sont astucieuses et savent où c’est le pire."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "雨水被风吹进来了，我们一起看看。",
          "pinyin": "yǔ shuǐ bèi fēng chuī jìn lái le, wǒ men yì qǐ kàn kan.",
          "translation": {
            "fr": "L’eau de pluie a été poussée à l’intérieur par le vent ; regardons ensemble."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 47
      }
    },
