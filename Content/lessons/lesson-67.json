    {
      "id": "block-lesson-67-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你搬到这里多久了？",
          "pinyin": "nǐ bān dào zhè lǐ duō jiǔ le?",
          "translation": {
            "fr": "Depuis combien de temps as-tu déménagé ici ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不久。年轻人正在准备一个表演。",
          "pinyin": "bù jiǔ. nián qīng rén zhèng zài zhǔn bèi yí ge biǎo yǎn.",
          "translation": {
            "fr": "Pas longtemps. Les jeunes préparent un spectacle."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "他们一边练习体育动作，一边听音乐吗？",
          "pinyin": "tā men yì biān liàn xí tǐ yù dòng zuò, yì biān tīng yīn yuè ma?",
          "translation": {
            "fr": "Ils répètent des mouvements sportifs tout en écoutant de la musique ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，周末就可以看到了。",
          "pinyin": "shì, zhōu mò jiù kě yǐ kàn dào le.",
          "translation": {
            "fr": "Oui, on pourra le voir ce week-end."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 63
      }
    },
    {
      "id": "block-lesson-67-reading",
      "storyID": "story-lesson-67",
      "level": "HSK classique 2",
      "title": {
        "fr": "舞台前的练习"
      },
      "paragraphs": [
        {
          "id": "lesson-67-p1",
          "hanzi": "Tao搬到社区不久，发现年轻人喜欢体育。",
          "pinyin": "Tao bān dào shè qū bù jiǔ, fā xiàn nián qīng rén xǐ huan tǐ yù.",
          "translation": {
            "fr": "Tao a déménagé dans le quartier récemment et découvre que les jeunes aiment le sport."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-67-p2",
          "hanzi": "他们一边练习，一边准备周末的表演。",
          "pinyin": "tā men yì biān liàn xí, yì biān zhǔn bèi zhōu mò de biǎo yǎn.",
          "translation": {
            "fr": "Ils répètent tout en préparant le spectacle du week-end."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l67-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 63
      }
    },
