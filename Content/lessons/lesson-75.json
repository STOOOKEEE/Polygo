      "title": {
        "fr": "Un rendez-vous au marché"
      },
      "paragraphs": [
        {
          "id": "lesson-75-p1",
          "hanzi": "Mina和Tao十点在市场见面。",
          "pinyin": "Mina hé Tao shí diǎn zài shì chǎng jiàn miàn.",
          "translation": {
            "fr": "Mina et Tao se retrouvent au marché à dix heures."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-75-p2",
          "hanzi": "Tao买了两个碗和一根香蕉，一共五块三角。",
          "pinyin": "Tao mǎi le liǎng ge wǎn hé yì gēn xiāng jiāo, yí gòng wǔ kuài sān jiǎo.",
          "translation": {
            "fr": "Tao achète deux bols et une banane pour un total de cinq yuans et trente centimes."
          },
          "segmentation": [],
          "audio": null
        }
      ],
