    {
      "id": "block-lesson-75-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "我们几点见面？",
          "pinyin": "wǒ men jǐ diǎn jiàn miàn?",
          "translation": {
            "fr": "À quelle heure nous retrouvons-nous ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "十点。到时候我买两个碗和一根香蕉。",
          "pinyin": "shí diǎn. dào shí hou wǒ mǎi liǎng ge wǎn hé yì gēn xiāng jiāo.",
          "translation": {
            "fr": "À dix heures. Je vais acheter deux bols et une banane."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你会讲价吗？这个一共多少钱？",
          "pinyin": "nǐ huì jiǎng jià ma? zhè ge yí gòng duō shǎo qián?",
          "translation": {
            "fr": "Sais-tu marchander ? Combien cela coûte-t-il au total ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "五块三角，价格很合适。",
          "pinyin": "wǔ kuài sān jiǎo, jià gé hěn hé shì.",
          "translation": {
            "fr": "Cinq yuans et trente centimes, le prix est convenable."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 71
      }
    },
