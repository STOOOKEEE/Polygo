    {
      "id": "block-lesson-70-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你想坐火车或者坐飞机？",
          "pinyin": "nǐ xiǎng zuò huǒ chē huò zhě zuò fēi jī?",
          "translation": {
            "fr": "Tu veux prendre le train ou l’avion ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "这是一次极好的机会，我几乎每天都在计划。",
          "pinyin": "zhè shì yí cì jí hǎo de jī huì, wǒ jī hū měi tiān dōu zài jì huà.",
          "translation": {
            "fr": "C’est une très bonne occasion ; je planifie presque tous les jours."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "记得带护照。",
          "pinyin": "jì de dài hù zhào.",
          "translation": {
            "fr": "N’oublie pas ton passeport."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我记得，明天就出发。",
          "pinyin": "wǒ jì de, míng tiān jiù chū fā.",
          "translation": {
            "fr": "Je m’en souviens, je pars demain."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 66
      }
    },
    {
      "id": "block-lesson-70-reading",
      "storyID": "story-lesson-70",
      "level": "HSK classique 3",
      "title": {
        "fr": "Le choix du transport"
      },
      "paragraphs": [
        {
          "id": "lesson-70-p1",
          "hanzi": "Tao有一次旅行机会，要在火车和飞机之间选择。",
          "pinyin": "Tao yǒu yí cì lǚ xíng jī huì, yào zài huǒ chē hé fēi jī zhī jiān xuǎn zé.",
          "translation": {
            "fr": "Tao a une occasion de voyager et doit choisir entre le train et l’avion."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-70-p2",
          "hanzi": "他几乎准备好了，只要记得带护照就可以出发。",
          "pinyin": "tā jī hū zhǔn bèi hǎo le, zhǐ yào jì de dài hù zhào jiù kě yǐ chū fā.",
          "translation": {
            "fr": "Il est presque prêt ; il lui suffit de se souvenir de prendre son passeport pour partir."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
