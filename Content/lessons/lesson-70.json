    {
      "id": "block-lesson-70-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你想坐火车或者坐飞机？",
          "pinyin": "nǐ xiǎng zuò huǒ chē huò zhě zuò fēi jī?",
          "translation": {
            "fr": "Tu veux prendre le train ou l’avion ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "这是一次极好的机会，我几乎每天都在计划。",
          "pinyin": "zhè shì yí cì jí hǎo de jī huì, wǒ jī hū měi tiān dōu zài jì huà.",
          "translation": {
            "fr": "C’est une très bonne occasion ; je planifie presque tous les jours."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "记得带护照。",
          "pinyin": "jì de dài hù zhào.",
          "translation": {
            "fr": "N’oublie pas ton passeport."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我记得，明天就出发。",
          "pinyin": "wǒ jì de, míng tiān jiù chū fā.",
          "translation": {
            "fr": "Je m’en souviens, je pars demain."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 66
      }
    },
    {
