    {
      "id": "block-lesson-68-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "这幅画是黄色的吗？",
          "pinyin": "zhè fú huà shì huáng sè de ma?",
          "translation": {
            "fr": "Cette peinture est-elle jaune ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是。我想换一幅，因为颜色太暗了。",
          "pinyin": "shì. wǒ xiǎng huàn yì fú, yīn wèi yán sè tài àn le.",
          "translation": {
            "fr": "Oui. Je voudrais en changer parce que la couleur est trop sombre."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你明天把画还给老师吗？",
          "pinyin": "nǐ míng tiān bǎ huà huán gěi lǎo shī ma?",
          "translation": {
            "fr": "Tu rends la peinture au professeur demain ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "当然，我会把它还给老师。",
          "pinyin": "dāng rán, wǒ huì bǎ tā huán gěi lǎo shī.",
          "translation": {
            "fr": "Bien sûr, je la rendrai au professeur."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 64
      }
    },
    {
      "id": "block-lesson-68-reading",
      "storyID": "story-lesson-68",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une couleur à remplacer"
      },
      "paragraphs": [
        {
          "id": "lesson-68-p1",
          "hanzi": "Tao借了一幅画，但是颜色太暗，他想换一幅。",
          "pinyin": "Tao jiè le yì fú huà, dàn shì yán sè tài àn, tā xiǎng huàn yì fú.",
          "translation": {
            "fr": "Tao a emprunté une peinture, mais la couleur est trop sombre et il veut en changer."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-68-p2",
          "hanzi": "明天他会把第一幅画还给老师。",
          "pinyin": "míng tiān tā huì bǎ dì yī fú huà huán gěi lǎo shī.",
          "translation": {
            "fr": "Demain, il rendra la première peinture au professeur."
          },
          "segmentation": [],
          "audio": null
        }
      ],
