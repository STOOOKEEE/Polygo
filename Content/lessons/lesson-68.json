    {
      "id": "block-lesson-68-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "生日快乐！这是给你的。",
          "pinyin": "shēng rì kuài lè! zhè shì gěi nǐ de.",
          "translation": {
            "fr": "Joyeux anniversaire ! C’est pour toi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "谢谢！让我看看是什么。",
          "pinyin": "xiè xie! ràng wǒ kàn kan shì shén me.",
          "translation": {
            "fr": "Merci ! Laisse-moi voir ce que c’est."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "是一个白杯子，你喜欢吗？",
          "pinyin": "shì yí ge bái bēi zi, nǐ xǐ huān ma?",
          "translation": {
            "fr": "C’est une tasse blanche, elle te plaît ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "喜欢！这是我第一个白杯子。",
          "pinyin": "xǐ huān! zhè shì wǒ dì yī ge bái bēi zi.",
          "translation": {
            "fr": "Oui ! C’est ma première tasse blanche."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "还有，这本书还给你，谢谢你！",
          "pinyin": "hái yǒu, zhè běn shū huán gěi nǐ, xiè xie nǐ!",
          "translation": {
            "fr": "Et puis, je te rends ce livre, merci !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你看完了吗？你觉得怎么样？",
          "pinyin": "nǐ kàn wán le ma? nǐ jué de zěn me yàng?",
          "translation": {
            "fr": "Tu l’as fini ? Tu en as pensé quoi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "第一课我看了三次，后面的课很好看。",
          "pinyin": "dì yī kè wǒ kàn le sān cì, hòu miàn de kè hěn hǎo kàn.",
          "translation": {
            "fr": "J’ai lu la première leçon trois fois, les suivantes sont très bien."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "太好了！你想再看一本吗？我还有一本新书。",
          "pinyin": "tài hǎo le! nǐ xiǎng zài kàn yì běn ma? wǒ hái yǒu yì běn xīn shū.",
          "translation": {
            "fr": "Super ! Tu veux en lire un autre ? J’ai encore un livre tout neuf."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好，我下个星期还给你。",
          "pinyin": "hǎo, wǒ xià gè xīng qī huán gěi nǐ.",
          "translation": {
            "fr": "D’accord, je te le rendrai la semaine prochaine."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "没关系。你让我很高兴，谢谢！",
          "pinyin": "méi guān xì. nǐ ràng wǒ hěn gāo xìng, xiè xie!",
          "translation": {
            "fr": "Pas de souci. Tu me fais très plaisir, merci !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 64
      }
    },
    {
      "id": "block-lesson-68-reading",
      "storyID": "story-lesson-68",
      "level": "HSK classique 2",
      "title": {
        "fr": "Mon anniversaire"
      },
      "paragraphs": [
        {
          "id": "lesson-68-p1",
          "hanzi": "今天是我的生日，朋友给我一个白杯子。这是我第一个白杯子，我很喜欢。",
          "pinyin": "jīn tiān shì wǒ de shēng rì, péng yǒu gěi wǒ yí ge bái bēi zi. zhè shì wǒ dì yī ge bái bēi zi, wǒ hěn xǐ huān.",
          "translation": {
            "fr": "Aujourd’hui, c’est mon anniversaire et une amie m’a offert une tasse blanche. C’est ma première tasse blanche, elle me plaît beaucoup."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-68-p2",
          "hanzi": "她也还了我的书，还想再看一本新书。我让她下个星期再来，我们一起喝茶。这个生日真快乐！",
          "pinyin": "tā yě huán le wǒ de shū, hái xiǎng zài kàn yì běn xīn shū. wǒ ràng tā xià gè xīng qī zài lái, wǒ men yì qǐ hē chá. zhè ge shēng rì zhēn kuài lè!",
          "translation": {
            "fr": "Elle m’a aussi rendu mon livre et elle voudrait en lire un nouveau. Je lui ai dit de revenir la semaine prochaine pour boire du thé ensemble. Quel joyeux anniversaire !"
          },
          "segmentation": [],
          "audio": null
        }
      ],
