    {
      "id": "block-lesson-68-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "这幅画是黄色的吗？",
          "pinyin": "zhè fú huà shì huáng sè de ma?",
          "translation": {
            "fr": "Cette peinture est-elle jaune ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是。我想换一幅，因为颜色太暗了。",
          "pinyin": "shì. wǒ xiǎng huàn yì fú, yīn wèi yán sè tài àn le.",
          "translation": {
            "fr": "Oui. Je voudrais en changer parce que la couleur est trop sombre."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你明天把画还给老师吗？",
          "pinyin": "nǐ míng tiān bǎ huà huán gěi lǎo shī ma?",
          "translation": {
            "fr": "Tu rends la peinture au professeur demain ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "当然，我会把它还给老师。",
          "pinyin": "dāng rán, wǒ huì bǎ tā huán gěi lǎo shī.",
          "translation": {
            "fr": "Bien sûr, je la rendrai au professeur."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 64
      }
    },
