    {
      "id": "block-lesson-28-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你还不舒服吗？",
          "pinyin": "nǐ hái bù shū fú ma？",
          "translation": {
            "fr": "Tu ne te sens toujours pas bien ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是。我回答医生的问题以后才能进来。",
          "pinyin": "shì。 wǒ huí dá yī shēng de wèn tí yǐ hòu cái néng jìn lái。",
          "translation": {
            "fr": "Oui. Je peux entrer seulement après avoir répondu aux questions du médecin."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你觉得哪里不舒服？",
          "pinyin": "nǐ jué de nǎ lǐ bù shū fú？",
          "translation": {
            "fr": "Où te sens-tu mal ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我觉得头很热，但是医院很近。",
          "pinyin": "wǒ jué de tóu hěn rè， dàn shì yī yuàn hěn jìn。",
          "translation": {
            "fr": "J’ai la tête très chaude, mais l’hôpital est proche."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "如果你能走，就现在进去。",
          "pinyin": "rú guǒ nǐ néng zǒu， jiù xiàn zài jìn qù。",
          "translation": {
            "fr": "Si tu peux marcher, entre maintenant."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "可以，谢谢你介绍这位医生。",
          "pinyin": "kě yǐ， xiè xiè nǐ jiè shào zhè wèi yī shēng。",
          "translation": {
            "fr": "D’accord, merci de m’avoir présenté ce médecin."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 24
      }
    },
    {
      "id": "block-lesson-28-reading",
      "storyID": "story-lesson-28",
      "level": "HSK classique 2",
      "title": {
        "fr": "Le rendez-vous"
      },
      "paragraphs": [
        {
          "id": "lesson-28-p1",
          "hanzi": "Tao觉得身体不舒服，先回答医生的问题，然后进入医院。",
          "pinyin": "Tao jué de shēn tǐ bù shū fú， xiān huí dá yī shēng de wèn tí， rán hòu jìn rù yī yuàn。",
          "translation": {
            "fr": "Tao ne se sent pas bien ; il répond d’abord aux questions du médecin, puis entre dans l’hôpital."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-28-p2",
          "hanzi": "医院离家很近。如果他可以走路，就不用坐车。",
          "pinyin": "yī yuàn lí jiā hěn jìn。 rú guǒ tā kě yǐ zǒu lù， jiù bù yòng zuò chē。",
          "translation": {
            "fr": "L’hôpital est très près de chez lui. S’il peut marcher, il n’a pas besoin de prendre une voiture."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l28-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 24
      }
    },
