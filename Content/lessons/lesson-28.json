    {
      "id": "block-lesson-28-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "学校前面有一个商店，我想买杯子。",
          "pinyin": "xué xiào qián miàn yǒu yī gè shāng diàn, wǒ xiǎng mǎi bēi zi.",
          "translation": {
            "fr": "Il y a un magasin devant l’école, j’ai envie d’acheter une tasse."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，我们去。你想要什么颜色的？",
          "pinyin": "hǎo, wǒ men qù. nǐ xiǎng yào shén me yán sè de?",
          "translation": {
            "fr": "D’accord, allons-y. Tu la veux de quelle couleur ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "红的很好看，我想买红的。",
          "pinyin": "hóng de hěn hǎo kàn, wǒ xiǎng mǎi hóng de.",
          "translation": {
            "fr": "La rouge est très jolie, je veux acheter la rouge."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我看看。这个红杯子十七块。",
          "pinyin": "wǒ kàn kan. zhè ge hóng bēi zi shí qī kuài.",
          "translation": {
            "fr": "Voyons. Cette tasse rouge coûte dix-sept yuans."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "十七块？我今天的钱不多。",
          "pinyin": "shí qī kuài? wǒ jīn tiān de qián bù duō.",
          "translation": {
            "fr": "Dix-sept yuans ? Je n’ai pas beaucoup d’argent aujourd’hui."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "那蓝的呢？蓝的比红的小，可能十块钱。",
          "pinyin": "nà lán de ne? lán de bǐ hóng de xiǎo, kě néng shí kuài qián.",
          "translation": {
            "fr": "Et la bleue ? Elle est plus petite que la rouge, elle doit coûter dix yuans."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "十块，我可以买！我想要蓝的。",
          "pinyin": "shí kuài, wǒ kě yǐ mǎi! wǒ xiǎng yào lán de.",
          "translation": {
            "fr": "Dix yuans, ça, je peux ! Je prends la bleue."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你不要红的了吗？",
          "pinyin": "nǐ bú yào hóng de le ma?",
          "translation": {
            "fr": "Tu ne veux plus la rouge ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "不要了。蓝的也很好看。",
          "pinyin": "bú yào le. lán de yě hěn hǎo kàn.",
          "translation": {
            "fr": "Non. La bleue est très jolie aussi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，买蓝的！明天你在学校喝茶！",
          "pinyin": "hǎo, mǎi lán de! míng tiān nǐ zài xué xiào hē chá!",
          "translation": {
            "fr": "Bon, prends la bleue ! Demain tu boiras ton thé à l’école !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 24
      }
    },
