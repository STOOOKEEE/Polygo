    {
      "id": "block-lesson-54-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "你在看什么书？",
          "pinyin": "nǐ zài kàn shén me shū?",
          "translation": {
            "fr": "Qu’est-ce que tu lis ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "一本孩子的书。老师告诉我，这本书很好。",
          "pinyin": "yì běn hái zi de shū. lǎo shī gào su wǒ, zhè běn shū hěn hǎo.",
          "translation": {
            "fr": "Un livre pour enfants. Le professeur m’a dit qu’il était très bien."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "孩子的书？你觉得怎么样？",
          "pinyin": "hái zi de shū? nǐ jué de zěn me yàng?",
          "translation": {
            "fr": "Un livre pour enfants ? Tu en penses quoi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我觉得非常好！字不多，我都认识。",
          "pinyin": "wǒ jué de fēi cháng hǎo! zì bù duō, wǒ dōu rèn shi.",
          "translation": {
            "fr": "Je le trouve super ! Il n’y a pas beaucoup de caractères et je les connais tous."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "这本书有多少字？",
          "pinyin": "zhè běn shū yǒu duō shǎo zì?",
          "translation": {
            "fr": "Il y a combien de caractères dans ce livre ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "老师告诉我，有一千个字。",
          "pinyin": "lǎo shī gào su wǒ, yǒu yì qiān gè zì.",
          "translation": {
            "fr": "Le professeur m’a dit qu’il y en avait mille."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "一千个字！你今天读得完吗？",
          "pinyin": "yì qiān gè zì! nǐ jīn tiān dú de wán ma?",
          "translation": {
            "fr": "Mille caractères ! Tu vas arriver à le finir aujourd’hui ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我不知道。现在三点了，我晚上再读吧。",
          "pinyin": "wǒ bù zhī dào. xiàn zài sān diǎn le, wǒ wǎn shang zài dú ba.",
          "translation": {
            "fr": "Je ne sais pas. Il est déjà trois heures, je continuerai ce soir."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，你读完就告诉我，我也想看。",
          "pinyin": "hǎo, nǐ dú wán jiù gào su wǒ, wǒ yě xiǎng kàn.",
          "translation": {
            "fr": "D’accord, dis-le-moi quand tu auras fini, je veux le lire aussi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好！你想看，我们就一起看吧。",
          "pinyin": "hǎo! nǐ xiǎng kàn, wǒ men jiù yì qǐ kàn ba.",
          "translation": {
            "fr": "Ça marche ! Si tu veux le lire, lisons-le ensemble."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 50
      }
    },
    {
      "id": "block-lesson-54-reading",
      "storyID": "story-lesson-54",
