    {
      "id": "block-lesson-54-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你的作业写完了吗？",
          "pinyin": "nǐ de zuò yè xiě wán le ma?",
          "translation": {
            "fr": "As-tu fini tes devoirs ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "还差一点。我用字典查词语。",
          "pinyin": "hái chà yì diǎn. wǒ yòng zì diǎn chá cí yǔ.",
          "translation": {
            "fr": "Il reste encore un peu. Je cherche les mots dans le dictionnaire."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这是关于中国文化的作业吗？",
          "pinyin": "zhè shì guān yú Zhōng guó wén huà de zuò yè ma?",
          "translation": {
            "fr": "C’est un devoir sur la culture chinoise ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是。这个词会影响整句话的意思。",
          "pinyin": "shì. zhè ge cí huì yǐng xiǎng zhěng jù huà de yì si.",
          "translation": {
            "fr": "Oui. Ce mot peut influencer le sens de toute la phrase."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 50
      }
    },
    {
      "id": "block-lesson-54-reading",
      "storyID": "story-lesson-54",
      "level": "HSK classique 2",
      "title": {
        "fr": "Chercher un mot juste"
      },
      "paragraphs": [
        {
          "id": "lesson-54-p1",
          "hanzi": "Tao写关于中国文化的作业，但是还有一个词不明白。",
          "pinyin": "Tao xiě guān yú Zhōng guó wén huà de zuò yè, dàn shì hái yǒu yí ge cí bù míng bai.",
          "translation": {
            "fr": "Tao écrit un devoir sur la culture chinoise, mais il ne comprend pas encore un mot."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-54-p2",
          "hanzi": "他查了字典，发现这个词会影响整句话的意思。",
          "pinyin": "tā chá le zì diǎn, fā xiàn zhè ge cí huì yǐng xiǎng zhěng jù huà de yì si.",
          "translation": {
            "fr": "Il consulte le dictionnaire et découvre que ce mot peut influencer le sens de toute la phrase."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l54-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 50
      }
    },
