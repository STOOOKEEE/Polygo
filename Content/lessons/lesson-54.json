    {
      "id": "block-lesson-54-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你的作业写完了吗？",
          "pinyin": "nǐ de zuò yè xiě wán le ma?",
          "translation": {
            "fr": "As-tu fini tes devoirs ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "还差一点。我用字典查词语。",
          "pinyin": "hái chà yì diǎn. wǒ yòng zì diǎn chá cí yǔ.",
          "translation": {
            "fr": "Il reste encore un peu. Je cherche les mots dans le dictionnaire."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这是关于中国文化的作业吗？",
          "pinyin": "zhè shì guān yú Zhōng guó wén huà de zuò yè ma?",
          "translation": {
            "fr": "C’est un devoir sur la culture chinoise ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是。这个词会影响整句话的意思。",
          "pinyin": "shì. zhè ge cí huì yǐng xiǎng zhěng jù huà de yì si.",
          "translation": {
            "fr": "Oui. Ce mot peut influencer le sens de toute la phrase."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 50
      }
    },
