    {
      "id": "block-lesson-26-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你需要帮助吗？",
          "pinyin": "nǐ xū yào bāng zhù ma？",
          "translation": {
            "fr": "As-tu besoin d’aide ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "需要。这个题太难，我做错了。",
          "pinyin": "xū yào。 zhè ge tí tài nán， wǒ zuò cuò le。",
          "translation": {
            "fr": "Oui. Cet exercice est trop difficile, je me suis trompé."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "别着急，先看第一句话。",
          "pinyin": "bié zháo jí， xiān kàn dì yī jù huà。",
          "translation": {
            "fr": "Ne te dépêche pas, regarde d’abord la première phrase."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我不懂，但是我可以再做一次。",
          "pinyin": "wǒ bù dǒng， dàn shì wǒ kě yǐ zài zuò yī cì。",
          "translation": {
            "fr": "Je ne comprends pas, mais je peux le refaire."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你等我，我告诉你办法。",
          "pinyin": "nǐ děng wǒ， wǒ gào sù nǐ bàn fǎ。",
          "translation": {
            "fr": "Attends-moi, je vais te dire comment faire."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "谢谢！我懂了，也能帮助同学。",
          "pinyin": "xiè xiè！ wǒ dǒng le， yě néng bāng zhù tóng xué。",
          "translation": {
            "fr": "Merci ! J’ai compris et je peux aider un camarade."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 22
      }
    },
    {
      "id": "block-lesson-26-reading",
      "storyID": "story-lesson-26",
      "level": "HSK classique 2",
      "title": {
        "fr": "Corriger"
      },
      "paragraphs": [
        {
          "id": "lesson-26-p1",
          "hanzi": "学生做题的时候发现一个错误。老师让他先读第一句话。",
          "pinyin": "xué shēng zuò tí de shí hòu fā xiàn yí gè cuò wù。 lǎo shī ràng tā xiān dú dì yī jù huà。",
          "translation": {
            "fr": "En faisant l’exercice, l’étudiant découvre une erreur. Le professeur lui demande de lire d’abord la première phrase."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-26-p2",
          "hanzi": "他等老师解释，然后再做一次。最后他懂了，可以帮助同学。",
          "pinyin": "tā děng lǎo shī jiě shì， rán hòu zài zuò yī cì。 zuì hòu tā dǒng le， kě yǐ bāng zhù tóng xué。",
          "translation": {
            "fr": "Il attend l’explication du professeur puis recommence. Enfin, il comprend et peut aider son camarade."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l26-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 22
      }
    },
