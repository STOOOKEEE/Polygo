    {
      "id": "block-lesson-26-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "我有一个问题，你可以帮助我吗？",
          "pinyin": "wǒ yǒu yī gè wèn tí, nǐ kě yǐ bāng zhù wǒ ma?",
          "translation": {
            "fr": "J’ai une question, tu peux m’aider ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "可以！什么问题？",
          "pinyin": "kě yǐ! shén me wèn tí?",
          "translation": {
            "fr": "Bien sûr ! Quelle question ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "老师的书太长了，这个字我不会读。",
          "pinyin": "lǎo shī de shū tài cháng le, zhè ge zì wǒ bú huì dú.",
          "translation": {
            "fr": "Le livre du professeur est beaucoup trop long, et ce caractère, je ne sais pas le lire."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我看一下。我知道！你听我读。",
          "pinyin": "wǒ kàn yī xià. wǒ zhī dào! nǐ tīng wǒ dú.",
          "translation": {
            "fr": "Je regarde. Je sais ! Écoute-moi le lire."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我知道了！谢谢你的帮助。",
          "pinyin": "wǒ zhī dào le! xiè xie nǐ de bāng zhù.",
          "translation": {
            "fr": "Ça y est, j’ai compris ! Merci de ton aide."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不客气！明天老师可能有这个字的问题。",
          "pinyin": "bú kè qi! míng tiān lǎo shī kě néng yǒu zhè ge zì de wèn tí.",
          "translation": {
            "fr": "De rien ! Demain, le professeur aura peut-être une question sur ce caractère."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "是吗？那我今天要多读。",
          "pinyin": "shì ma? nà wǒ jīn tiān yào duō dú.",
          "translation": {
            "fr": "Ah bon ? Alors aujourd’hui je dois lire davantage."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "老师也会帮助你的。",
          "pinyin": "lǎo shī yě huì bāng zhù nǐ de.",
          "translation": {
            "fr": "Le professeur t’aidera aussi, tu sais."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "是，明天我去看老师。你太好了！",
          "pinyin": "shì, míng tiān wǒ qù kàn lǎo shī. nǐ tài hǎo le!",
          "translation": {
            "fr": "Oui, demain j’irai voir le professeur. Tu es vraiment gentil !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "没关系，我们都在学习。再见！",
          "pinyin": "méi guān xì, wǒ men dōu zài xué xí. zài jiàn!",
          "translation": {
            "fr": "Pas de souci, on apprend tous. À demain !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 22
      }
    },
    {
      "id": "block-lesson-26-reading",
      "storyID": "story-lesson-26",
      "level": "HSK classique 1",
      "title": {
        "fr": "Lire avec un ami"
      },
      "paragraphs": [
        {
          "id": "lesson-26-p1",
          "hanzi": "今天我读老师的书。书太长了，有一个字我不会读。",
          "pinyin": "jīn tiān wǒ dú lǎo shī de shū. shū tài cháng le, yǒu yī gè zì wǒ bú huì dú.",
          "translation": {
            "fr": "Aujourd’hui je lis le livre du professeur. Il est beaucoup trop long, et il y a un caractère que je ne sais pas lire."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-26-p2",
          "hanzi": "我朋友可以帮助我，他读，我听。明天老师可能有这个字的问题，我想我可以回答。",
          "pinyin": "wǒ péng you kě yǐ bāng zhù wǒ, tā dú, wǒ tīng. míng tiān lǎo shī kě néng yǒu zhè ge zì de wèn tí, wǒ xiǎng wǒ kě yǐ huí dá.",
          "translation": {
            "fr": "Mon ami peut m’aider : il lit, j’écoute. Demain le professeur aura peut-être une question sur ce caractère, et je pense que je pourrai répondre."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l26-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 22
      }
