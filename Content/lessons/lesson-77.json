    {
      "id": "block-lesson-77-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "明天的活动在哪里举行？",
          "pinyin": "míng tiān de huó dòng zài nǎ lǐ jǔ xíng?",
          "translation": {
            "fr": "Où l’activité de demain a-t-elle lieu ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "在学校。我们经过车站以后就到了。",
          "pinyin": "zài xué xiào. wǒ men jīng guò chē zhàn yǐ hòu jiù dào le.",
          "translation": {
            "fr": "À l’école. Nous y arrivons après être passés par la gare."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "还缺一张桌子，怎么办？",
          "pinyin": "hái quē yì zhāng zhuō zi, zěn me bàn?",
          "translation": {
            "fr": "Il manque encore une table, que fait-on ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我去借一张。这样就解决了。",
          "pinyin": "wǒ qù jiè yì zhāng. zhè yàng jiù jiě jué le.",
          "translation": {
            "fr": "Je vais en emprunter une. Comme ça, le problème est résolu."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 73
      }
    },
    {
      "id": "block-lesson-77-reading",
      "storyID": "story-lesson-77",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une table pour la fête"
      },
      "paragraphs": [
        {
          "id": "lesson-77-p1",
          "hanzi": "学校明天举行活动，Tao决定今天先准备。",
          "pinyin": "xué xiào míng tiān jǔ xíng huó dòng, Tao jué dìng jīn tiān xiān zhǔn bèi.",
          "translation": {
            "fr": "L’école organise une activité demain ; Tao décide de préparer aujourd’hui."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-77-p2",
          "hanzi": "经过检查，他们发现少一张桌子，于是去借一张。",
          "pinyin": "jīng guò jiǎn chá, tā men fā xiàn shǎo yì zhāng zhuō zi, yú shì qù jiè yì zhāng.",
          "translation": {
            "fr": "Après vérification, ils découvrent qu’il manque une table et vont en emprunter une."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l77-reading"
      ],
      "kind": "reading",
      "metadata": {
