    {
      "id": "block-lesson-77-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "明天的活动在哪里举行？",
          "pinyin": "míng tiān de huó dòng zài nǎ lǐ jǔ xíng?",
          "translation": {
            "fr": "Où l’activité de demain a-t-elle lieu ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "在学校。我们经过车站以后就到了。",
          "pinyin": "zài xué xiào. wǒ men jīng guò chē zhàn yǐ hòu jiù dào le.",
          "translation": {
            "fr": "À l’école. Nous y arrivons après être passés par la gare."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "还缺一张桌子，怎么办？",
          "pinyin": "hái quē yì zhāng zhuō zi, zěn me bàn?",
          "translation": {
            "fr": "Il manque encore une table, que fait-on ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我去借一张。这样就解决了。",
          "pinyin": "wǒ qù jiè yì zhāng. zhè yàng jiù jiě jué le.",
          "translation": {
            "fr": "Je vais en emprunter une. Comme ça, le problème est résolu."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 73
      }
    },
    {
