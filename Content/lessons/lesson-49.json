    {
      "id": "block-lesson-49-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "从你家到学校远吗？",
          "pinyin": "cóng nǐ jiā dào xué xiào yuǎn ma?",
          "translation": {
            "fr": "De chez toi à l’école, c’est loin ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不远，很近。我走路去，五分钟就到。",
          "pinyin": "bù yuǎn, hěn jìn. wǒ zǒu lù qù, wǔ fēn zhōng jiù dào.",
          "translation": {
            "fr": "Non, c’est tout près. J’y vais à pied, j’y suis en cinq minutes."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "太好了！我家很远。",
          "pinyin": "tài hǎo le! wǒ jiā hěn yuǎn.",
          "translation": {
            "fr": "Tu en as de la chance ! Chez moi, c’est très loin."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你怎么去学校？坐出租车吗？",
          "pinyin": "nǐ zěn me qù xué xiào? zuò chū zū chē ma?",
          "translation": {
            "fr": "Comment vas-tu à l’école ? En taxi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "是，因为路很长，所以我坐出租车。",
          "pinyin": "shì, yīn wèi lù hěn cháng, suǒ yǐ wǒ zuò chū zū chē.",
          "translation": {
            "fr": "Oui, comme la route est longue, je prends un taxi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "出租车要很多钱吗？",
          "pinyin": "chū zū chē yào hěn duō qián ma?",
          "translation": {
            "fr": "Un taxi, ça coûte cher ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我一个人坐要三十块，两个人坐就便宜。",
          "pinyin": "wǒ yí gè rén zuò yào sān shí kuài, liǎng gè rén zuò jiù pián yi.",
          "translation": {
            "fr": "Toute seule, ça fait trente yuans ; à deux, c’est moins cher."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "明天下雨，我不想走路。我们两个人一起坐，好吗？",
          "pinyin": "míng tiān xià yǔ, wǒ bù xiǎng zǒu lù. wǒ men liǎng gè rén yì qǐ zuò, hǎo ma?",
          "translation": {
            "fr": "Demain, il pleut, je n’ai pas envie de marcher. On le prend à deux, d’accord ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好！你家在我的路上，你在门旁边等我。",
          "pinyin": "hǎo! nǐ jiā zài wǒ de lù shàng, nǐ zài mén páng biān děng wǒ.",
          "translation": {
            "fr": "D’accord ! Ta maison est sur mon chemin, attends-moi devant la porte."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，你几点走？",
          "pinyin": "hǎo, nǐ jǐ diǎn zǒu?",
          "translation": {
            "fr": "D’accord, tu pars à quelle heure ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "七点走，你等我！",
          "pinyin": "qī diǎn zǒu, nǐ děng wǒ!",
          "translation": {
            "fr": "À sept heures. Attends-moi !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 45
      }
    },
    {
      "id": "block-lesson-49-reading",
      "storyID": "story-lesson-49",
      "level": "HSK classique 2",
      "title": {
        "fr": "Une petite enquête"
      },
      "paragraphs": [
        {
          "id": "lesson-49-p1",
          "hanzi": "今天有三个同学告诉我怎么来学校。有两个同学的家很近，因为路不长，所以走路来。",
          "pinyin": "jīn tiān yǒu sān gè tóng xué gào sù wǒ zěn me lái xué xiào. yǒu liǎng gè tóng xué de jiā hěn jìn, yīn wèi lù bù cháng, suǒ yǐ zǒu lù lái.",
          "translation": {
            "fr": "Aujourd’hui, trois camarades m’ont dit comment ils viennent à l’école. Deux d’entre eux habitent tout près : la route n’est pas longue, alors ils viennent à pied."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-49-p2",
          "hanzi": "有一个同学的家很远，他坐出租车，要三十分钟。家近的同学很喜欢走路。",
          "pinyin": "yǒu yí gè tóng xué de jiā hěn yuǎn, tā zuò chū zū chē, yào sān shí fēn zhōng. jiā jìn de tóng xué hěn xǐ huān zǒu lù.",
          "translation": {
            "fr": "Un camarade habite très loin : il prend un taxi, et il lui faut trente minutes. Ceux qui habitent près aiment beaucoup marcher."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l49-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 45
      }
    },
