    {
      "id": "block-lesson-49-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你和邻居的关系怎么样？",
          "pinyin": "nǐ hé lín jū de guān xì zěn me yàng？",
          "translation": {
            "fr": "Comment sont tes relations avec les voisins ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "很好。我们一起看看街道。",
          "pinyin": "hěn hǎo。 wǒ men yì qǐ kàn kàn jiē dào。",
          "translation": {
            "fr": "Très bonnes. Nous regardons la rue ensemble."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "街上有几辆车？",
          "pinyin": "jiē shàng yǒu jǐ liàng chē？",
          "translation": {
            "fr": "Combien de véhicules y a-t-il dans la rue ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有两辆。请张开口说清楚。",
          "pinyin": "yǒu liǎng liàng。 qǐng zhāng kāi kǒu shuō qīng chǔ。",
          "translation": {
            "fr": "Il y en a deux. Ouvre la bouche et parle clairement, s’il te plaît."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这条路比那条路远吗？",
          "pinyin": "zhè tiáo lù bǐ nà tiáo lù yuǎn ma？",
          "translation": {
            "fr": "Cette route est-elle plus éloignée que l’autre ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不，这条路更近，所以大家都走这里。",
          "pinyin": "bù， zhè tiáo lù gèng jìn， suǒ yǐ dà jiā dōu zǒu zhè lǐ。",
          "translation": {
            "fr": "Non, cette route est plus proche, donc tout le monde passe par ici."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 45
      }
    },
    {
      "id": "block-lesson-49-reading",
      "storyID": "story-lesson-49",
      "level": "HSK classique 2",
      "title": {
        "fr": "Dans le quartier"
      },
      "paragraphs": [
        {
          "id": "lesson-49-p1",
          "hanzi": "邻居关系很好，大家一起看看街道上的车辆和道路。",
          "pinyin": "lín jū guān xì hěn hǎo， dà jiā yì qǐ kàn kàn jiē dào shàng de chē liàng hé dào lù。",
          "translation": {
            "fr": "Les relations entre voisins sont très bonnes ; tout le monde regarde ensemble les véhicules et les routes de la rue."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-49-p2",
          "hanzi": "这条路比较近，另一条路比较远。因为这里有两辆车，所以大家小心地走。",
          "pinyin": "zhè tiáo lù bǐ jiào jìn， lìng yī tiáo lù bǐ jiào yuǎn。 yīn wèi zhè lǐ yǒu liǎng liàng chē， suǒ yǐ dà jiā xiǎo xīn dì zǒu。",
          "translation": {
            "fr": "Cette route est assez proche et l’autre assez éloignée. Comme il y a deux véhicules ici, tout le monde marche avec prudence."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l49-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 45
      }
    },
