    {
      "id": "block-lesson-69-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "请把公园的地址说清楚。",
          "pinyin": "qǐng bǎ gōng yuán de dì zhǐ shuō qīng chu.",
          "translation": {
            "fr": "Dis clairement l’adresse du parc, s’il te plaît."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "从这里往北走，路就容易找了。",
          "pinyin": "cóng zhè lǐ wǎng běi zǒu, lù jiù róng yì zhǎo le.",
          "translation": {
            "fr": "Depuis ici, va vers le nord et la route sera facile à trouver."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "今天刮风，带上地图很重要。",
          "pinyin": "jīn tiān guā fēng, dài shàng dì tú hěn zhòng yào.",
          "translation": {
            "fr": "Il y a du vent aujourd’hui ; il est important de prendre une carte."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "公园越来越近了。",
          "pinyin": "gōng yuán yuè lái yuè jìn le.",
          "translation": {
            "fr": "Le parc est de plus en plus proche."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 65
      }
    },
    {
      "id": "block-lesson-69-reading",
      "storyID": "story-lesson-69",
      "level": "HSK classique 3",
      "title": {
        "fr": "L’adresse du parc"
      },
      "paragraphs": [
        {
          "id": "lesson-69-p1",
          "hanzi": "刮风的时候，Tao把公园地址说得很清楚。",
          "pinyin": "guā fēng de shí hou, Tao bǎ gōng yuán dì zhǐ shuō de hěn qīng chu.",
          "translation": {
            "fr": "Quand il y a du vent, Tao énonce clairement l’adresse du parc."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-69-p2",
          "hanzi": "他们往北走，公园越来越近。",
          "pinyin": "tā men wǎng běi zǒu, gōng yuán yuè lái yuè jìn.",
          "translation": {
            "fr": "Ils marchent vers le nord et le parc se rapproche de plus en plus."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l69-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 65
      }
    },
