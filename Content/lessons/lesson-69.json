    {
      "id": "block-lesson-69-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "你走得太慢了，快点走！",
          "pinyin": "nǐ zǒu de tài màn le, kuài diǎn zǒu!",
          "translation": {
            "fr": "Tu marches trop lentement, dépêche-toi !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我今天六点起床，现在还想睡觉。",
          "pinyin": "wǒ jīn tiān liù diǎn qǐ chuáng, xiàn zài hái xiǎng shuì jiào.",
          "translation": {
            "fr": "Je me suis levée à six heures aujourd’hui, et j’ai encore envie de dormir."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "但是市场里的水果很新，也很便宜。",
          "pinyin": "dàn shì shì chǎng lǐ de shuǐ guǒ hěn xīn, yě hěn pián yi.",
          "translation": {
            "fr": "Mais les fruits du marché sont très frais, et pas chers."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那个人在卖什么？",
          "pinyin": "nà ge rén zài mài shén me?",
          "translation": {
            "fr": "Qu’est-ce qu’il vend, cet homme ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "他在卖西瓜，他的妻子在卖苹果。",
          "pinyin": "tā zài mài xī guā, tā de qī zi zài mài píng guǒ.",
          "translation": {
            "fr": "Il vend des pastèques, et sa femme des pommes."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我去问问西瓜多少钱一公斤。",
          "pinyin": "wǒ qù wèn wen xī guā duō shǎo qián yì gōng jīn.",
          "translation": {
            "fr": "Je vais demander combien coûte le kilo de pastèque."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "去吧，就在前面，很近。",
          "pinyin": "qù ba, jiù zài qián miàn, hěn jìn.",
          "translation": {
            "fr": "Vas-y, c’est juste devant, tout près."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "三块一公斤，比商店便宜。他和妻子六点就起床了！",
          "pinyin": "sān kuài yì gōng jīn, bǐ shāng diàn pián yi. tā hé qī zi liù diǎn jiù qǐ chuáng le!",
          "translation": {
            "fr": "Trois yuans le kilo, moins cher qu’au magasin. Lui et sa femme se sont levés dès six heures !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "那我们买两个吧。",
          "pinyin": "nà wǒ men mǎi liǎng ge ba.",
          "translation": {
            "fr": "Alors achetons-en deux."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好！早点起床，西瓜便宜，真不错！",
          "pinyin": "hǎo! zǎo diǎn qǐ chuáng, xī guā pián yi, zhēn bú cuò!",
          "translation": {
            "fr": "D’accord ! Se lever tôt, des pastèques pas chères, c’est vraiment bien !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 65
      }
    },
    {
      "id": "block-lesson-69-reading",
      "storyID": "story-lesson-69",
      "level": "HSK classique 2",
      "title": {
        "fr": "Un couple au marché"
      },
      "paragraphs": [
        {
          "id": "lesson-69-p1",
          "hanzi": "卖西瓜的人和他的妻子起床很早。六点，他和妻子已经在市场里了。",
          "pinyin": "mài xī guā de rén hé tā de qī zi qǐ chuáng hěn zǎo. liù diǎn, tā hé qī zi yǐ jīng zài shì chǎng lǐ le.",
          "translation": {
            "fr": "Le vendeur de pastèques et sa femme se lèvent très tôt. À six heures, lui et sa femme sont déjà au marché."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-69-p2",
          "hanzi": "买东西的人很多，大家都走得很慢。有一个学生想知道西瓜多少钱一公斤。卖西瓜的人笑着告诉他，三块一公斤，很便宜。",
          "pinyin": "mǎi dōng xi de rén hěn duō, dà jiā dōu zǒu de hěn màn. yǒu yí ge xué shēng xiǎng zhī dào xī guā duō shǎo qián yì gōng jīn. mài xī guā de rén xiào zhe gào su tā, sān kuài yì gōng jīn, hěn pián yi.",
          "translation": {
            "fr": "Il y a beaucoup de monde qui fait ses courses, et tout le monde avance lentement. Un étudiant voudrait savoir combien coûte le kilo de pastèque. Le vendeur lui répond en souriant : trois yuans le kilo, c’est très bon marché."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l69-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 65
      }
    },
