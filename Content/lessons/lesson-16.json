    {
      "id": "block-lesson-16-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "这个字你知道吗？请回答。",
          "pinyin": "zhè gè zì nǐ zhī dào ma? qǐng huí dá.",
          "translation": {
            "fr": "Ce caractère, tu le connais ? Réponds-moi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "是红吗？",
          "pinyin": "shì hóng ma?",
          "translation": {
            "fr": "C’est « rouge » ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是！这个呢？",
          "pinyin": "shì! zhè gè ne?",
          "translation": {
            "fr": "Oui ! Et celui-ci ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "是蓝？不，是绿！",
          "pinyin": "shì lán? bù, shì lǜ!",
          "translation": {
            "fr": "C’est « bleu » ? Non, c’est « vert » !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是绿！你都能回答。",
          "pinyin": "shì lǜ! nǐ dōu néng huí dá.",
          "translation": {
            "fr": "Oui, c’est « vert » ! Tu as tout bon."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我知道十个字。你知道几个？",
          "pinyin": "wǒ zhī dào shí gè zì. nǐ zhī dào jǐ gè?",
          "translation": {
            "fr": "Je connais dix caractères. Et toi, combien ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我知道很多，我比你多。",
          "pinyin": "wǒ zhī dào hěn duō, wǒ bǐ nǐ duō.",
          "translation": {
            "fr": "J’en connais beaucoup, j’en connais plus que toi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "为什么你比我多？",
          "pinyin": "wèi shén me nǐ bǐ wǒ duō?",
          "translation": {
            "fr": "Pourquoi tu en connais plus que moi ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我是中国人，我知道很多字！",
          "pinyin": "wǒ shì zhōng guó rén, wǒ zhī dào hěn duō zì!",
          "translation": {
            "fr": "Je suis chinois, je connais beaucoup de caractères !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我也想知道很多！明天你能来我家吗？",
          "pinyin": "wǒ yě xiǎng zhī dào hěn duō! míng tiān nǐ néng lái wǒ jiā ma?",
          "translation": {
            "fr": "Moi aussi, je veux en connaître beaucoup ! Tu peux venir chez moi demain ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "能！再见！",
          "pinyin": "néng! zài jiàn!",
          "translation": {
            "fr": "Oui ! Au revoir !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 12
      }
    },
    {
      "id": "block-lesson-16-reading",
      "storyID": "story-lesson-16",
      "level": "HSK classique 1",
      "title": {
        "fr": "Plus que mon ami"
      },
      "paragraphs": [
        {
          "id": "lesson-16-p1",
          "hanzi": "今天我和朋友都在家。我知道十个字，朋友知道很多字，他比我多。为什么？他是中国人，我是法国人。",
          "pinyin": "jīn tiān wǒ hé péng you dōu zài jiā. wǒ zhī dào shí gè zì, péng you zhī dào hěn duō zì, tā bǐ wǒ duō. wèi shén me? tā shì zhōng guó rén, wǒ shì fǎ guó rén.",
          "translation": {
            "fr": "Aujourd’hui, mon ami et moi sommes tous les deux à la maison. Je connais dix caractères, mon ami en connaît beaucoup, plus que moi. Pourquoi ? Il est chinois et moi, je suis française."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-16-p2",
          "hanzi": "现在我不知道很多字，明天我想多知道几个。我也想比他多！",
          "pinyin": "xiàn zài wǒ bù zhī dào hěn duō zì, míng tiān wǒ xiǎng duō zhī dào jǐ gè. wǒ yě xiǎng bǐ tā duō!",
          "translation": {
            "fr": "Pour l’instant je ne connais pas beaucoup de caractères, demain je veux en connaître quelques-uns de plus. Moi aussi, je veux en connaître plus que lui !"
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l16-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 12
      }
    },
