    {
      "id": "block-lesson-16-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "大家有几道题？",
          "pinyin": "dà jiā yǒu jǐ dào tí？",
          "translation": {
            "fr": "Combien d’exercices avez-vous tous ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我们有三道题，但是我不懂第二道。",
          "pinyin": "wǒ men yǒu sān dào tí， dàn shì wǒ bù dǒng dì èr dào。",
          "translation": {
            "fr": "Nous en avons trois, mais je ne comprends pas le deuxième."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "为什么不懂？",
          "pinyin": "wèi shén me bù dǒng？",
          "translation": {
            "fr": "Pourquoi ne le comprends-tu pas ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "这道题比第一道难，所以我问你。",
          "pinyin": "zhè dào tí bǐ dì yī dào nán， suǒ yǐ wǒ wèn nǐ。",
          "translation": {
            "fr": "Cet exercice est plus difficile que le premier, alors je te demande."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "答案怎么样？",
          "pinyin": "dá àn zěn me yàng？",
          "translation": {
            "fr": "Comment sont les réponses ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "现在我懂了，做完我们走吧。",
          "pinyin": "xiàn zài wǒ dǒng le， zuò wán wǒ men zǒu ba。",
          "translation": {
            "fr": "Maintenant j’ai compris ; quand nous aurons fini, partons."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 12
      }
    },
    {
      "id": "block-lesson-16-reading",
      "storyID": "story-lesson-16",
      "level": "HSK classique 2",
      "title": {
        "fr": "Le bilan"
      },
      "paragraphs": [
        {
          "id": "lesson-16-p1",
          "hanzi": "大家一起做题。第一道题比较简单，第二道题比第一道难。",
          "pinyin": "dà jiā yì qǐ zuò tí。 dì yī dào tí bǐ jiào jiǎn dān， dì èr dào tí bǐ dì yī dào nán。",
          "translation": {
            "fr": "Tout le monde fait les exercices ensemble. Le premier est assez simple ; le deuxième est plus difficile que le premier."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-16-p2",
          "hanzi": "Tao问为什么，Mina告诉他答案。做完三道题以后，大家都懂了。",
          "pinyin": "Tao wèn wèi shén me， Mina gào sù tā dá àn。 zuò wán sān dào tí yǐ hòu， dà jiā dōu dǒng le。",
          "translation": {
            "fr": "Tao demande pourquoi et Mina lui explique les réponses. Après les trois exercices, tout le monde a compris."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l16-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 12
      }
    },
