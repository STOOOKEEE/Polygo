    {
      "id": "block-l9-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "你好！我有电影，你想去我家吗？",
          "pinyin": "nǐ hǎo! wǒ yǒu diàn yǐng, nǐ xiǎng qù wǒ jiā ma?",
          "translation": {
            "fr": "Salut ! J’ai un film, ça te dit de venir chez moi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "想！我在火车站，你在哪？",
          "pinyin": "xiǎng! wǒ zài huǒ chē zhàn, nǐ zài nǎ?",
          "translation": {
            "fr": "Oui ! Je suis à la gare. Et toi, tu es où ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我在家，电脑也在家。你会去吗？",
          "pinyin": "wǒ zài jiā, diàn nǎo yě zài jiā. nǐ huì qù ma?",
          "translation": {
            "fr": "Je suis chez moi, l’ordinateur aussi. Tu viendras ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "会！我买了茶，也买了书。",
          "pinyin": "huì! wǒ mǎi le chá, yě mǎi le shū.",
          "translation": {
            "fr": "Oui ! J’ai acheté du thé, et un livre aussi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你买了茶！我有电影，你有茶。",
          "pinyin": "nǐ mǎi le chá! wǒ yǒu diàn yǐng, nǐ yǒu chá.",
          "translation": {
            "fr": "Tu as acheté du thé ! Moi, j’ai le film, toi le thé."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "从火车站去你家，我不知道。",
          "pinyin": "cóng huǒ chē zhàn qù nǐ jiā, wǒ bù zhī dào.",
          "translation": {
            "fr": "De la gare jusque chez toi, je ne connais pas le chemin."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "从火车站去商店，从商店去我家。",
          "pinyin": "cóng huǒ chē zhàn qù shāng diàn, cóng shāng diàn qù wǒ jiā.",
          "translation": {
            "fr": "De la gare, tu vas au magasin, et du magasin tu viens chez moi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我知道了！再见！",
          "pinyin": "wǒ zhī dào le! zài jiàn!",
          "translation": {
            "fr": "J’ai compris ! À tout à l’heure !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 5
      }
    },
    {
      "id": "block-l9-reading",
      "storyID": "story-l9-station",
      "title": {
        "fr": "Un vendredi chez moi"
      },
      "paragraphs": [
        {
          "id": "lesson-09-p1",
          "hanzi": "今天是星期五，我在家。我有电影，朋友想去我家。",
          "pinyin": "jīn tiān shì xīng qī wǔ, wǒ zài jiā. wǒ yǒu diàn yǐng, péng yǒu xiǎng qù wǒ jiā.",
          "translation": {
            "fr": "Aujourd’hui, on est vendredi et je suis chez moi. J’ai un film, et mon ami a envie de venir chez moi."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-09-p2",
          "hanzi": "朋友从火车站去商店，买了茶。朋友会去我家。电影和茶都有了！",
          "pinyin": "péng yǒu cóng huǒ chē zhàn qù shāng diàn, mǎi le chá. péng yǒu huì qù wǒ jiā. diàn yǐng hé chá dōu yǒu le!",
          "translation": {
            "fr": "Mon ami va de la gare au magasin et achète du thé. Il va venir chez moi. Nous avons le film et le thé !"
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l9-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 5
      }
    },
