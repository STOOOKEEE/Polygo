    {
      "id": "block-l9-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你昨天在家吗？",
          "pinyin": "nǐ zuó tiān zài jiā ma?",
          "translation": {
            "fr": "Tu étais à la maison hier ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不在，我去了火车站。",
          "pinyin": "bù zài, wǒ qù le huǒ chē zhàn.",
          "translation": {
            "fr": "Non, je suis allé à la gare."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你会骑自行车吗？你几点回家？",
          "pinyin": "nǐ huì qí zì xíng chē ma? nǐ jǐ diǎn huí jiā?",
          "translation": {
            "fr": "Tu sais faire du vélo ? À quelle heure rentres-tu ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "会。五点回家。",
          "pinyin": "huì. wǔ diǎn huí jiā.",
          "translation": {
            "fr": "Oui. Je rentre à cinq heures."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我从家走到火车站。",
          "pinyin": "wǒ cóng jiā zǒu dào huǒ chē zhàn.",
          "translation": {
            "fr": "Je marche de la maison jusqu’à la gare."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，我回家。",
          "pinyin": "hǎo, wǒ huí jiā.",
          "translation": {
            "fr": "D’accord, je rentre à la maison."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 5
      }
    },
