  "grammarPoints": [
    {
      "id": "gram-xiang-hui",
      "pattern": "Sujet + 想/会 + verbe",
      "function": "想 et 会 : envie et capacité + verbe",
      "markers": [
        "想",
        "会"
      ],
      "errors": [
        "Ne mets pas le modal après le verbe : 我去想 ne veut rien dire, dis 我想去。 Pour nier, 不 va devant le modal, pas devant le verbe principal : 我不想去。"
      ]
    }
