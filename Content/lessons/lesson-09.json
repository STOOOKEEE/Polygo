    {
      "id": "block-l9-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "你好！我有电影，你想去我家吗？",
          "pinyin": "nǐ hǎo! wǒ yǒu diàn yǐng, nǐ xiǎng qù wǒ jiā ma?",
          "translation": {
            "fr": "Salut ! J’ai un film, ça te dit de venir chez moi ?"
          },
          "audio": {
            "id": "audio-ca637b1b920ed30736a21c0b",
            "kind": "audio",
            "relativePath": "assets/audio/ca637b1b920ed30736a21c0b.m4a",
            "sha256": "3d04c863cf6b0787ebdafc145ba4c3d7c6aa69f4fd890b6ea85d0c617b0c930f",
            "durationMilliseconds": 3293
          }
        },
        {
          "speaker": "Mina",
          "hanzi": "想！我在火车站，你在哪？",
          "pinyin": "xiǎng! wǒ zài huǒ chē zhàn, nǐ zài nǎ?",
          "translation": {
            "fr": "Oui ! Je suis à la gare. Et toi, tu es où ?"
          },
          "audio": {
            "id": "audio-e694ff4be0558c58b9975daa",
            "kind": "audio",
            "relativePath": "assets/audio/e694ff4be0558c58b9975daa.m4a",
            "sha256": "09b9d0e86b7d1613549f6f4441d6fc6e899bae6af39b207f41f27f14def376e4",
            "durationMilliseconds": 3309
          }
        },
        {
          "speaker": "Tao",
          "hanzi": "我在家，电脑也在家。你会去吗？",
          "pinyin": "wǒ zài jiā, diàn nǎo yě zài jiā. nǐ huì qù ma?",
          "translation": {
            "fr": "Je suis chez moi, l’ordinateur aussi. Tu viendras ?"
          },
          "audio": {
            "id": "audio-674919e21bfb3b0ada8736e6",
            "kind": "audio",
            "relativePath": "assets/audio/674919e21bfb3b0ada8736e6.m4a",
            "sha256": "6b62a5567a438cefb044fe224b92510e773e6f532f65ae52fc85c154badf07a6",
            "durationMilliseconds": 3440
          }
        },
        {
          "speaker": "Mina",
          "hanzi": "会！我买了茶，也买了书。",
          "pinyin": "huì! wǒ mǎi le chá, yě mǎi le shū.",
          "translation": {
            "fr": "Oui ! J’ai acheté du thé, et un livre aussi."
          },
          "audio": {
            "id": "audio-845d30f4fd805df83d4671a6",
            "kind": "audio",
            "relativePath": "assets/audio/845d30f4fd805df83d4671a6.m4a",
            "sha256": "b758d895efd1110ec86a0b75e4ebf599b0417a807ca4c6bb8bf26b4c0aee929a",
            "durationMilliseconds": 3026
          }
        },
        {
          "speaker": "Tao",
          "hanzi": "你买了茶！我有电影，你有茶。",
          "pinyin": "nǐ mǎi le chá! wǒ yǒu diàn yǐng, nǐ yǒu chá.",
          "translation": {
            "fr": "Tu as acheté du thé ! Moi, j’ai le film, toi le thé."
          },
          "audio": {
            "id": "audio-f327bd65d0cd4cdc6b38491b",
            "kind": "audio",
            "relativePath": "assets/audio/f327bd65d0cd4cdc6b38491b.m4a",
            "sha256": "3dc95423cb2b3d58525d4350a17d51f977dd9525ac4423801f0e0a112dedd7fa",
            "durationMilliseconds": 3099
          }
        },
        {
          "speaker": "Mina",
          "hanzi": "从火车站去你家，我不知道。",
          "pinyin": "cóng huǒ chē zhàn qù nǐ jiā, wǒ bù zhī dào.",
          "translation": {
            "fr": "De la gare jusque chez toi, je ne connais pas le chemin."
          },
          "audio": {
            "id": "audio-bdbbafa9307f01961484d51c",
            "kind": "audio",
            "relativePath": "assets/audio/bdbbafa9307f01961484d51c.m4a",
            "sha256": "363e90628f14663dc8337c0a4241181bf2a4b8a71c29db53f62a76727f3c34bf",
            "durationMilliseconds": 3000
          }
        },
        {
          "speaker": "Tao",
          "hanzi": "从火车站去商店，从商店去我家。",
          "pinyin": "cóng huǒ chē zhàn qù shāng diàn, cóng shāng diàn qù wǒ jiā.",
          "translation": {
            "fr": "De la gare, tu vas au magasin, et du magasin tu viens chez moi."
          },
          "audio": {
            "id": "audio-e05c510967a56e922ab5f9b1",
            "kind": "audio",
            "relativePath": "assets/audio/e05c510967a56e922ab5f9b1.m4a",
            "sha256": "c1c2e46df435ae8666751ce290b5f3cc061bb5a724bc066b347f31f53a3fd5e7",
            "durationMilliseconds": 3448
          }
        },
        {
          "speaker": "Mina",
          "hanzi": "我知道了！再见！",
          "pinyin": "wǒ zhī dào le! zài jiàn!",
          "translation": {
            "fr": "J’ai compris ! À tout à l’heure !"
          },
          "audio": {
            "id": "audio-f1605ebe41428cbeff03f49b",
            "kind": "audio",
            "relativePath": "assets/audio/f1605ebe41428cbeff03f49b.m4a",
            "sha256": "bb19a6be81695dcd370f6f47cb6ceaec912d94862acecad489d661fee5e30f3a",
            "durationMilliseconds": 2419
          }
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 5
      }
    },
    {
      "id": "block-l9-reading",
      "storyID": "story-l9-station",
      "title": {
        "fr": "Un vendredi chez moi"
      },
      "paragraphs": [
        {
          "id": "lesson-09-p1",
          "hanzi": "今天是星期五，我在家。我有电影，朋友想去我家。",
          "pinyin": "jīn tiān shì xīng qī wǔ, wǒ zài jiā. wǒ yǒu diàn yǐng, péng yǒu xiǎng qù wǒ jiā.",
          "translation": {
            "fr": "Aujourd’hui, on est vendredi et je suis chez moi. J’ai un film, et mon ami a envie de venir chez moi."
          },
          "segmentation": [],
          "audio": {
            "id": "audio-1589c01585d6fc94e4b08a06",
            "kind": "audio",
            "relativePath": "assets/audio/1589c01585d6fc94e4b08a06.m4a",
            "sha256": "4e1c0949a32f3193b84cf215e93a3afb2f4dc4d15d21fe78638f6e6eb590c73e",
            "durationMilliseconds": 5535
          }
        },
        {
          "id": "lesson-09-p2",
          "hanzi": "朋友从火车站去商店，买了茶。朋友会去我家。电影和茶都有了！",
          "pinyin": "péng yǒu cóng huǒ chē zhàn qù shāng diàn, mǎi le chá. péng yǒu huì qù wǒ jiā. diàn yǐng hé chá dōu yǒu le!",
          "translation": {
            "fr": "Mon ami va de la gare au magasin et achète du thé. Il va venir chez moi. Nous avons le film et le thé !"
          },
          "segmentation": [],
          "audio": {
            "id": "audio-31abd258dcade22bda6e83c8",
