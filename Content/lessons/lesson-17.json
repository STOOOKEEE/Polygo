  "blocks": [
    {
      "kind": "introduction",
      "id": "block-lesson-17-grammar-01",
      "title": {
        "fr": "Grammaire — 正在 + verbe"
      },
      "body": {
        "fr": "正在 indique une action en cours au moment où l’on parle.\nExemple 1 : 我正在写字。\nwǒ zhèng zài xiě zì。\nJe suis en train d’écrire des caractères."
      },
      "metadata": {
        "stage": "introduce",
        "skill": "recognition",
        "lessonDay": 13
      }
    },
