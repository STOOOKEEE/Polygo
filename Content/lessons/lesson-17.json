    {
      "id": "block-lesson-17-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你在教室！你在学习吗？",
          "pinyin": "nǐ zài jiào shì! nǐ zài xué xí ma?",
          "translation": {
            "fr": "Tu es en classe ! Tu es en train de travailler ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，我下午都在这里学习。",
          "pinyin": "shì, wǒ xià wǔ dōu zài zhè lǐ xué xí.",
          "translation": {
            "fr": "Oui, je travaille ici tout l’après-midi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "老师不在吗？我有一个问题。",
          "pinyin": "lǎo shī bú zài ma? wǒ yǒu yí gè wèn tí.",
          "translation": {
            "fr": "Le professeur n’est pas là ? J’ai une question."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "老师下午不在。你的问题是什么？",
          "pinyin": "lǎo shī xià wǔ bú zài. nǐ de wèn tí shì shén me?",
          "translation": {
            "fr": "Le professeur n’est pas là cet après-midi. C’est quoi, ta question ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这个字我不知道。你知道吗？",
          "pinyin": "zhè gè zì wǒ bù zhī dào. nǐ zhī dào ma?",
          "translation": {
            "fr": "Ce caractère, je ne le connais pas. Et toi, tu le connais ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我也不知道。An是我们的同学，我们请An回答。",
          "pinyin": "wǒ yě bù zhī dào. An shì wǒ men de tóng xué, wǒ men qǐng An huí dá.",
          "translation": {
            "fr": "Moi non plus. An est notre camarade de classe, demandons à An de répondre."
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "我在这里！什么问题？",
          "pinyin": "wǒ zài zhè lǐ! shén me wèn tí?",
          "translation": {
            "fr": "Je suis là ! C’est quoi, la question ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这个字是什么？",
          "pinyin": "zhè gè zì shì shén me?",
          "translation": {
            "fr": "Ce caractère, c’est quoi ?"
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "是绿！这个问题不大。",
          "pinyin": "shì lǜ! zhè gè wèn tí bú dà.",
          "translation": {
            "fr": "C’est « vert » ! Ce n’est pas une grosse question."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "谢谢！我们三个下午都在教室学习。",
          "pinyin": "xiè xie! wǒ men sān gè xià wǔ dōu zài jiào shì xué xí.",
          "translation": {
            "fr": "Merci ! On révise tous les trois dans la classe cet après-midi."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 13
      }
    },
    {
      "id": "block-lesson-17-reading",
      "storyID": "story-lesson-17",
      "level": "HSK classique 1",
      "title": {
        "fr": "Dans la salle de classe"
      },
      "paragraphs": [
        {
          "id": "lesson-17-p1",
          "hanzi": "今天下午我在教室里学习。老师不在，教室里有很多同学。",
          "pinyin": "jīn tiān xià wǔ wǒ zài jiào shì lǐ xué xí. lǎo shī bú zài, jiào shì lǐ yǒu hěn duō tóng xué.",
          "translation": {
            "fr": "Cet après-midi, j’étudie dans la salle de classe. Le professeur n’est pas là, mais il y a beaucoup de camarades."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-17-p2",
          "hanzi": "我有一个问题，我请一个同学回答。同学回答了，我笑了。",
          "pinyin": "wǒ yǒu yí gè wèn tí, wǒ qǐng yí gè tóng xué huí dá. tóng xué huí dá le, wǒ xiào le.",
          "translation": {
            "fr": "J’ai une question et je demande à un camarade d’y répondre. Le camarade répond et je souris."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l17-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 13
      }
