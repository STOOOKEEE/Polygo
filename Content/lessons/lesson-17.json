    {
      "id": "block-lesson-17-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你正在读什么？",
          "pinyin": "nǐ zhèng zài dú shén me？",
          "translation": {
            "fr": "Qu’es-tu en train de lire ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我正在读课本，准备考试。",
          "pinyin": "wǒ zhèng zài dú kè běn， zhǔn bèi kǎo shì。",
          "translation": {
            "fr": "Je lis le manuel et je prépare l’examen."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "同学们在哪里写字？",
          "pinyin": "tóng xué men zài nǎ lǐ xiě zì？",
          "translation": {
            "fr": "Où les camarades écrivent-ils ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "他们在教室写字，也学习新课。",
          "pinyin": "tā men zài jiào shì xiě zì， yě xué xí xīn kè。",
          "translation": {
            "fr": "Ils écrivent dans la classe et étudient aussi la nouvelle leçon."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "老师要什么？",
          "pinyin": "lǎo shī yào shén me？",
          "translation": {
            "fr": "Que veut le professeur ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "老师要我们读这个字，然后回答问题。",
          "pinyin": "lǎo shī yào wǒ men dú zhè ge zì， rán hòu huí dá wèn tí。",
          "translation": {
            "fr": "Le professeur veut que nous lisions ce caractère puis répondions à la question."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 13
      }
    },
    {
      "id": "block-lesson-17-reading",
      "storyID": "story-lesson-17",
      "level": "HSK classique 2",
      "title": {
        "fr": "Dans la classe"
      },
      "paragraphs": [
        {
          "id": "lesson-17-p1",
          "hanzi": "同学们在教室读书、写字。老师说今天开始新课。",
          "pinyin": "tóng xué men zài jiào shì dú shū、 xiě zì。 lǎo shī shuō jīn tiān kāi shǐ xīn kè。",
          "translation": {
            "fr": "Les camarades lisent et écrivent dans la classe. Le professeur dit que la nouvelle leçon commence aujourd’hui."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-17-p2",
          "hanzi": "下午大家学习，明天考试。每个人都要认真回答问题。",
          "pinyin": "xià wǔ dà jiā xué xí， míng tiān kǎo shì。 měi gè rén dōu yào rèn zhēn huí dá wèn tí。",
          "translation": {
            "fr": "L’après-midi, tout le monde étudie ; l’examen a lieu demain. Chacun doit répondre sérieusement aux questions."
          },
          "segmentation": [],
          "audio": null
        }
      ],
