    {
      "id": "block-lesson-24-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你今天忙吗？",
          "pinyin": "nǐ jīn tiān máng ma？",
          "translation": {
            "fr": "Es-tu occupé aujourd’hui ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "很忙，也很累。我住在医院附近。",
          "pinyin": "hěn máng， yě hěn lèi。 wǒ zhù zài yī yuàn fù jìn。",
          "translation": {
            "fr": "Très occupé et très fatigué. J’habite près de l’hôpital."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你什么时候去医院？",
          "pinyin": "nǐ shén me shí hòu qù yī yuàn？",
          "translation": {
            "fr": "Quand vas-tu à l’hôpital ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我一边走路一边给医生打电话。",
          "pinyin": "wǒ yī biān zǒu lù yī biān gěi yī shēng dǎ diàn huà。",
          "translation": {
            "fr": "Je marche tout en appelant le médecin."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "医院里有几个房间？",
          "pinyin": "yī yuàn lǐ yǒu jǐ gè fáng jiān？",
          "translation": {
            "fr": "Combien de pièces y a-t-il dans l’hôpital ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有几个房间，白色的门在前面。",
          "pinyin": "yǒu jǐ gè fáng jiān， bái sè de mén zài qián miàn。",
          "translation": {
            "fr": "Il y a plusieurs pièces ; la porte blanche est devant."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 20
      }
    },
    {
      "id": "block-lesson-24-reading",
      "storyID": "story-lesson-24",
      "level": "HSK classique 1",
      "title": {
        "fr": "Près de l’hôpital"
      },
      "paragraphs": [
        {
          "id": "lesson-24-p1",
          "hanzi": "我住在医院附近，今天很忙，所以早上就出门。",
          "pinyin": "wǒ zhù zài yī yuàn fù jìn， jīn tiān hěn máng， suǒ yǐ zǎo shàng jiù chū mén。",
          "translation": {
            "fr": "J’habite près de l’hôpital. Comme je suis très occupé aujourd’hui, je sors dès le matin."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-24-p2",
          "hanzi": "我一边走路一边听医生说话。医院里有几个房间，白色的门在前面。",
          "pinyin": "wǒ yī biān zǒu lù yī biān tīng yī shēng shuō huà。 yī yuàn lǐ yǒu jǐ gè fáng jiān， bái sè de mén zài qián miàn。",
          "translation": {
            "fr": "Je marche tout en écoutant le médecin parler. L’hôpital a plusieurs pièces ; sa porte blanche est devant."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l24-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 20
      }
    },
