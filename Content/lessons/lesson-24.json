    {
      "id": "block-lesson-24-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "今天医院的人很多。你姐姐在哪里？",
          "pinyin": "jīn tiān yī yuàn de rén hěn duō. nǐ jiě jie zài nǎ lǐ?",
          "translation": {
            "fr": "Il y a beaucoup de monde à l’hôpital aujourd’hui. Où est ta grande sœur ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "她在前面，你看，她在和人说话。",
          "pinyin": "tā zài qián miàn, nǐ kàn, tā zài hé rén shuō huà.",
          "translation": {
            "fr": "Elle est devant, regarde : elle parle avec quelqu’un."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "她是医生，工作很多！",
          "pinyin": "tā shì yī shēng, gōng zuò hěn duō!",
          "translation": {
            "fr": "Elle est médecin, elle a beaucoup de travail !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，很多时候她不在家。",
          "pinyin": "shì, hěn duō shí hou tā bú zài jiā.",
          "translation": {
            "fr": "Oui, elle n’est souvent pas à la maison."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "现在几点？她今天有时间吗？",
          "pinyin": "xiàn zài jǐ diǎn? tā jīn tiān yǒu shí jiān ma?",
          "translation": {
            "fr": "Quelle heure est-il ? Elle a un moment aujourd’hui ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "十点。她十一点有时间，我们在这里坐一下。",
          "pinyin": "shí diǎn. tā shí yī diǎn yǒu shí jiān, wǒ men zài zhè lǐ zuò yī xià.",
          "translation": {
            "fr": "Dix heures. Elle aura du temps à onze heures, on s’assoit ici un moment."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "医院里有茶吗？我想喝茶。",
          "pinyin": "yī yuàn lǐ yǒu chá ma? wǒ xiǎng hē chá.",
          "translation": {
            "fr": "Il y a du thé dans l’hôpital ? J’ai envie d’un thé."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有，前面的商店有茶和牛奶。",
          "pinyin": "yǒu, qián miàn de shāng diàn yǒu chá hé niú nǎi.",
          "translation": {
            "fr": "Oui, le magasin là-devant a du thé et du lait."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我去买。你要什么？",
          "pinyin": "wǒ qù mǎi. nǐ yào shén me?",
          "translation": {
            "fr": "J’y vais. Tu veux quoi ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我要牛奶，谢谢！",
          "pinyin": "wǒ yào niú nǎi, xiè xie!",
          "translation": {
            "fr": "Du lait, merci !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 20
      }
    },
    {
      "id": "block-lesson-24-reading",
      "storyID": "story-lesson-24",
      "level": "HSK classique 1",
      "title": {
        "fr": "Une journée de médecin"
      },
      "paragraphs": [
        {
          "id": "lesson-24-p1",
          "hanzi": "我朋友的姐姐是医生，她在医院工作。今天医院的人很多，她的工作也很多。",
          "pinyin": "wǒ péng you de jiě jie shì yī shēng, tā zài yī yuàn gōng zuò. jīn tiān yī yuàn de rén hěn duō, tā de gōng zuò yě hěn duō.",
          "translation": {
            "fr": "La grande sœur de mon ami est médecin, elle travaille à l’hôpital. Aujourd’hui il y a beaucoup de monde, et elle a beaucoup de travail."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-24-p2",
          "hanzi": "很多时候她在医院和人说话，在家的时候她想睡觉，不想说话。十一点她有时间，我们和她喝茶。",
          "pinyin": "hěn duō shí hou tā zài yī yuàn hé rén shuō huà, zài jiā de shí hou tā xiǎng shuì jiào, bù xiǎng shuō huà. shí yī diǎn tā yǒu shí jiān, wǒ men hé tā hē chá.",
          "translation": {
            "fr": "Souvent, elle parle avec des gens à l’hôpital ; quand elle est chez elle, elle veut dormir et ne veut pas parler. À onze heures elle a du temps, nous prenons le thé avec elle."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l24-reading"
      ],
      "kind": "reading",
      "metadata": {
