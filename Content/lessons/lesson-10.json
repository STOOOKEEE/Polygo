    {
      "id": "block-lesson-10-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你的房间有桌子和椅子吗？",
          "pinyin": "nǐ de fáng jiān yǒu zhuō zi hé yǐ zi ma？",
          "translation": {
            "fr": "Ta chambre a une table et des chaises ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有，桌子上有一本书。",
          "pinyin": "yǒu， zhuō zi shàng yǒu yī běn shū。",
          "translation": {
            "fr": "Oui, il y a un livre sur la table."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "门旁边有手机吗？",
          "pinyin": "mén páng biān yǒu shǒu jī ma？",
          "translation": {
            "fr": "Y a-t-il un téléphone près de la porte ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "手机在桌子上，我给老师打电话。",
          "pinyin": "shǒu jī zài zhuō zi shàng， wǒ gěi lǎo shī dǎ diàn huà。",
          "translation": {
            "fr": "Le téléphone est sur la table ; j’appelle le professeur."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你的朋友也在房间吗？",
          "pinyin": "nǐ de péng yǒu yě zài fáng jiān ma？",
          "translation": {
            "fr": "Ton ami est aussi dans la chambre ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "他不在。老师要这本书，所以我先整理房间。",
          "pinyin": "tā bù zài。 lǎo shī yào zhè běn shū， suǒ yǐ wǒ xiān zhěng lǐ fáng jiān。",
          "translation": {
            "fr": "Il n’est pas là. Le professeur veut ce livre, alors je range d’abord la chambre."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 6
      }
    },
    {
      "id": "block-lesson-10-reading",
      "storyID": "story-lesson-10",
      "level": "HSK classique 1",
      "title": {
        "fr": "La chambre"
      },
      "paragraphs": [
        {
          "id": "lesson-10-p1",
          "hanzi": "我在家整理房间。桌子上有一本书，椅子在桌子旁边。",
          "pinyin": "wǒ zài jiā zhěng lǐ fáng jiān。 zhuō zi shàng yǒu yī běn shū， yǐ zi zài zhuō zi páng biān。",
          "translation": {
            "fr": "Je range la chambre à la maison. Il y a un livre sur la table et la chaise est à côté."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-10-p2",
          "hanzi": "我在家整理房间，因为老师要这本书。",
          "pinyin": "wǒ zài jiā zhěng lǐ fáng jiān， yīn wèi lǎo shī yào zhè běn shū。",
          "translation": {
            "fr": "Je range la chambre à la maison parce que le professeur veut ce livre."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l10-reading"
      ],
      "kind": "reading",
      "metadata": {
