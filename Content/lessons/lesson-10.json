    {
      "id": "block-lesson-10-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "星期一有汉语。我的书在哪？",
          "pinyin": "xīng qī yī yǒu hàn yǔ. wǒ de shū zài nǎ?",
          "translation": {
            "fr": "Lundi, on a cours de chinois. Où est mon livre ?"
          },
          "audio": {
            "id": "audio-7415f56abdff62d15d374cb6",
            "kind": "audio",
            "relativePath": "assets/audio/7415f56abdff62d15d374cb6.m4a",
            "sha256": "229604e8a11825a5ae29784af9c75450781b9e9b112e17589d45d33cd549d11a",
            "durationMilliseconds": 3636
          }
        },
        {
          "speaker": "Tao",
          "hanzi": "书在这，电脑也在这。",
          "pinyin": "shū zài zhè, diàn nǎo yě zài zhè.",
          "translation": {
            "fr": "Le livre est là, et l’ordinateur aussi."
          },
          "audio": {
            "id": "audio-f9b140f06424cbf7cde8e453",
            "kind": "audio",
            "relativePath": "assets/audio/f9b140f06424cbf7cde8e453.m4a",
            "sha256": "fc4a175af32f14079d7835b29d7b2cd16d9f9f67cc650b4df8b36c54604bea11",
            "durationMilliseconds": 2157
          }
        },
        {
          "speaker": "Mina",
          "hanzi": "这不是我的书，是老师的书。",
          "pinyin": "zhè bú shì wǒ de shū, shì lǎo shī de shū.",
          "translation": {
            "fr": "Ce n’est pas mon livre, c’est celui du professeur."
          },
          "audio": {
            "id": "audio-0f0f64295402f872c3350d8c",
            "kind": "audio",
            "relativePath": "assets/audio/0f0f64295402f872c3350d8c.m4a",
            "sha256": "31505952f274aab6dea866094195c0f252c3ab48c3c6c660bb4fe9f6ddd5c551",
            "durationMilliseconds": 2896
          }
        },
        {
          "speaker": "Tao",
          "hanzi": "对不起！你的书是红的吗？",
          "pinyin": "duì bù qǐ! nǐ de shū shì hóng de ma?",
          "translation": {
            "fr": "Pardon ! Le tien, c’est le rouge ?"
          },
          "audio": {
            "id": "audio-8213a61cd447fbe15633d36e",
            "kind": "audio",
            "relativePath": "assets/audio/8213a61cd447fbe15633d36e.m4a",
            "sha256": "170dd5cc1909d7086a3dbcbd6d131e9099d459e7488675ee7e1f33c2d573a08f",
            "durationMilliseconds": 2788
          }
        },
        {
          "speaker": "Mina",
          "hanzi": "不是，是绿的。红的是妈妈的书。",
          "pinyin": "bú shì, shì lǜ de. hóng de shì mā ma de shū.",
          "translation": {
            "fr": "Non, c’est le vert. Le rouge, c’est le livre de maman."
          },
          "audio": {
            "id": "audio-3c16368e8b9082912a0b1b11",
            "kind": "audio",
            "relativePath": "assets/audio/3c16368e8b9082912a0b1b11.m4a",
            "sha256": "97e3640a4356b1af4a018cc78a58ec282550f9723d1200da69dec96dc5a8dde3",
            "durationMilliseconds": 3728
          }
        },
        {
          "speaker": "Tao",
          "hanzi": "你妈妈也有汉语书吗？",
          "pinyin": "nǐ mā ma yě yǒu hàn yǔ shū ma?",
          "translation": {
            "fr": "Ta mère a aussi un livre de chinois ?"
          },
          "audio": {
            "id": "audio-78a46fb345ad3d2b7d83f127",
            "kind": "audio",
            "relativePath": "assets/audio/78a46fb345ad3d2b7d83f127.m4a",
            "sha256": "841f15b3c24a88d298e3e1c6c1470d97a27b636dc3894dd6e670695dc42c0d38",
            "durationMilliseconds": 2062
          }
        },
        {
          "speaker": "Mina",
          "hanzi": "有，妈妈也是学生。",
          "pinyin": "yǒu, mā ma yě shì xué shēng.",
          "translation": {
            "fr": "Oui, maman est étudiante aussi."
          },
          "audio": {
            "id": "audio-50698651d11f8458e5da8916",
            "kind": "audio",
            "relativePath": "assets/audio/50698651d11f8458e5da8916.m4a",
            "sha256": "a046c349a45eda834d4ee7da01e08da1a848812f915a2b608c00585a1dfc6873",
            "durationMilliseconds": 2137
          }
        },
        {
          "speaker": "Tao",
          "hanzi": "绿的在这！",
          "pinyin": "lǜ de zài zhè!",
          "translation": {
            "fr": "Le vert, il est là !"
          },
          "audio": {
            "id": "audio-cbb3488675a706d8b6857fd7",
            "kind": "audio",
            "relativePath": "assets/audio/cbb3488675a706d8b6857fd7.m4a",
            "sha256": "dc1ec38495eed4920bea29f54e36c632c19feaf36c762c4a01d1af976ee79810",
            "durationMilliseconds": 1150
          }
        },
        {
          "speaker": "Mina",
          "hanzi": "谢谢！书和电脑都有了！",
          "pinyin": "xiè xie! shū hé diàn nǎo dōu yǒu le!",
          "translation": {
            "fr": "Merci ! J’ai mon livre et mon ordinateur."
          },
          "audio": {
            "id": "audio-c25627f46dbaae27c78e3432",
            "kind": "audio",
            "relativePath": "assets/audio/c25627f46dbaae27c78e3432.m4a",
            "sha256": "ddb56379b1ec7a7c592ee087f508fdb95339a01510f040d34a1740fa8ef74354",
            "durationMilliseconds": 3109
          }
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 6
      }
    },
    {
      "id": "block-lesson-10-reading",
      "storyID": "story-lesson-10",
      "level": "HSK classique 1",
      "title": {
        "fr": "Mon livre vert"
      },
      "paragraphs": [
        {
          "id": "lesson-10-p1",
          "hanzi": "星期一有汉语，我有书，也有电脑。我的书是绿的，妈妈的书是红的。",
          "pinyin": "xīng qī yī yǒu hàn yǔ, wǒ yǒu shū, yě yǒu diàn nǎo. wǒ de shū shì lǜ de, mā ma de shū shì hóng de.",
          "translation": {
            "fr": "Lundi, j’ai cours de chinois ; j’ai mon livre et aussi mon ordinateur. Mon livre est vert, celui de maman est rouge."
          },
          "segmentation": [],
          "audio": {
            "id": "audio-f26ba3c07b2173a8ceec5591",
            "kind": "audio",
            "relativePath": "assets/audio/f26ba3c07b2173a8ceec5591.m4a",
            "sha256": "a6d3e002e72e43cbf900d70b72a96a1516eb8c56611294718e004f2dff5db466",
            "durationMilliseconds": 7131
          }
        },
        {
          "id": "lesson-10-p2",
          "hanzi": "妈妈星期一也有汉语。妈妈的书在家，不在这。",
          "pinyin": "mā ma xīng qī yī yě yǒu hàn yǔ. mā ma de shū zài jiā, bú zài zhè.",
          "translation": {
            "fr": "Maman a aussi cours de chinois le lundi. Son livre est à la maison, pas ici."
          },
          "segmentation": [],
          "audio": {
            "id": "audio-ba604177735eaa4626131738",
            "kind": "audio",
            "relativePath": "assets/audio/ba604177735eaa4626131738.m4a",
            "sha256": "6da50e30f5e6f09ff7acee421d924e7e33f779f24c81590a3738a4d62c6967b8",
            "durationMilliseconds": 5391
          }
        }
      ],
