    {
      "id": "block-lesson-27-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "欢迎，欢迎！请坐。",
          "pinyin": "huān yíng, huān yíng! qǐng zuò.",
          "translation": {
            "fr": "Bienvenue, bienvenue ! Assieds-toi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "谢谢！你家很大，我没来过。",
          "pinyin": "xiè xie! nǐ jiā hěn dà, wǒ méi lái guo.",
          "translation": {
            "fr": "Merci ! Ta maison est grande, je n’étais jamais venue."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你喝茶吗？这个杯子是我姐姐的。",
          "pinyin": "nǐ hē chá ma? zhè ge bēi zi shì wǒ jiě jie de.",
          "translation": {
            "fr": "Tu bois du thé ? Cette tasse est celle de ma sœur."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "喝，谢谢！这个红杯子很大。",
          "pinyin": "hē, xiè xie! zhè ge hóng bēi zi hěn dà.",
          "translation": {
            "fr": "Oui, merci ! Cette tasse rouge est très grande."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我姐姐的杯子都很大。菜在桌子上，请吃！",
          "pinyin": "wǒ jiě jie de bēi zi dōu hěn dà. cài zài zhuō zi shàng, qǐng chī!",
          "translation": {
            "fr": "Les tasses de ma sœur sont toutes grandes. Le repas est sur la table, mange !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这个菜是你做的吗？",
          "pinyin": "zhè ge cài shì nǐ zuò de ma?",
          "translation": {
            "fr": "C’est toi qui as préparé ce plat ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是！我做了鱼和菜，不多，请吃。",
          "pinyin": "shì! wǒ zuò le yú hé cài, bù duō, qǐng chī.",
          "translation": {
            "fr": "Oui ! J’ai fait du poisson et des légumes, ce n’est pas beaucoup, mais mange."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "不多？太多了！谢谢你的欢迎。",
          "pinyin": "bù duō? tài duō le! xiè xie nǐ de huān yíng.",
          "translation": {
            "fr": "Pas beaucoup ? C’est énorme ! Merci pour ton accueil."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不客气！你是我的朋友。",
          "pinyin": "bú kè qi! nǐ shì wǒ de péng you.",
          "translation": {
            "fr": "De rien ! Tu es mon amie."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 23
      }
    },
    {
      "id": "block-lesson-27-reading",
      "storyID": "story-lesson-27",
      "level": "HSK classique 1",
      "title": {
        "fr": "Chez mon ami"
      },
      "paragraphs": [
        {
          "id": "lesson-27-p1",
          "hanzi": "今天我去朋友家。他家很大，桌子上有一个红杯子。",
          "pinyin": "jīn tiān wǒ qù péng you jiā. tā jiā hěn dà, zhuō zi shàng yǒu yī gè hóng bēi zi.",
          "translation": {
            "fr": "Aujourd’hui je vais chez un ami. Sa maison est grande et il y a une tasse rouge sur la table."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-27-p2",
          "hanzi": "他欢迎我，请我喝茶。菜很多，我也吃了很多。",
          "pinyin": "tā huān yíng wǒ, qǐng wǒ hē chá. cài hěn duō, wǒ yě chī le hěn duō.",
          "translation": {
            "fr": "Il m’accueille et m’invite à boire du thé. Il y a beaucoup de plats, et j’en ai beaucoup mangé."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l27-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 23
      }
    },
