    {
      "id": "block-lesson-27-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "欢迎你来我家！",
          "pinyin": "huān yíng nǐ lái wǒ jiā！",
          "translation": {
            "fr": "Bienvenue chez moi !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "谢谢。这个菜好吃吗？",
          "pinyin": "xiè xiè。 zhè ge cài hǎo chī ma？",
          "translation": {
            "fr": "Merci. Ce plat est-il bon ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "非常好吃，但是有一点辣。",
          "pinyin": "fēi cháng hǎo chī， dàn shì yǒu yì diǎn là。",
          "translation": {
            "fr": "Il est très bon, mais un peu épicé."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我吃了两公斤？",
          "pinyin": "wǒ chī le liǎng gōng jīn？",
          "translation": {
            "fr": "J’en ai mangé deux kilos ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "不，只有一点。你给客人红茶吧。",
          "pinyin": "bù， zhǐ yǒu yì diǎn。 nǐ gěi kè rén hóng chá ba。",
          "translation": {
            "fr": "Non, seulement un peu. Donne plutôt du thé rouge à l’invité."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，我告诉他黑色的杯子在哪里。",
          "pinyin": "hǎo， wǒ gào sù tā hēi sè de bēi zi zài nǎ lǐ。",
          "translation": {
            "fr": "D’accord, je lui dis où est la tasse noire."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 23
      }
    },
    {
      "id": "block-lesson-27-reading",
      "storyID": "story-lesson-27",
      "level": "HSK classique 2",
      "title": {
        "fr": "Chez un ami"
      },
      "paragraphs": [
        {
          "id": "lesson-27-p1",
          "hanzi": "朋友欢迎客人到家里，桌子上有好吃的菜和红茶。",
          "pinyin": "péng yǒu huān yíng kè rén dào jiā lǐ， zhuō zi shàng yǒu hǎo chī de cài hé hóng chá。",
          "translation": {
            "fr": "Un ami accueille un invité chez lui ; il y a de bons plats et du thé rouge sur la table."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-27-p2",
          "hanzi": "菜非常好吃，但是客人只吃了一点。他用黑色的杯子喝茶。",
          "pinyin": "cài fēi cháng hǎo chī， dàn shì kè rén zhǐ chī le yì diǎn。 tā yòng hēi sè de bēi zi hē chá。",
          "translation": {
            "fr": "Les plats sont très bons, mais l’invité n’en mange qu’un peu. Il boit le thé dans une tasse noire."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l27-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 23
      }
    },
