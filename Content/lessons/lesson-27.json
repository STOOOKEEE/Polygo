  "blocks": [
    {
      "kind": "introduction",
      "id": "block-lesson-27-grammar-01",
      "title": {
        "fr": "Grammaire — 虽然…但是…"
      },
      "body": {
        "fr": "虽然 introduit une concession suivie de 但是.\nExemple 1 : 虽然很累，但是我欢迎客人。\nsuī rán hěn lèi， dàn shì wǒ huān yíng kè rén。\nMême si je suis fatigué, j’accueille l’invité."
      },
      "metadata": {
        "stage": "introduce",
        "skill": "recognition",
        "lessonDay": 23
      }
    },
