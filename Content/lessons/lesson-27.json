    {
      "id": "block-lesson-27-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "欢迎，欢迎！请坐。",
          "pinyin": "huān yíng, huān yíng! qǐng zuò.",
          "translation": {
            "fr": "Bienvenue, bienvenue ! Assieds-toi."
          },
          "audio": {
            "id": "audio-1c961e7d64d17badcb976204",
            "kind": "audio",
            "relativePath": "assets/audio/1c961e7d64d17badcb976204.m4a",
            "sha256": "deee50317d130392b0f14e6175343fae1dbe8526a7ad57d49ebe27a57c860ef2",
            "durationMilliseconds": 2291
          }
        },
        {
          "speaker": "Mina",
          "hanzi": "谢谢！你家很大，我没来过。",
          "pinyin": "xiè xie! nǐ jiā hěn dà, wǒ méi lái guo.",
          "translation": {
            "fr": "Merci ! Ta maison est grande, je n’étais jamais venue."
          },
          "audio": {
            "id": "audio-252461efd319a3eb881e1f82",
            "kind": "audio",
            "relativePath": "assets/audio/252461efd319a3eb881e1f82.m4a",
            "sha256": "108430fcc5dcb415df9885ed8ac270db5f81c4f618087c4283ee848ebcc86860",
            "durationMilliseconds": 3277
          }
        },
        {
          "speaker": "Tao",
          "hanzi": "你喝茶吗？这个杯子是我姐姐的。",
          "pinyin": "nǐ hē chá ma? zhè ge bēi zi shì wǒ jiě jie de.",
          "translation": {
            "fr": "Tu bois du thé ? Cette tasse est celle de ma sœur."
          },
          "audio": {
            "id": "audio-8f47f9a1520e716b0a7eef7a",
            "kind": "audio",
            "relativePath": "assets/audio/8f47f9a1520e716b0a7eef7a.m4a",
            "sha256": "87bf5ff6c1d97bf3295f228e7dcf344e61e3b9bc92fea507c19d71eab4cf377a",
            "durationMilliseconds": 3483
          }
        },
        {
          "speaker": "Mina",
          "hanzi": "喝，谢谢！这个红杯子很大。",
          "pinyin": "hē, xiè xie! zhè ge hóng bēi zi hěn dà.",
          "translation": {
            "fr": "Oui, merci ! Cette tasse rouge est très grande."
          },
          "audio": {
            "id": "audio-5b758e762fe794a6f40d2ec6",
            "kind": "audio",
            "relativePath": "assets/audio/5b758e762fe794a6f40d2ec6.m4a",
            "sha256": "fd9d7176ac0c09557b387807d76eb904ed2475ccd23d0669307ef0a81a36bd32",
            "durationMilliseconds": 3672
          }
        },
        {
          "speaker": "Tao",
          "hanzi": "我姐姐的杯子都很大。菜在桌子上，请吃！",
          "pinyin": "wǒ jiě jie de bēi zi dōu hěn dà. cài zài zhuō zi shàng, qǐng chī!",
          "translation": {
            "fr": "Les tasses de ma sœur sont toutes grandes. Le repas est sur la table, mange !"
          },
          "audio": {
            "id": "audio-b4575f074065c6cbc5420031",
            "kind": "audio",
            "relativePath": "assets/audio/b4575f074065c6cbc5420031.m4a",
            "sha256": "8af59cbffb802492c452bc56de0d44f7494c69e70a77d07923060bb7d1b0f47c",
            "durationMilliseconds": 4404
          }
        },
        {
          "speaker": "Mina",
          "hanzi": "这个菜是你做的吗？",
          "pinyin": "zhè ge cài shì nǐ zuò de ma?",
          "translation": {
            "fr": "C’est toi qui as préparé ce plat ?"
          },
          "audio": {
            "id": "audio-ec08282151abaf1167b782b9",
            "kind": "audio",
            "relativePath": "assets/audio/ec08282151abaf1167b782b9.m4a",
            "sha256": "44c8ede9c4049c28f99ce8c3c81b25c0c3100b6cd070ecd01c7c78635cca29e2",
            "durationMilliseconds": 1976
          }
        },
        {
          "speaker": "Tao",
          "hanzi": "是！我做了鱼和菜，不多，请吃。",
          "pinyin": "shì! wǒ zuò le yú hé cài, bù duō, qǐng chī.",
          "translation": {
            "fr": "Oui ! J’ai fait du poisson et des légumes, ce n’est pas beaucoup, mais mange."
          },
          "audio": {
            "id": "audio-924cdfd28e9471253407b2c6",
            "kind": "audio",
            "relativePath": "assets/audio/924cdfd28e9471253407b2c6.m4a",
            "sha256": "8818837a650e5b92dd2e9e00ff4e9eb6214cf199dfdff1566d171fb66e28e5fb",
            "durationMilliseconds": 3340
          }
        },
        {
          "speaker": "Mina",
          "hanzi": "不多？太多了！谢谢你的欢迎。",
          "pinyin": "bù duō? tài duō le! xiè xie nǐ de huān yíng.",
          "translation": {
            "fr": "Pas beaucoup ? C’est énorme ! Merci pour ton accueil."
          },
          "audio": {
            "id": "audio-ee3fd12df48149b295eaa5d4",
            "kind": "audio",
            "relativePath": "assets/audio/ee3fd12df48149b295eaa5d4.m4a",
            "sha256": "6e941dcdd0a0a2913d0ce150f653754cc6d20cc172435cd633ccaaef67eb848a",
            "durationMilliseconds": 4170
          }
        },
        {
          "speaker": "Tao",
          "hanzi": "不客气！你是我的朋友。",
          "pinyin": "bú kè qi! nǐ shì wǒ de péng you.",
          "translation": {
            "fr": "De rien ! Tu es mon amie."
          },
          "audio": {
            "id": "audio-604e283b844833c76dbd632c",
            "kind": "audio",
            "relativePath": "assets/audio/604e283b844833c76dbd632c.m4a",
            "sha256": "d4f041f76bc041a6bade7d7c32d1a2ac437115788739895dd6b6546738e27b92",
            "durationMilliseconds": 2539
          }
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 23
      }
    },
    {
      "id": "block-lesson-27-reading",
      "storyID": "story-lesson-27",
      "level": "HSK classique 1",
      "title": {
        "fr": "Chez mon ami"
      },
      "paragraphs": [
        {
          "id": "lesson-27-p1",
          "hanzi": "今天我去朋友家。他家很大，桌子上有一个红杯子。",
          "pinyin": "jīn tiān wǒ qù péng you jiā. tā jiā hěn dà, zhuō zi shàng yǒu yī gè hóng bēi zi.",
          "translation": {
            "fr": "Aujourd’hui je vais chez un ami. Sa maison est grande et il y a une tasse rouge sur la table."
          },
          "segmentation": [],
          "audio": {
            "id": "audio-f6185c1310b3d1dc9f1f30a2",
            "kind": "audio",
            "relativePath": "assets/audio/f6185c1310b3d1dc9f1f30a2.m4a",
            "sha256": "74a67202303a13af29a748c309fc21687eda62b9cd816a3de191b9aa25740633",
            "durationMilliseconds": 5732
          }
        },
        {
          "id": "lesson-27-p2",
          "hanzi": "他欢迎我，请我喝茶。菜很多，我也吃了很多。",
          "pinyin": "tā huān yíng wǒ, qǐng wǒ hē chá. cài hěn duō, wǒ yě chī le hěn duō.",
          "translation": {
            "fr": "Il m’accueille et m’invite à boire du thé. Il y a beaucoup de plats, et j’en ai beaucoup mangé."
          },
          "segmentation": [],
          "audio": {
            "id": "audio-9483c9d57eef656443a88d35",
            "kind": "audio",
            "relativePath": "assets/audio/9483c9d57eef656443a88d35.m4a",
            "sha256": "6e3b3c9bb2d16ae030765578cd1fbdb1c50bd167c34719ec6dd1eb7ed188b7ef",
            "durationMilliseconds": 5037
          }
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l27-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
