  "blocks": [
    {
      "kind": "introduction",
      "id": "block-lesson-40-grammar-01",
      "title": {
        "fr": "Grammaire — 比较 + adjectif"
      },
      "body": {
        "fr": "比较 se place avant un adjectif pour atténuer la description : le problème est assez important.\nExemple 1 : 这个问题比较大。\nzhè ge wèn tí bǐ jiào dà。\nCe problème est assez important."
      },
      "metadata": {
        "stage": "introduce",
        "skill": "recognition",
        "lessonDay": 36
      }
    },
