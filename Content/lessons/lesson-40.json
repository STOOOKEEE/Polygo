    {
      "id": "block-lesson-40-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "我的电视不能开了！现在怎么做？",
          "pinyin": "wǒ de diàn shì bù néng kāi le! xiàn zài zěn me zuò?",
          "translation": {
            "fr": "Ma télé ne s’allume plus ! Qu’est-ce que je fais maintenant ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你的电视几岁了？",
          "pinyin": "nǐ de diàn shì jǐ suì le?",
          "translation": {
            "fr": "Elle a quel âge, ta télé ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "五岁了。昨天我的杯子在电视旁边，水在电视上。",
          "pinyin": "wǔ suì le. zuó tiān wǒ de bēi zi zài diàn shì páng biān, shuǐ zài diàn shì shàng.",
          "translation": {
            "fr": "Cinq ans. Hier, mon verre était à côté de la télé, et l’eau s’est renversée dessus."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "水太多了，现在不能开。",
          "pinyin": "shuǐ tài duō le, xiàn zài bù néng kāi.",
          "translation": {
            "fr": "Il y a trop d’eau, on ne peut pas l’allumer maintenant."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我们买一个大电视，好吗？",
          "pinyin": "wǒ men mǎi yí gè dà diàn shì, hǎo ma?",
          "translation": {
            "fr": "On en achète une grande, d’accord ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "大电视不便宜。",
          "pinyin": "dà diàn shì bù pián yi.",
          "translation": {
            "fr": "Les grandes télés ne sont pas bon marché."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那小电视呢？",
          "pinyin": "nà xiǎo diàn shì ne?",
          "translation": {
            "fr": "Et une petite, alors ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "小电视便宜，你的家不大，我们买小的。",
          "pinyin": "xiǎo diàn shì pián yi, nǐ de jiā bù dà, wǒ men mǎi xiǎo de.",
          "translation": {
            "fr": "Les petites sont moins chères et ton appartement n’est pas grand : on en prend une petite."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好，明天去商店看看。",
          "pinyin": "hǎo, míng tiān qù shāng diàn kàn kàn.",
          "translation": {
            "fr": "D’accord, demain on va la voir au magasin."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好！明天上午我们去。",
          "pinyin": "hǎo! míng tiān shàng wǔ wǒ men qù.",
          "translation": {
            "fr": "Oui ! Demain matin, on y va."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 36
      }
    },
    {
      "id": "block-lesson-40-reading",
      "storyID": "story-lesson-40",
      "level": "HSK classique 1",
      "title": {
        "fr": "Une télé de cinq ans"
      },
      "paragraphs": [
        {
          "id": "lesson-40-p1",
          "hanzi": "我的电视五岁了，昨天不能开了。杯子里的水在电视上。",
          "pinyin": "wǒ de diàn shì wǔ suì le, zuó tiān bù néng kāi le. bēi zi lǐ de shuǐ zài diàn shì shàng.",
          "translation": {
            "fr": "Ma télé a cinq ans et hier elle ne s’allumait plus. L’eau de mon verre s’était renversée dessus."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-40-p2",
          "hanzi": "大电视不便宜，小电视便宜。我们去商店看了电视，我买了小的。",
          "pinyin": "dà diàn shì bù pián yi, xiǎo diàn shì pián yi. wǒ men qù shāng diàn kàn le diàn shì, wǒ mǎi le xiǎo de.",
          "translation": {
            "fr": "Les grandes télés ne sont pas bon marché, les petites le sont. Nous sommes allés voir des télés au magasin, et j’ai acheté une petite."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l40-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 36
      }
    },
