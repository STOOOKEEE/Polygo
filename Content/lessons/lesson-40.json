    {
      "id": "block-lesson-40-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "啊，电脑怎么了？",
          "pinyin": "a， diàn nǎo zěn me le？",
          "translation": {
            "fr": "Ah, qu’est-ce qui arrive à l’ordinateur ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "它不能打开，问题比较大。",
          "pinyin": "tā bù néng dǎ kāi， wèn tí bǐ jiào dà。",
          "translation": {
            "fr": "Il ne peut pas s’ouvrir ; le problème est assez important."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我们有什么办法？",
          "pinyin": "wǒ men yǒu shén me bàn fǎ？",
          "translation": {
            "fr": "Quelle solution avons-nous ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我把电脑拿给经理，他会帮助我们。",
          "pinyin": "wǒ bǎ diàn nǎo ná gěi jīng lǐ， tā huì bāng zhù wǒ men。",
          "translation": {
            "fr": "Je donne l’ordinateur au manager ; il nous aidera."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "它是被谁关上的？",
          "pinyin": "tā shì bèi shuí guān shàng de？",
          "translation": {
            "fr": "Par qui a-t-il été fermé ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不知道。现在我认真地检查它。",
          "pinyin": "bù zhī dào。 xiàn zài wǒ rèn zhēn dì jiǎn chá tā。",
          "translation": {
            "fr": "Je ne sais pas. Maintenant je le vérifie attentivement."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 36
      }
    },
    {
      "id": "block-lesson-40-reading",
      "storyID": "story-lesson-40",
      "level": "HSK classique 3",
      "title": {
        "fr": "Un ordinateur bloqué"
      },
      "paragraphs": [
        {
          "id": "lesson-40-p1",
          "hanzi": "电脑不能打开，员工觉得问题比较大，但是经理有办法。",
          "pinyin": "diàn nǎo bù néng dǎ kāi， yuán gōng jué de wèn tí bǐ jiào dà， dàn shì jīng lǐ yǒu bàn fǎ。",
          "translation": {
            "fr": "L’ordinateur ne peut pas s’ouvrir. L’employé trouve le problème assez important, mais le manager a une solution."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-40-p2",
          "hanzi": "员工把电脑给经理，经理认真地检查。电脑被他打开以后，大家都笑了。",
          "pinyin": "yuán gōng bǎ diàn nǎo gěi jīng lǐ， jīng lǐ rèn zhēn dì jiǎn chá。 diàn nǎo bèi tā dǎ kāi yǐ hòu， dà jiā dōu xiào le。",
          "translation": {
            "fr": "L’employé donne l’ordinateur au manager, qui l’examine attentivement. Après que l’ordinateur est ouvert, tout le monde sourit."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l40-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 36
      }
    },
