    {
      "id": "block-lesson-72-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你在树下看见什么？",
          "pinyin": "nǐ zài shù xià kàn jiàn shén me?",
          "translation": {
            "fr": "Qu’as-tu vu sous l’arbre ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "一只鸟。秋天这里很安静。",
          "pinyin": "yì zhī niǎo. qiū tiān zhè lǐ hěn ān jìng.",
          "translation": {
            "fr": "Un oiseau. Ici, c’est très calme en automne."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "如果下雨，你有伞吗？",
          "pinyin": "rú guǒ xià yǔ, nǐ yǒu sǎn ma?",
          "translation": {
            "fr": "S’il pleut, as-tu un parapluie ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有。我们等一会儿，雨停了再走。",
          "pinyin": "yǒu. wǒ men děng yí huìr, yǔ tíng le zài zǒu.",
          "translation": {
            "fr": "Oui. Attendons un moment et partons quand la pluie s’arrêtera."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 68
      }
    },
    {
      "id": "block-lesson-72-reading",
      "storyID": "story-lesson-72",
      "level": "HSK classique 3",
      "title": {
        "fr": "Attendre sous un arbre"
      },
      "paragraphs": [
        {
          "id": "lesson-72-p1",
          "hanzi": "秋天的公园很安静，Tao在树下发现一只鸟。",
          "pinyin": "qiū tiān de gōng yuán hěn ān jìng, Tao zài shù xià fā xiàn yì zhī niǎo.",
          "translation": {
            "fr": "Le parc est très calme en automne ; Tao découvre un oiseau sous un arbre."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-72-p2",
          "hanzi": "雨来了，他打开伞，等了一会儿再回家。",
          "pinyin": "yǔ lái le, tā dǎ kāi sǎn, děng le yí huìr zài huí jiā.",
          "translation": {
            "fr": "La pluie arrive ; il ouvre son parapluie, attend un moment puis rentre chez lui."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l72-reading"
      ],
      "kind": "reading",
