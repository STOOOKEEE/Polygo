    {
      "id": "block-lesson-41-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "宾馆在哪里？",
          "pinyin": "bīn guǎn zài nǎ lǐ？",
          "translation": {
            "fr": "Où est l’hôtel ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "在地铁站旁边。你有地图吗？",
          "pinyin": "zài dì tiě zhàn páng biān。 nǐ yǒu dì tú ma？",
          "translation": {
            "fr": "À côté de la station de métro. As-tu une carte ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "有。我从这条街走过去。",
          "pinyin": "yǒu。 wǒ cóng zhè tiáo jiē zǒu guò qù。",
          "translation": {
            "fr": "Oui. Je vais marcher depuis cette rue."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "请把护照给司机看。",
          "pinyin": "qǐng bǎ hù zhào gěi sī jī kàn。",
          "translation": {
            "fr": "Montre ton passeport au chauffeur, s’il te plaît."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "司机知道去宾馆的路吗？",
          "pinyin": "sī jī zhī dào qù bīn guǎn de lù ma？",
          "translation": {
            "fr": "Le chauffeur connaît-il le chemin de l’hôtel ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "知道，他马上带我们到。",
          "pinyin": "zhī dào， tā mǎ shàng dài wǒ men dào。",
          "translation": {
            "fr": "Oui, il va nous y conduire tout de suite."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 37
      }
    },
    {
      "id": "block-lesson-41-reading",
      "storyID": "story-lesson-41",
      "level": "HSK classique 3",
      "title": {
        "fr": "La carte"
      },
      "paragraphs": [
        {
          "id": "lesson-41-p1",
          "hanzi": "游客看地图，发现宾馆在地铁站旁边，从这条街走十分钟就到。",
          "pinyin": "yóu kè kàn dì tú， fā xiàn bīn guǎn zài dì tiě zhàn páng biān， cóng zhè tiáo jiē zǒu shí fēn zhōng jiù dào。",
          "translation": {
            "fr": "Le visiteur regarde la carte et découvre que l’hôtel est à côté du métro, à dix minutes à pied de cette rue."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-41-p2",
          "hanzi": "司机检查他的护照，然后带他到宾馆。",
          "pinyin": "sī jī jiǎn chá tā de hù zhào， rán hòu dài tā dào bīn guǎn。",
          "translation": {
            "fr": "Le chauffeur vérifie son passeport puis le conduit à l’hôtel."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l41-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 37
      }
    },
