    {
      "id": "block-lesson-41-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "喂，你好！我在火车站了。",
          "pinyin": "wèi, nǐ hǎo! wǒ zài huǒ chē zhàn le.",
          "translation": {
            "fr": "Allô, salut ! Je suis à la gare."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你好！你的东西多吗？",
          "pinyin": "nǐ hǎo! nǐ de dōng xī duō ma?",
          "translation": {
            "fr": "Salut ! Tu as beaucoup d’affaires ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "不多，一个大的，一个小的。",
          "pinyin": "bù duō, yí gè dà de, yí gè xiǎo de.",
          "translation": {
            "fr": "Pas beaucoup : une grande valise et une petite."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你坐出租车来我家。我家在商店旁边。",
          "pinyin": "nǐ zuò chū zū chē lái wǒ jiā. wǒ jiā zài shāng diàn páng biān.",
          "translation": {
            "fr": "Prends un taxi pour venir chez moi. J’habite à côté du magasin."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好的，我坐出租车。再见！",
          "pinyin": "hǎo de, wǒ zuò chū zū chē. zài jiàn!",
          "translation": {
            "fr": "D’accord, je prends un taxi. À tout à l’heure !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "先生，你好！我要去商店旁边。",
          "pinyin": "xiān sheng, nǐ hǎo! wǒ yào qù shāng diàn páng biān.",
          "translation": {
            "fr": "Bonjour monsieur ! Je voudrais aller à côté du magasin."
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "好！从这里去，六分钟。",
          "pinyin": "hǎo! cóng zhè lǐ qù, liù fēn zhōng.",
          "translation": {
            "fr": "D’accord ! D’ici, il y a six minutes."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "太好了！我爱北京！",
          "pinyin": "tài hǎo le! wǒ ài běi jīng!",
          "translation": {
            "fr": "Super ! J’adore Pékin !"
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "你是法国人吗？你的汉语很好。",
          "pinyin": "nǐ shì fǎ guó rén ma? nǐ de hàn yǔ hěn hǎo.",
          "translation": {
            "fr": "Vous êtes française ? Votre chinois est très bon."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我是法国人。我爱北京，也爱汉语。",
          "pinyin": "wǒ shì fǎ guó rén. wǒ ài běi jīng, yě ài hàn yǔ.",
          "translation": {
            "fr": "Oui, je suis française. J’aime Pékin, et j’aime aussi le chinois."
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "欢迎你来北京！你看，你的朋友在那里！",
          "pinyin": "huān yíng nǐ lái běi jīng! nǐ kàn, nǐ de péng yǒu zài nà lǐ!",
          "translation": {
            "fr": "Bienvenue à Pékin ! Regardez, votre ami est là-bas !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 37
      }
    },
    {
      "id": "block-lesson-41-reading",
      "storyID": "story-lesson-41",
      "level": "HSK classique 1",
      "title": {
        "fr": "Un taxi à Pékin"
      },
      "paragraphs": [
        {
          "id": "lesson-41-p1",
          "hanzi": "今天我来北京了。我的东西不多，我坐出租车去朋友家。",
          "pinyin": "jīn tiān wǒ lái běi jīng le. wǒ de dōng xī bù duō, wǒ zuò chū zū chē qù péng yǒu jiā.",
          "translation": {
            "fr": "Aujourd’hui, je suis arrivée à Pékin. Je n’ai pas beaucoup d’affaires, alors je prends un taxi pour aller chez mon ami."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-41-p2",
          "hanzi": "从火车站去，六分钟。出租车里的先生欢迎我来北京。朋友的家在商店旁边。我爱北京！",
          "pinyin": "cóng huǒ chē zhàn qù, liù fēn zhōng. chū zū chē lǐ de xiān sheng huān yíng wǒ lái běi jīng. péng yǒu de jiā zài shāng diàn páng biān. wǒ ài běi jīng!",
          "translation": {
            "fr": "De la gare, ça fait six minutes. Le chauffeur de taxi m’a souhaité la bienvenue à Pékin. La maison de mon ami est à côté du magasin. J’adore Pékin !"
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l41-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 37
      }
    },
