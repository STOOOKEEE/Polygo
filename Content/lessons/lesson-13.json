  "blocks": [
    {
      "kind": "introduction",
      "id": "block-lesson-13-grammar-01",
      "title": {
        "fr": "Grammaire — 这/那 + nom"
      },
      "body": {
        "fr": "这 désigne ce qui est proche et 那 ce qui est plus éloigné.\nExemple 1 : 这是今天的报纸。\nzhè shì jīn tiān de bào zhǐ。\nVoici le journal d’aujourd’hui."
      },
      "metadata": {
        "stage": "introduce",
        "skill": "recognition",
        "lessonDay": 9
      }
    },
