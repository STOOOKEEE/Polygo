    {
      "id": "block-lesson-13-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "明天上午你有时间吗？",
          "pinyin": "míng tiān shàng wǔ nǐ yǒu shí jiān ma？",
          "translation": {
            "fr": "Tu as du temps demain matin ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有，我们十点见。",
          "pinyin": "yǒu， wǒ men shí diǎn jiàn。",
          "translation": {
            "fr": "Oui, retrouvons-nous à dix heures."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "中午吃饭要多少分钟？",
          "pinyin": "zhōng wǔ chī fàn yào duō shǎo fēn zhōng？",
          "translation": {
            "fr": "Combien de minutes faut-il pour déjeuner à midi ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "二十分钟就够了，下午我还要上课。",
          "pinyin": "èr shí fēn zhōng jiù gòu le， xià wǔ wǒ hái yào shàng kè。",
          "translation": {
            "fr": "Vingt minutes suffisent, j’ai encore cours l’après-midi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "今天是星期几？",
          "pinyin": "jīn tiān shì xīng qī jǐ？",
          "translation": {
            "fr": "Quel jour sommes-nous ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "星期三。看完报纸我很高兴。",
          "pinyin": "xīng qī sān。 kàn wán bào zhǐ wǒ hěn gāo xìng。",
          "translation": {
            "fr": "Mercredi. Je suis content après avoir lu le journal."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 9
      }
    },
    {
      "id": "block-lesson-13-reading",
      "storyID": "story-lesson-13",
      "level": "HSK classique 2",
      "title": {
        "fr": "Le programme"
      },
      "paragraphs": [
        {
          "id": "lesson-13-p1",
          "hanzi": "明天上午十点，我和同学见面。中午我们吃饭二十分钟。",
          "pinyin": "míng tiān shàng wǔ shí diǎn， wǒ hé tóng xué jiàn miàn。 zhōng wǔ wǒ men chī fàn èr shí fēn zhōng。",
          "translation": {
            "fr": "Demain à dix heures du matin, je retrouve un camarade. À midi, nous déjeunons pendant vingt minutes."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-13-p2",
          "hanzi": "下午我去学校，晚上在家看报纸。星期三的安排让我很高兴。",
          "pinyin": "xià wǔ wǒ qù xué xiào， wǎn shàng zài jiā kàn bào zhǐ。 xīng qī sān de ān pái ràng wǒ hěn gāo xìng。",
          "translation": {
            "fr": "L’après-midi, je vais à l’école et le soir je lis le journal à la maison. Le programme du mercredi me rend heureux."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l13-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 9
      }
    },
