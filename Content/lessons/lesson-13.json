    {
      "id": "block-lesson-13-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你好，Tao！你今天去商店吗？",
          "pinyin": "nǐ hǎo, Tao! nǐ jīn tiān qù shāng diàn ma?",
          "translation": {
            "fr": "Salut, Tao ! Tu vas au magasin aujourd’hui ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "今天不去，我在家。你呢？",
          "pinyin": "jīn tiān bù qù, wǒ zài jiā. nǐ ne?",
          "translation": {
            "fr": "Pas aujourd’hui, je reste à la maison. Et toi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我也在家。明天星期三，我要去商店。你想去吗？",
          "pinyin": "wǒ yě zài jiā. míng tiān xīng qī sān, wǒ yào qù shāng diàn. nǐ xiǎng qù ma?",
          "translation": {
            "fr": "Moi aussi, je suis à la maison. Demain c’est mercredi, je vais aller au magasin. Tu veux venir ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "想！你要买什么？",
          "pinyin": "xiǎng! nǐ yào mǎi shén me?",
          "translation": {
            "fr": "Oui ! Tu vas acheter quoi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我要买牛奶和茶。你呢？",
          "pinyin": "wǒ yào mǎi niú nǎi hé chá. nǐ ne?",
          "translation": {
            "fr": "Je vais acheter du lait et du thé. Et toi ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我要买书，也要买茶。",
          "pinyin": "wǒ yào mǎi shū, yě yào mǎi chá.",
          "translation": {
            "fr": "Moi, je vais acheter des livres, et aussi du thé."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你也要买茶？我们都要买茶！",
          "pinyin": "nǐ yě yào mǎi chá? wǒ men dōu yào mǎi chá!",
          "translation": {
            "fr": "Toi aussi tu veux du thé ? On en achète tous les deux !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是！明天我来你家，我们从你家去。",
          "pinyin": "shì! míng tiān wǒ lái nǐ jiā, wǒ men cóng nǐ jiā qù.",
          "translation": {
            "fr": "Eh oui ! Demain je viens chez toi, et on part de chez toi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我家有书，你不要买。",
          "pinyin": "wǒ jiā yǒu shū, nǐ bú yào mǎi.",
          "translation": {
            "fr": "J’ai des livres à la maison, n’en achète pas."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "谢谢！明天再见！",
          "pinyin": "xiè xie! míng tiān zài jiàn!",
          "translation": {
            "fr": "Merci ! À demain !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 9
      }
    },
    {
      "id": "block-lesson-13-reading",
      "storyID": "story-lesson-13",
      "level": "HSK classique 1",
      "title": {
        "fr": "Un mot pour un ami"
      },
      "paragraphs": [
        {
          "id": "lesson-13-p1",
          "hanzi": "朋友，明天是星期三，你来我家。我们从我家去商店。我要买牛奶和茶，牛奶三块，茶也三块。今天我在家，明天再见！",
          "pinyin": "péng you, míng tiān shì xīng qī sān, nǐ lái wǒ jiā. wǒ men cóng wǒ jiā qù shāng diàn. wǒ yào mǎi niú nǎi hé chá, niú nǎi sān kuài, chá yě sān kuài. jīn tiān wǒ zài jiā, míng tiān zài jiàn!",
          "translation": {
            "fr": "Mon ami, demain c’est mercredi, viens chez moi. Nous irons au magasin depuis chez moi. Je vais acheter du lait et du thé : le lait coûte trois yuans, le thé aussi. Aujourd’hui je reste à la maison, à demain !"
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l13-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
