    {
      "id": "block-lesson-55-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "早！你早上都看报纸吗？",
          "pinyin": "zǎo! nǐ zǎo shang dōu kàn bào zhǐ ma?",
          "translation": {
            "fr": "Salut ! Tu lis le journal tous les matins ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是！今天的报纸有一个汉语题，你看看。",
          "pinyin": "shì! jīn tiān de bào zhǐ yǒu yí gè hàn yǔ tí, nǐ kàn kan.",
          "translation": {
            "fr": "Oui ! Le journal d’aujourd’hui a un exercice de chinois, regarde."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "什么题？我看看。一件衣服五十块，买两件多少钱？",
          "pinyin": "shén me tí? wǒ kàn kan. yí jiàn yī fu wǔ shí kuài, mǎi liǎng jiàn duō shǎo qián?",
          "translation": {
            "fr": "Quel exercice ? Voyons. Un vêtement coûte cinquante yuans, combien pour deux ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你会做吗？我从家到学校，都没做完。",
          "pinyin": "nǐ huì zuò ma? wǒ cóng jiā dào xué xiào, dōu méi zuò wán.",
          "translation": {
            "fr": "Tu sais le faire ? Moi, de chez moi jusqu’à l’école, je n’ai pas réussi à le finir."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "会！两件是一百块。",
          "pinyin": "huì! liǎng jiàn shì yì bǎi kuài.",
          "translation": {
            "fr": "Oui ! Deux, ça fait cent yuans."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你回答得不错！",
          "pinyin": "nǐ huí dá de bú cuò!",
          "translation": {
            "fr": "Bien répondu !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你早上吃东西了吗？",
          "pinyin": "nǐ zǎo shang chī dōng xi le ma?",
          "translation": {
            "fr": "Tu as mangé quelque chose ce matin ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "还没！我们去饭馆吧，我想吃米饭。",
          "pinyin": "hái méi! wǒ men qù fàn guǎn ba, wǒ xiǎng chī mǐ fàn.",
          "translation": {
            "fr": "Pas encore ! Allons au restaurant, j’ai envie de riz."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好，我请你！饭馆里也可以看报纸。",
          "pinyin": "hǎo, wǒ qǐng nǐ! fàn guǎn lǐ yě kě yǐ kàn bào zhǐ.",
          "translation": {
            "fr": "D’accord, je t’invite ! On pourra aussi lire le journal au restaurant."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "谢谢！我们现在就走吧。",
          "pinyin": "xiè xie! wǒ men xiàn zài jiù zǒu ba.",
          "translation": {
            "fr": "Merci ! Partons tout de suite."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 51
      }
    },
    {
      "id": "block-lesson-55-reading",
      "storyID": "story-lesson-55",
      "level": "HSK classique 2",
      "title": {
        "fr": "Seule dans la classe"
      },
      "paragraphs": [
        {
          "id": "lesson-55-p1",
          "hanzi": "早上七点我就到学校了。教室里没有人，我一个人看报纸。",
          "pinyin": "zǎo shang qī diǎn wǒ jiù dào xué xiào le. jiào shì lǐ méi yǒu rén, wǒ yí gè rén kàn bào zhǐ.",
          "translation": {
            "fr": "Je suis arrivée à l’école dès sept heures du matin. Il n’y a personne dans la classe, je lis le journal toute seule."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-55-p2",
          "hanzi": "报纸上有一个汉语题，我想了一下，就回答了。老师来了，我告诉她：我做完了！",
          "pinyin": "bào zhǐ shàng yǒu yí gè hàn yǔ tí, wǒ xiǎng le yí xià, jiù huí dá le. lǎo shī lái le, wǒ gào su tā: wǒ zuò wán le!",
          "translation": {
            "fr": "Il y a un exercice de chinois dans le journal ; je réfléchis un instant et je réponds. Le professeur arrive, et je lui dis : j’ai fini !"
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l55-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 51
      }
    },
