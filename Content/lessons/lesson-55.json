    {
      "id": "block-lesson-55-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你看电子邮件了吗？",
          "pinyin": "nǐ kàn diàn zǐ yóu jiàn le ma?",
          "translation": {
            "fr": "As-tu vu le courriel ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "看了。邮件很短，只有一段。",
          "pinyin": "kàn le. yóu jiàn hěn duǎn, zhǐ yǒu yí duàn.",
          "translation": {
            "fr": "Oui. Le courriel est court, il n’a qu’un paragraphe."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你早上从东边走来吗？",
          "pinyin": "nǐ zǎo shang cóng dōng biān zǒu lái ma?",
          "translation": {
            "fr": "Es-tu venu de l’est ce matin ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是。我一边走路，一边听音乐。",
          "pinyin": "shì. wǒ yì biān zǒu lù, yì biān tīng yīn yuè.",
          "translation": {
            "fr": "Oui. Je marche tout en écoutant de la musique."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 51
      }
    },
    {
      "id": "block-lesson-55-reading",
      "storyID": "story-lesson-55",
      "level": "HSK classique 2",
      "title": {
        "fr": "Un courriel très court"
      },
      "paragraphs": [
        {
          "id": "lesson-55-p1",
          "hanzi": "早上，Tao收到一封电子邮件。",
          "pinyin": "zǎo shang, Tao shōu dào yì fēng diàn zǐ yóu jiàn.",
          "translation": {
            "fr": "Le matin, Tao reçoit un courriel."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-55-p2",
          "hanzi": "邮件只有一段，他从东边走来时就读完了。",
          "pinyin": "yóu jiàn zhǐ yǒu yí duàn, tā cóng dōng biān zǒu lái shí jiù dú wán le.",
          "translation": {
            "fr": "Le courriel ne contient qu’un paragraphe ; il le termine en venant de l’est."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l55-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 51
      }
    },
