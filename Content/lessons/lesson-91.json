  "blocks": [
    {
      "kind": "introduction",
      "id": "block-lesson-91-grammar-01",
      "title": {
        "fr": "Grammaire — 越来越 + adjectif"
      },
      "body": {
        "fr": "越来越 décrit une évolution progressive vers un degré plus élevé.\nExemple 1 : 月亮越来越亮了。\nyuè liang yuè lái yuè liàng le.\nLa lune est devenue de plus en plus brillante."
      },
      "metadata": {
        "stage": "introduce",
        "skill": "recognition",
        "lessonDay": 87
      }
    },
