    {
      "id": "block-lesson-91-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你在车站遇到谁了？",
          "pinyin": "nǐ zài chē zhàn yù dào shuí le?",
          "translation": {
            "fr": "Qui as-tu rencontré à la gare ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "遇到一位老朋友。他愿意一起看月亮。",
          "pinyin": "yù dào yí wèi lǎo péng you. tā yuàn yì yì qǐ kàn yuè liang.",
          "translation": {
            "fr": "Un vieil ami. Il veut bien regarder la lune avec moi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "月亮越来越亮了吗？",
          "pinyin": "yuè liang yuè lái yuè liàng le ma?",
          "translation": {
            "fr": "La lune devient-elle de plus en plus brillante ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是。我们在下一站下车。",
          "pinyin": "shì. wǒ men zài xià yí zhàn xià chē.",
          "translation": {
            "fr": "Oui. Nous descendons à la prochaine station."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 87
      }
    },
    {
      "id": "block-lesson-91-reading",
      "storyID": "story-lesson-91",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une lune de plus en plus claire"
      },
      "paragraphs": [
        {
          "id": "lesson-91-p1",
          "hanzi": "Tao在车站遇到一位老朋友，两个人愿意一起散步。",
          "pinyin": "Tao zài chē zhàn yù dào yí wèi lǎo péng you, liǎng ge rén yuàn yì yì qǐ sàn bù.",
          "translation": {
            "fr": "Tao rencontre un vieil ami à la gare et ils veulent bien se promener ensemble."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-91-p2",
          "hanzi": "月亮越来越亮，他们在下一站下车看了一会儿。",
          "pinyin": "yuè liang yuè lái yuè liàng, tā men zài xià yí zhàn xià chē kàn le yí huìr.",
          "translation": {
            "fr": "La lune devient de plus en plus brillante ; ils descendent à la prochaine station pour la regarder un moment."
          },
          "segmentation": [],
          "audio": null
        }
      ],
