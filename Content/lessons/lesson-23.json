    {
      "id": "block-lesson-23-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "去年你的生日怎么样？",
          "pinyin": "qù nián nǐ de shēng rì zěn me yàng？",
          "translation": {
            "fr": "Comment était ton anniversaire l’an dernier ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "很好。今年我的生日在星期六。",
          "pinyin": "hěn hǎo。 jīn nián wǒ de shēng rì zài xīng qī liù。",
          "translation": {
            "fr": "Très bien. Cette année, mon anniversaire est samedi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "早上你先做什么？",
          "pinyin": "zǎo shàng nǐ xiān zuò shén me？",
          "translation": {
            "fr": "Que fais-tu d’abord le matin ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我先去医院看爷爷，然后回家。",
          "pinyin": "wǒ xiān qù yī yuàn kàn yé yé， rán hòu huí jiā。",
          "translation": {
            "fr": "Je vais d’abord à l’hôpital voir mon grand-père, puis je rentre."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "晚上有几个小时的时间？",
          "pinyin": "wǎn shàng yǒu jǐ gè xiǎo shí de shí jiān？",
          "translation": {
            "fr": "Combien d’heures avons-nous le soir ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有三个小时，我们一起吃饭。",
          "pinyin": "yǒu sān gè xiǎo shí， wǒ men yì qǐ chī fàn。",
          "translation": {
            "fr": "Nous avons trois heures ; nous dînerons ensemble."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 19
      }
    },
    {
      "id": "block-lesson-23-reading",
      "storyID": "story-lesson-23",
      "level": "HSK classique 2",
      "title": {
        "fr": "Le jour spécial"
      },
      "paragraphs": [
        {
          "id": "lesson-23-p1",
          "hanzi": "去年生日的时候，我先和家人吃饭，然后看电影。",
          "pinyin": "qù nián shēng rì de shí hòu， wǒ xiān hé jiā rén chī fàn， rán hòu kàn diàn yǐng。",
          "translation": {
            "fr": "Lors de mon anniversaire l’an dernier, j’ai d’abord mangé avec ma famille, puis j’ai regardé un film."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-23-p2",
          "hanzi": "今年早上我要去医院看爷爷，晚上有三个小时和朋友在一起。",
          "pinyin": "jīn nián zǎo shàng wǒ yào qù yī yuàn kàn yé yé， wǎn shàng yǒu sān gè xiǎo shí hé péng yǒu zài yì qǐ。",
          "translation": {
            "fr": "Cette année, je vais voir mon grand-père à l’hôpital le matin et j’aurai trois heures avec mes amis le soir."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l23-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 19
      }
    },
