    {
      "id": "block-lesson-23-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你姐姐的生日是几月几日？",
          "pinyin": "nǐ jiě jie de shēng rì shì jǐ yuè jǐ rì?",
          "translation": {
            "fr": "C’est quand, l’anniversaire de ta grande sœur ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是十月十四日，星期五。",
          "pinyin": "shì shí yuè shí sì rì, xīng qī wǔ.",
          "translation": {
            "fr": "Le 14 octobre, un vendredi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "星期五！你有时间吗？",
          "pinyin": "xīng qī wǔ! nǐ yǒu shí jiān ma?",
          "translation": {
            "fr": "Vendredi ! Tu as le temps ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有，星期五下午我不工作。",
          "pinyin": "yǒu, xīng qī wǔ xià wǔ wǒ bù gōng zuò.",
          "translation": {
            "fr": "Oui, je ne travaille pas vendredi après-midi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我们做什么好？",
          "pinyin": "wǒ men zuò shén me hǎo?",
          "translation": {
            "fr": "Qu’est-ce qu’on prépare ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "她想吃鱼，我们做鱼和菜，好吗？",
          "pinyin": "tā xiǎng chī yú, wǒ men zuò yú hé cài, hǎo ma?",
          "translation": {
            "fr": "Elle a envie de poisson. On fait du poisson et des légumes, d’accord ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好！我不会做鱼，你做，我买。",
          "pinyin": "hǎo! wǒ bù huì zuò yú, nǐ zuò, wǒ mǎi.",
          "translation": {
            "fr": "D’accord ! Moi, je ne sais pas cuisiner le poisson : tu le fais et moi je l’achète."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你去商店买鱼，我要在家做菜。",
          "pinyin": "nǐ qù shāng diàn mǎi yú, wǒ yào zài jiā zuò cài.",
          "translation": {
            "fr": "Va acheter le poisson au magasin, moi je cuisine à la maison."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我们吃鱼，看电影，好吗？",
          "pinyin": "wǒ men chī yú, kàn diàn yǐng, hǎo ma?",
          "translation": {
            "fr": "On mange du poisson, puis on regarde un film, ça te va ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好！我姐姐也想看电影。",
          "pinyin": "hǎo! wǒ jiě jie yě xiǎng kàn diàn yǐng.",
          "translation": {
            "fr": "Bonne idée ! Ma sœur a envie de regarder un film, elle aussi."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 19
      }
    },
    {
      "id": "block-lesson-23-reading",
      "storyID": "story-lesson-23",
      "level": "HSK classique 1",
      "title": {
        "fr": "Un vendredi de fête"
      },
      "paragraphs": [
        {
          "id": "lesson-23-p1",
          "hanzi": "星期五是我朋友姐姐的生日。她想吃鱼，也想看电影。",
          "pinyin": "xīng qī wǔ shì wǒ péng you jiě jie de shēng rì. tā xiǎng chī yú, yě xiǎng kàn diàn yǐng.",
          "translation": {
            "fr": "Vendredi, c’est l’anniversaire de la grande sœur de mon ami. Elle a envie de manger du poisson et aussi de regarder un film."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-23-p2",
          "hanzi": "我朋友在家做菜，我去商店买鱼。我们下午都有时间，这个生日会很好。",
          "pinyin": "wǒ péng you zài jiā zuò cài, wǒ qù shāng diàn mǎi yú. wǒ men xià wǔ dōu yǒu shí jiān, zhè ge shēng rì huì hěn hǎo.",
          "translation": {
            "fr": "Mon ami fait la cuisine à la maison et moi, je vais acheter du poisson au magasin. Nous avons tous le temps cet après-midi, ce sera un bel anniversaire."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l23-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 19
      }
    },
