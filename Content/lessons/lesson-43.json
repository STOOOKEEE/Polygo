    {
      "id": "block-lesson-43-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "超市旁边有商店吗？",
          "pinyin": "chāo shì páng biān yǒu shāng diàn ma？",
          "translation": {
            "fr": "Y a-t-il un magasin à côté du supermarché ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有，我先看菜单，再买礼物。",
          "pinyin": "yǒu， wǒ xiān kàn cài dān， zài mǎi lǐ wù。",
          "translation": {
            "fr": "Oui ; je regarde d’abord le menu, puis j’achète un cadeau."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这件衬衫和那条裤子多少钱？",
          "pinyin": "zhè jiàn chèn shān hé nà tiáo kù zi duō shǎo qián？",
          "translation": {
            "fr": "Combien coûtent cette chemise et ce pantalon ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "衬衫不贵，裤子比较贵。",
          "pinyin": "chèn shān bù guì， kù zi bǐ jiào guì。",
          "translation": {
            "fr": "La chemise n’est pas chère, le pantalon est assez cher."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "谁来接礼物？",
          "pinyin": "shuí lái jiē lǐ wù？",
          "translation": {
            "fr": "Qui vient recevoir le cadeau ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "朋友来接。买完以后我们回家。",
          "pinyin": "péng yǒu lái jiē。 mǎi wán yǐ hòu wǒ men huí jiā。",
          "translation": {
            "fr": "Un ami vient le recevoir. Après l’achat, nous rentrons à la maison."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 39
      }
    },
    {
      "id": "block-lesson-43-reading",
      "storyID": "story-lesson-43",
      "level": "HSK classique 3",
      "title": {
        "fr": "Le cadeau"
      },
      "paragraphs": [
        {
          "id": "lesson-43-p1",
          "hanzi": "Tao在超市旁边的商店买礼物。衬衫便宜，裤子比较贵。",
          "pinyin": "Tao zài chāo shì páng biān de shāng diàn mǎi lǐ wù。 chèn shān pián yi， kù zi bǐ jiào guì。",
          "translation": {
            "fr": "Tao achète un cadeau dans le magasin à côté du supermarché. La chemise est bon marché, le pantalon est assez cher."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-43-p2",
          "hanzi": "他先看菜单，再选择一件衬衫。朋友来接礼物，然后他们一起回家。",
          "pinyin": "tā xiān kàn cài dān， zài xuǎn zé yī jiàn chèn shān。 péng yǒu lái jiē lǐ wù， rán hòu tā men yì qǐ huí jiā。",
          "translation": {
            "fr": "Il regarde d’abord le menu puis choisit une chemise. Son ami vient recevoir le cadeau, puis ils rentrent ensemble."
          },
          "segmentation": [],
          "audio": null
        }
      ],
