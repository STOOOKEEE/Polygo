    {
      "id": "block-lesson-43-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你妈妈的生日是几月几日？",
          "pinyin": "nǐ mā ma de shēng rì shì jǐ yuè jǐ rì?",
          "translation": {
            "fr": "L’anniversaire de ta maman, c’est quel jour ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "十月九日，星期六。",
          "pinyin": "shí yuè jiǔ rì, xīng qī liù.",
          "translation": {
            "fr": "Le 9 octobre, un samedi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我们买什么送她？",
          "pinyin": "wǒ men mǎi shén me sòng tā?",
          "translation": {
            "fr": "Qu’est-ce qu’on lui offre ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "她的椅子小，也不好看，我想买一个大椅子。",
          "pinyin": "tā de yǐ zi xiǎo, yě bù hǎo kàn, wǒ xiǎng mǎi yí gè dà yǐ zi.",
          "translation": {
            "fr": "Sa chaise est petite et pas très jolie, je voudrais acheter une grande chaise."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你看，这个红椅子很漂亮！多少钱？",
          "pinyin": "nǐ kàn, zhè ge hóng yǐ zi hěn piào liàng! duō shǎo qián?",
          "translation": {
            "fr": "Regarde, cette chaise rouge est très jolie ! C’est combien ?"
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "欢迎！这个八十块。",
          "pinyin": "huān yíng! zhè ge bā shí kuài.",
          "translation": {
            "fr": "Bienvenue ! Celle-ci coûte quatre-vingts yuans."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我有五十块，你有钱吗？",
          "pinyin": "wǒ yǒu wǔ shí kuài, nǐ yǒu qián ma?",
          "translation": {
            "fr": "J’ai cinquante yuans, et toi, tu as de l’argent ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我有三十块，我们有八十块了。",
          "pinyin": "wǒ yǒu sān shí kuài, wǒ men yǒu bā shí kuài le.",
          "translation": {
            "fr": "J’ai trente yuans : à nous deux, ça fait quatre-vingts."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "对不起，我们要这个红椅子。",
          "pinyin": "duì bù qǐ, wǒ men yào zhè ge hóng yǐ zi.",
          "translation": {
            "fr": "Excusez-moi, nous prenons cette chaise rouge."
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "好的，谢谢！",
          "pinyin": "hǎo de, xiè xie!",
          "translation": {
            "fr": "Très bien, merci !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "十月九日你来我家吃米饭，好吗？",
          "pinyin": "shí yuè jiǔ rì nǐ lái wǒ jiā chī mǐ fàn, hǎo ma?",
          "translation": {
            "fr": "Le 9 octobre, tu viens manger du riz chez moi, d’accord ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好！我也想吃鱼。",
          "pinyin": "hǎo! wǒ yě xiǎng chī yú.",
          "translation": {
            "fr": "Oui ! Moi, j’ai aussi envie de poisson."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 39
      }
    },
    {
      "id": "block-lesson-43-reading",
      "storyID": "story-lesson-43",
      "level": "HSK classique 1",
      "title": {
        "fr": "Le jour de l’anniversaire"
      },
      "paragraphs": [
        {
          "id": "lesson-43-p1",
          "hanzi": "十月九日是朋友妈妈的生日。我们买了一个大椅子，是红的。",
          "pinyin": "shí yuè jiǔ rì shì péng yǒu mā ma de shēng rì. wǒ men mǎi le yí gè dà yǐ zi, shì hóng de.",
          "translation": {
            "fr": "Le 9 octobre, c’est l’anniversaire de la maman de mon ami. Nous avons acheté une grande chaise, une rouge."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-43-p2",
          "hanzi": "生日的时候，我们在他家吃米饭和鱼。他的妈妈坐在红椅子上，笑了。",
          "pinyin": "shēng rì de shí hou, wǒ men zài tā jiā chī mǐ fàn hé yú. tā de mā ma zuò zài hóng yǐ zi shàng, xiào le.",
          "translation": {
            "fr": "Le jour de l’anniversaire, nous avons mangé du riz et du poisson chez lui. Sa maman s’est assise sur la chaise rouge et elle a souri."
          },
          "segmentation": [],
          "audio": null
        }
      ],
