    {
      "id": "block-lesson-59-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你怎么了？你很累吗？",
          "pinyin": "nǐ zěn me le? nǐ hěn lèi ma?",
          "translation": {
            "fr": "Qu’est-ce qui t’arrive ? Tu es fatigué ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，今天我在公司工作了十个小时。",
          "pinyin": "shì, jīn tiān wǒ zài gōng sī gōng zuò le shí gè xiǎo shí.",
          "translation": {
            "fr": "Oui, aujourd’hui j’ai travaillé dix heures à l’entreprise."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "十个小时！你休息一下吧。",
          "pinyin": "shí gè xiǎo shí! nǐ xiū xi yí xià ba.",
          "translation": {
            "fr": "Dix heures ! Repose-toi un peu."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "没关系，去年我比现在还累！",
          "pinyin": "méi guān xì, qù nián wǒ bǐ xiàn zài hái lèi!",
          "translation": {
            "fr": "Ce n’est rien, l’an dernier j’étais encore plus fatigué !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "是吗？那你晚上早点睡觉吧。",
          "pinyin": "shì ma? nà nǐ wǎn shang zǎo diǎn shuì jiào ba.",
          "translation": {
            "fr": "Ah bon ? Alors couche-toi tôt ce soir."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好。你的汉语现在比去年好多了！",
          "pinyin": "hǎo. nǐ de hàn yǔ xiàn zài bǐ qù nián hǎo duō le!",
          "translation": {
            "fr": "D’accord. Ton chinois est bien meilleur qu’il y a un an !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "是吗？去年你说话，我都不懂。",
          "pinyin": "shì ma? qù nián nǐ shuō huà, wǒ dōu bù dǒng.",
          "translation": {
            "fr": "Vraiment ? L’an dernier, quand tu parlais, je ne comprenais rien."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "现在你都懂了！",
          "pinyin": "xiàn zài nǐ dōu dǒng le!",
          "translation": {
            "fr": "Maintenant tu comprends tout !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "因为我学习了很多，也听了很多汉语。",
          "pinyin": "yīn wèi wǒ xué xí le hěn duō, yě tīng le hěn duō hàn yǔ.",
          "translation": {
            "fr": "C’est parce que j’ai beaucoup étudié et écouté beaucoup de chinois."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "太好了！我请你喝茶吧。",
          "pinyin": "tài hǎo le! wǒ qǐng nǐ hē chá ba.",
          "translation": {
            "fr": "Génial ! Je t’invite à prendre un thé."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 55
      }
    },
    {
      "id": "block-lesson-59-reading",
      "storyID": "story-lesson-59",
      "level": "HSK classique 2",
      "title": {
        "fr": "Un ami au travail"
      },
      "paragraphs": [
        {
          "id": "lesson-59-p1",
          "hanzi": "我的朋友在公司工作。他工作很多个小时，有时候很累。",
          "pinyin": "wǒ de péng you zài gōng sī gōng zuò. tā gōng zuò hěn duō gè xiǎo shí, yǒu shí hou hěn lèi.",
          "translation": {
            "fr": "Mon ami travaille dans une entreprise. Il travaille de longues heures et, parfois, il est très fatigué."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-59-p2",
          "hanzi": "去年他不懂电脑，现在他懂了，所以工作快多了。他觉得公司的工作很有意思。",
          "pinyin": "qù nián tā bù dǒng diàn nǎo, xiàn zài tā dǒng le, suǒ yǐ gōng zuò kuài duō le. tā jué de gōng sī de gōng zuò hěn yǒu yì si.",
          "translation": {
            "fr": "L’an dernier il ne s’y connaissait pas en informatique ; maintenant si, donc il travaille beaucoup plus vite. Il trouve son travail à l’entreprise très intéressant."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l59-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 55
      }
