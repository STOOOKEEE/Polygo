    {
      "id": "block-lesson-59-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你害怕走这条街吗？",
          "pinyin": "nǐ hài pà zǒu zhè tiáo jiē ma?",
          "translation": {
            "fr": "Tu as peur de marcher dans cette rue ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "以前我很害怕，因为灯很少。",
          "pinyin": "yǐ qián wǒ hěn hài pà, yīn wèi dēng hěn shǎo.",
          "translation": {
            "fr": "Avant, j’avais très peur parce qu’il y avait peu de lampes."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "现在路灯多了，走路很简单。",
          "pinyin": "xiàn zài lù dēng duō le, zǒu lù hěn jiǎn dān.",
          "translation": {
            "fr": "Maintenant il y a plus de lampes et marcher est simple."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "那座老房子虽然旧，但是没有坏。",
          "pinyin": "nà zuò lǎo fáng zi suī rán jiù, dàn shì méi yǒu huài.",
          "translation": {
            "fr": "Même si cette vieille maison est usée, elle n’est pas cassée."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 55
      }
    },
    {
      "id": "block-lesson-59-reading",
      "storyID": "story-lesson-59",
      "level": "HSK classique 2",
      "title": {
        "fr": "Une rue éclairée"
      },
      "paragraphs": [
        {
          "id": "lesson-59-p1",
          "hanzi": "以前这条街很暗，Tao害怕一个人走。",
          "pinyin": "yǐ qián zhè tiáo jiē hěn àn, Tao hài pà yí ge rén zǒu.",
          "translation": {
            "fr": "Avant, cette rue était sombre et Tao avait peur d’y marcher seul."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-59-p2",
          "hanzi": "现在路灯更多了，旧房子也还在。",
          "pinyin": "xiàn zài lù dēng gèng duō le, jiù fáng zi yě hái zài.",
          "translation": {
            "fr": "Maintenant il y a davantage de lampes et la vieille maison est toujours là."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l59-reading"
      ],
      "kind": "reading",
