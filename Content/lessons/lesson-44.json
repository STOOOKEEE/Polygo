    {
      "id": "block-lesson-44-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "新教室在哪一层？",
          "pinyin": "xīn jiào shì zài nǎ yī céng？",
          "translation": {
            "fr": "À quel étage est la nouvelle classe ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "在三层，黑板在前面。",
          "pinyin": "zài sān céng， hēi bǎn zài qián miàn。",
          "translation": {
            "fr": "Au troisième étage ; le tableau est devant."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你看得清楚吗？",
          "pinyin": "nǐ kàn de qīng chǔ ma？",
          "translation": {
            "fr": "Vois-tu clairement ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我戴眼镜就看得清楚。",
          "pinyin": "wǒ dài yǎn jìng jiù kàn de qīng chǔ。",
          "translation": {
            "fr": "Avec mes lunettes, je vois clairement."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这里舒服吗？",
          "pinyin": "zhè lǐ shū fú ma？",
          "translation": {
            "fr": "Est-ce confortable ici ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "很舒服。我们拍一张照片给老师看。",
          "pinyin": "hěn shū fú。 wǒ men pāi yī zhāng zhào piān gěi lǎo shī kàn。",
          "translation": {
            "fr": "C’est très confortable. Prenons une photo pour la montrer au professeur."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 40
      }
    },
    {
      "id": "block-lesson-44-reading",
      "storyID": "story-lesson-44",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une nouvelle classe"
      },
      "paragraphs": [
        {
          "id": "lesson-44-p1",
          "hanzi": "新教室在楼的三层，黑板在前面，桌子很干净。",
          "pinyin": "xīn jiào shì zài lóu de sān céng， hēi bǎn zài qián miàn， zhuō zi hěn gān jìng。",
          "translation": {
            "fr": "La nouvelle classe est au troisième étage de l’immeuble ; le tableau est devant et les tables sont propres."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-44-p2",
          "hanzi": "Tao戴眼镜看黑板，觉得这里很舒服。他拍了一张照片。",
          "pinyin": "Tao dài yǎn jìng kàn hēi bǎn， jué de zhè lǐ hěn shū fú。 tā pāi le yī zhāng zhào piān。",
          "translation": {
            "fr": "Tao porte ses lunettes pour regarder le tableau et trouve l’endroit très confortable. Il prend une photo."
          },
          "segmentation": [],
          "audio": null
        }
      ],
