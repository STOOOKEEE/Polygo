    {
      "id": "block-lesson-44-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "今天教室里有些热，你也热吗？",
          "pinyin": "jīn tiān jiào shì lǐ yǒu xiē rè, nǐ yě rè ma?",
          "translation": {
            "fr": "Il fait un peu chaud dans la classe aujourd’hui, toi aussi ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "很热！今天学生很多，昨天很少。",
          "pinyin": "hěn rè! jīn tiān xué shēng hěn duō, zuó tiān hěn shǎo.",
          "translation": {
            "fr": "Très chaud ! Il y a beaucoup d’élèves aujourd’hui, hier il y en avait très peu."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我们开门，好吗？",
          "pinyin": "wǒ men kāi mén, hǎo ma?",
          "translation": {
            "fr": "On ouvre la porte ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，我去开。前面那个小姐是谁？",
          "pinyin": "hǎo, wǒ qù kāi. qián miàn nà ge xiǎo jiě shì shéi?",
          "translation": {
            "fr": "D’accord, j’y vais. Qui est cette jeune femme, devant ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我不认识她。你好！你叫什么名字？",
          "pinyin": "wǒ bù rèn shí tā. nǐ hǎo! nǐ jiào shén me míng zi?",
          "translation": {
            "fr": "Je ne la connais pas. Bonjour ! Comment tu t’appelles ?"
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "你好！我叫Lin，我会写的字很少。",
          "pinyin": "nǐ hǎo! wǒ jiào Lin, wǒ huì xiě de zì hěn shǎo.",
          "translation": {
            "fr": "Salut ! Je m’appelle Lin, je connais très peu de caractères."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "没关系！这些字很多人都不会写。",
          "pinyin": "méi guān xì! zhè xiē zì hěn duō rén dōu bú huì xiě.",
          "translation": {
            "fr": "Ce n’est pas grave ! Beaucoup de gens ne savent pas écrire ces caractères."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我们可以帮助你。你看，这些字我会写。",
          "pinyin": "wǒ men kě yǐ bāng zhù nǐ. nǐ kàn, zhè xiē zì wǒ huì xiě.",
          "translation": {
            "fr": "On peut t’aider. Regarde, ces caractères-là, je sais les écrire."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你看，门开了，教室也不太热了。",
          "pinyin": "nǐ kàn, mén kāi le, jiào shì yě bù tài rè le.",
          "translation": {
            "fr": "Regardez, la porte est ouverte et la classe n’est plus trop chaude."
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "太好了，谢谢你！",
          "pinyin": "tài hǎo le, xiè xie nǐ!",
          "translation": {
            "fr": "Super, merci !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 40
      }
    },
    {
      "id": "block-lesson-44-reading",
      "storyID": "story-lesson-44",
      "level": "HSK classique 1",
      "title": {
        "fr": "Une nouvelle camarade"
      },
      "paragraphs": [
        {
          "id": "lesson-44-p1",
          "hanzi": "今天教室里有些热。前面的小姐是我们的同学。她会写的字很少。",
          "pinyin": "jīn tiān jiào shì lǐ yǒu xiē rè. qián miàn de xiǎo jiě shì wǒ men de tóng xué. tā huì xiě de zì hěn shǎo.",
          "translation": {
            "fr": "Aujourd’hui, il fait un peu chaud dans la classe. La jeune femme devant est notre camarade. Elle connaît très peu de caractères."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-44-p2",
          "hanzi": "我和朋友帮助她写字。她看了这些字，很高兴。",
          "pinyin": "wǒ hé péng yǒu bāng zhù tā xiě zì. tā kàn le zhè xiē zì, hěn gāo xìng.",
          "translation": {
            "fr": "Mon ami et moi l’aidons à écrire. Elle regarde ces caractères et elle est contente."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l44-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 40
      }
