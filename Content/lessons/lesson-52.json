    {
      "id": "block-lesson-52-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "今天公共汽车迟到了，街上突然出现很多人。",
          "pinyin": "jīn tiān gōng gòng qì chē chí dào le, jiē shàng tū rán chū xiàn hěn duō rén.",
          "translation": {
            "fr": "Aujourd’hui le bus est en retard et beaucoup de gens sont soudain apparus dans la rue."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我们约好打扫公园，除了邻居以外，学生也来了。",
          "pinyin": "wǒ men yuē hǎo dǎ sǎo gōng yuán, chú le lín jū yǐ wài, xué shēng yě lái le.",
          "translation": {
            "fr": "Nous avions prévu de nettoyer le parc ; en plus des voisins, des élèves sont venus aussi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "城市变得更干净了。",
          "pinyin": "chéng shì biàn de gèng gān jìng le.",
          "translation": {
            "fr": "La ville est devenue plus propre."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "等公共汽车的时候，我们先把树叶扫好。",
          "pinyin": "děng gōng gòng qì chē de shí hou, wǒ men xiān bǎ shù yè sǎo hǎo.",
          "translation": {
            "fr": "En attendant le bus, nous ramassons d’abord bien les feuilles."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 48
      }
    },
    {
      "id": "block-lesson-52-reading",
      "storyID": "story-lesson-52",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une matinée de bénévolat"
      },
      "paragraphs": [
        {
          "id": "lesson-52-p1",
          "hanzi": "公共汽车迟到了，志愿者们先在公园见面。",
          "pinyin": "gōng gòng qì chē chí dào le, zhì yuàn zhě men xiān zài gōng yuán jiàn miàn.",
          "translation": {
            "fr": "Le bus est arrivé en retard ; les bénévoles se sont d’abord retrouvés au parc."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-52-p2",
          "hanzi": "除了邻居以外，学生也参加了打扫。",
          "pinyin": "chú le lín jū yǐ wài, xué shēng yě cān jiā le dǎ sǎo.",
          "translation": {
            "fr": "En plus des voisins, des élèves ont aussi participé au nettoyage."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l52-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 48
      }
    },
