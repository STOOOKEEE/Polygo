    {
      "id": "block-lesson-71-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你经常来这个花园吗？",
          "pinyin": "nǐ jīng cháng lái zhè ge huā yuán ma?",
          "translation": {
            "fr": "Viens-tu souvent dans ce jardin ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "经常。河边的环境在春天特别好。",
          "pinyin": "jīng cháng. hé biān de huán jìng zài chūn tiān tè bié hǎo.",
          "translation": {
            "fr": "Souvent. L’environnement près de la rivière est particulièrement beau au printemps."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "每个季节都有变化。",
          "pinyin": "měi ge jì jié dōu yǒu biàn huà.",
          "translation": {
            "fr": "Chaque saison apporte des changements."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，雨后花也更鲜艳了。",
          "pinyin": "shì, yǔ hòu huā yě gèng xiān yàn le.",
          "translation": {
            "fr": "Oui, après la pluie les fleurs sont aussi plus éclatantes."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 67
      }
    },
    {
      "id": "block-lesson-71-reading",
      "storyID": "story-lesson-71",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une promenade près de l’eau"
      },
      "paragraphs": [
        {
          "id": "lesson-71-p1",
          "hanzi": "Tao经常到河边的花园散步。",
          "pinyin": "Tao jīng cháng dào hé biān de huā yuán sàn bù.",
          "translation": {
            "fr": "Tao se promène souvent dans le jardin près de la rivière."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-71-p2",
          "hanzi": "他发现不同季节的环境都有变化，雨后的花特别好看。",
          "pinyin": "tā fā xiàn bù tóng jì jié de huán jìng dōu yǒu biàn huà, yǔ hòu de huā tè bié hǎo kàn.",
          "translation": {
            "fr": "Il constate que l’environnement change selon les saisons et que les fleurs après la pluie sont particulièrement belles."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l71-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 67
      }
