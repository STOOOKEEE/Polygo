    {
      "id": "block-lesson-71-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你经常来这个花园吗？",
          "pinyin": "nǐ jīng cháng lái zhè ge huā yuán ma?",
          "translation": {
            "fr": "Viens-tu souvent dans ce jardin ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "经常。河边的环境在春天特别好。",
          "pinyin": "jīng cháng. hé biān de huán jìng zài chūn tiān tè bié hǎo.",
          "translation": {
            "fr": "Souvent. L’environnement près de la rivière est particulièrement beau au printemps."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "每个季节都有变化。",
          "pinyin": "měi ge jì jié dōu yǒu biàn huà.",
          "translation": {
            "fr": "Chaque saison apporte des changements."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，雨后花也更鲜艳了。",
          "pinyin": "shì, yǔ hòu huā yě gèng xiān yàn le.",
          "translation": {
            "fr": "Oui, après la pluie les fleurs sont aussi plus éclatantes."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 67
      }
    },
