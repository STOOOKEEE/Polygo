    {
      "id": "block-lesson-85-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你同意把活动改到下午吗？",
          "pinyin": "nǐ tóng yì bǎ huó dòng gǎi dào xià wǔ ma?",
          "translation": {
            "fr": "Es-tu d’accord pour déplacer l’activité à l’après-midi ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "同意。突然下雨了，大家不能出去。",
          "pinyin": "tóng yì. tū rán xià yǔ le, dà jiā bù néng chū qù.",
          "translation": {
            "fr": "Oui. Il s’est soudain mis à pleuvoir et personne ne peut sortir."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我们已经完成一半了吗？",
          "pinyin": "wǒ men yǐ jīng wán chéng yí bàn le ma?",
          "translation": {
            "fr": "Avons-nous déjà terminé la moitié ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "还没有，别忘记最后一箱书。",
          "pinyin": "hái méi yǒu, bié wàng jì zuì hòu yì xiāng shū.",
          "translation": {
            "fr": "Pas encore, n’oublie pas le dernier carton de livres."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 81
      }
    },
    {
      "id": "block-lesson-85-reading",
      "storyID": "story-lesson-85",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une collecte déplacée"
      },
      "paragraphs": [
        {
          "id": "lesson-85-p1",
          "hanzi": "大家同意改变活动时间，因为突然下雨了。",
          "pinyin": "dà jiā tóng yì gǎi biàn huó dòng shí jiān, yīn wèi tū rán xià yǔ le.",
          "translation": {
            "fr": "Tout le monde est d’accord pour changer l’horaire de l’activité parce qu’il s’est soudain mis à pleuvoir."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-85-p2",
          "hanzi": "他们完成了一半，还要记得搬最后一箱书。",
          "pinyin": "tā men wán chéng le yí bàn, hái yào jì de bān zuì hòu yì xiāng shū.",
          "translation": {
            "fr": "Ils ont terminé la moitié et doivent encore penser à déplacer le dernier carton de livres."
          },
          "segmentation": [],
          "audio": null
        }
      ],
