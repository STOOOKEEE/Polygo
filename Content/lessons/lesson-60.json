    {
      "id": "block-lesson-60-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "星期六你做什么？我想请你来我家。",
          "pinyin": "xīng qī liù nǐ zuò shén me? wǒ xiǎng qǐng nǐ lái wǒ jiā.",
          "translation": {
            "fr": "Tu fais quoi samedi ? J’aimerais t’inviter chez moi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "对不起，星期六我很忙。早上我要打篮球。",
          "pinyin": "duì bù qǐ, xīng qī liù wǒ hěn máng. zǎo shang wǒ yào dǎ lán qiú.",
          "translation": {
            "fr": "Désolé, samedi je suis très pris. Le matin, je joue au basket."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那下午呢？你还要做什么？",
          "pinyin": "nà xià wǔ ne? nǐ hái yào zuò shén me?",
          "translation": {
            "fr": "Et l’après-midi ? Qu’est-ce que tu as encore à faire ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "下午我洗衣服，晚上和朋友吃东西。",
          "pinyin": "xià wǔ wǒ xǐ yī fu, wǎn shang hé péng you chī dōng xi.",
          "translation": {
            "fr": "L’après-midi, je fais la lessive, et le soir je mange avec des amis."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "星期日你也很忙吗？",
          "pinyin": "xīng qī rì nǐ yě hěn máng ma?",
          "translation": {
            "fr": "Et dimanche, tu es aussi très occupé ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不忙。星期日我们家要坐船去旅游。",
          "pinyin": "bù máng. xīng qī rì wǒ men jiā yào zuò chuán qù lǚ yóu.",
          "translation": {
            "fr": "Non. Dimanche, on part en famille faire une balade en bateau."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "坐船！我也想去，几点走？",
          "pinyin": "zuò chuán! wǒ yě xiǎng qù, jǐ diǎn zǒu?",
          "translation": {
            "fr": "En bateau ! J’ai envie de venir aussi. On part à quelle heure ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "早上七点。你六点来我家，我妈妈做鸡蛋。",
          "pinyin": "zǎo shang qī diǎn. nǐ liù diǎn lái wǒ jiā, wǒ mā ma zuò jī dàn.",
          "translation": {
            "fr": "À sept heures du matin. Viens chez moi à six heures, ma mère fera des œufs."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好！我早点来。你妈妈做的鸡蛋，我也想吃。",
          "pinyin": "hǎo! wǒ zǎo diǎn lái. nǐ mā ma zuò de jī dàn, wǒ yě xiǎng chī.",
          "translation": {
            "fr": "Super ! Je viendrai tôt. Je veux goûter les œufs de ta mère aussi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "太好了！我妈妈很喜欢你。",
          "pinyin": "tài hǎo le! wǒ mā ma hěn xǐ huān nǐ.",
          "translation": {
            "fr": "Génial ! Ma mère t’aime beaucoup."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 56
      }
    },
    {
      "id": "block-lesson-60-reading",
      "storyID": "story-lesson-60",
      "level": "HSK classique 2",
      "title": {
        "fr": "Dimanche sur l’eau"
      },
      "paragraphs": [
        {
          "id": "lesson-60-p1",
          "hanzi": "星期日我和朋友坐船去旅游了。早上我在他家吃了鸡蛋。",
          "pinyin": "xīng qī rì wǒ hé péng you zuò chuán qù lǚ yóu le. zǎo shang wǒ zài tā jiā chī le jī dàn.",
          "translation": {
            "fr": "Dimanche, je suis partie en balade en bateau avec un ami. Le matin, j’ai mangé des œufs chez lui."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-60-p2",
          "hanzi": "船很大，人也很多。我很高兴，就是有一点累。",
          "pinyin": "chuán hěn dà, rén yě hěn duō. wǒ hěn gāo xìng, jiù shì yǒu yì diǎn lèi.",
          "translation": {
            "fr": "Le bateau était grand et il y avait beaucoup de monde. J’étais très contente, juste un peu fatiguée."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l60-reading"
      ],
      "kind": "reading",
