    {
      "id": "block-lesson-60-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你以前周末做什么？",
          "pinyin": "nǐ yǐ qián zhōu mò zuò shén me?",
          "translation": {
            "fr": "Que faisais-tu le week-end avant ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "以前我总是在家，以后想去旅行。",
          "pinyin": "yǐ qián wǒ zǒng shì zài jiā, yǐ hòu xiǎng qù lǚ xíng.",
          "translation": {
            "fr": "Avant, j’étais toujours à la maison ; à l’avenir, je veux voyager."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你现在还会一直学习吗？",
          "pinyin": "nǐ xiàn zài hái huì yì zhí xué xí ma?",
          "translation": {
            "fr": "Tu continueras encore à étudier sans arrêt ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "会，学习以后再安排旅行。",
          "pinyin": "huì, xué xí yǐ hòu zài ān pái lǚ xíng.",
          "translation": {
            "fr": "Oui, j’organiserai le voyage après les études."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 56
      }
    },
