    {
      "id": "block-lesson-48-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "别人都参加会议了吗？",
          "pinyin": "bié rén dōu cān jiā huì yì le ma？",
          "translation": {
            "fr": "Les autres ont-ils tous participé à la réunion ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "大部分参加了，但是小王还没到。",
          "pinyin": "dà bù fèn cān jiā le， dàn shì xiǎo wáng hái méi dào。",
          "translation": {
            "fr": "La plupart ont participé, mais Xiao Wang n’est pas encore arrivé."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "经理什么时候来？",
          "pinyin": "jīng lǐ shén me shí hòu lái？",
          "translation": {
            "fr": "Quand le manager vient-il ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "他五点才来。我们在二层等。",
          "pinyin": "tā wǔ diǎn cái lái。 wǒ men zài èr céng děng。",
          "translation": {
            "fr": "Il n’arrive qu’à cinq heures. Nous attendons au deuxième étage."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这次会议的结果怎么样？",
          "pinyin": "zhè cì huì yì de jié guǒ zěn me yàng？",
          "translation": {
            "fr": "Quel est le résultat de cette réunion ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "很好。如果大家同意，就开始工作。",
          "pinyin": "hěn hǎo。 rú guǒ dà jiā tóng yì， jiù kāi shǐ gōng zuò。",
          "translation": {
            "fr": "Il est très bon. Si tout le monde est d’accord, nous commençons le travail."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 44
      }
    },
    {
      "id": "block-lesson-48-reading",
      "storyID": "story-lesson-48",
      "level": "HSK classique 3",
      "title": {
        "fr": "Après la réunion"
      },
      "paragraphs": [
        {
          "id": "lesson-48-p1",
          "hanzi": "大部分同事参加了会议，经理五点才到。大家在二层等他。",
          "pinyin": "dà bù fèn tóng shì cān jiā le huì yì， jīng lǐ wǔ diǎn cái dào。 dà jiā zài èr céng děng tā。",
          "translation": {
            "fr": "La plupart des collègues ont participé à la réunion ; le manager n’est arrivé qu’à cinq heures. Tout le monde l’attend au deuxième étage."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-48-p2",
          "hanzi": "会议结束以后，大家看结果。如果同意新的办法，就开始工作。",
          "pinyin": "huì yì jié shù yǐ hòu， dà jiā kàn jié guǒ。 rú guǒ tóng yì xīn de bàn fǎ， jiù kāi shǐ gōng zuò。",
          "translation": {
            "fr": "Après la réunion, tout le monde regarde le résultat. Si tous sont d’accord avec la nouvelle méthode, ils commencent le travail."
          },
          "segmentation": [],
          "audio": null
        }
      ],
