    {
      "id": "block-lesson-79-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你要离开图书馆了吗？",
          "pinyin": "nǐ yào lí kāi tú shū guǎn le ma?",
          "translation": {
            "fr": "Tu vas quitter la bibliothèque ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "还没有。为了了解历史，我每天练习阅读。",
          "pinyin": "hái méi yǒu. wèi le liǎo jiě lì shǐ, wǒ měi tiān liàn xí yuè dú.",
          "translation": {
            "fr": "Pas encore. Pour comprendre l’histoire, je m’exerce à lire chaque jour."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这封信讲了什么？",
          "pinyin": "zhè fēng xìn jiǎng le shén me?",
          "translation": {
            "fr": "De quoi parle cette lettre ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "讲一个绿色城市的故事。",
          "pinyin": "jiǎng yí ge lǜ sè chéng shì de gù shi.",
          "translation": {
            "fr": "Elle raconte l’histoire d’une ville verte."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 75
      }
    },
    {
      "id": "block-lesson-79-reading",
      "storyID": "story-lesson-79",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une lettre à la bibliothèque"
      },
      "paragraphs": [
        {
          "id": "lesson-79-p1",
          "hanzi": "Tao在图书馆读历史，也练习普通话。",
          "pinyin": "Tao zài tú shū guǎn dú lì shǐ, yě liàn xí pǔ tōng huà.",
          "translation": {
            "fr": "Tao lit l’histoire à la bibliothèque et pratique aussi le mandarin standard."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-79-p2",
          "hanzi": "这封信讲一个绿色城市，Tao读完以后才离开。",
          "pinyin": "zhè fēng xìn jiǎng yí ge lǜ sè chéng shì, Tao dú wán yǐ hòu cái lí kāi.",
          "translation": {
            "fr": "La lettre raconte une ville verte ; Tao ne part qu’après l’avoir terminée."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l79-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 75
      }
