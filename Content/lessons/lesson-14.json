    {
      "id": "block-lesson-14-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你来了！我们坐这里。",
          "pinyin": "nǐ lái le! wǒ men zuò zhè lǐ.",
          "translation": {
            "fr": "Te voilà ! Asseyons-nous ici."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "机场里人很多！你姐姐下午来吗？",
          "pinyin": "jī chǎng lǐ rén hěn duō! nǐ jiě jie xià wǔ lái ma?",
          "translation": {
            "fr": "Il y a un monde fou dans l’aéroport ! Ta sœur arrive cet après-midi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "是，我姐姐下午从法国来。",
          "pinyin": "shì, wǒ jiě jie xià wǔ cóng fǎ guó lái.",
          "translation": {
            "fr": "Oui, ma sœur arrive de France cet après-midi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你姐姐是老师吗？",
          "pinyin": "nǐ jiě jie shì lǎo shī ma?",
          "translation": {
            "fr": "Ta sœur est professeure ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "不是，姐姐是学生。你有姐姐吗？",
          "pinyin": "bú shì, jiě jie shì xué shēng. nǐ yǒu jiě jie ma?",
          "translation": {
            "fr": "Non, elle est étudiante. Et toi, tu as une grande sœur ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有，我有姐姐、哥哥和妹妹。",
          "pinyin": "yǒu, wǒ yǒu jiě jie, gē ge hé mèi mei.",
          "translation": {
            "fr": "Oui, j’ai une grande sœur, un grand frère et une petite sœur."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你哥哥在法国吗？",
          "pinyin": "nǐ gē ge zài fǎ guó ma?",
          "translation": {
            "fr": "Ton frère est en France ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "在。我今天没喝茶，机场里有茶吗？",
          "pinyin": "zài. wǒ jīn tiān méi hē chá, jī chǎng lǐ yǒu chá ma?",
          "translation": {
            "fr": "Oui. Je n’ai pas bu de thé aujourd’hui, il y en a dans l’aéroport ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "有，商店里有茶。你去买，我坐这里。",
          "pinyin": "yǒu, shāng diàn lǐ yǒu chá. nǐ qù mǎi, wǒ zuò zhè lǐ.",
          "translation": {
            "fr": "Oui, il y en a à la boutique. Va en acheter, moi je reste assise ici."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你喝什么？牛奶吗？",
          "pinyin": "nǐ hē shén me? niú nǎi ma?",
          "translation": {
            "fr": "Tu bois quoi ? Du lait ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我要牛奶，谢谢！",
          "pinyin": "wǒ yào niú nǎi, xiè xie!",
          "translation": {
            "fr": "Oui, je veux du lait, merci !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 10
      }
    },
    {
      "id": "block-lesson-14-reading",
      "storyID": "story-lesson-14",
      "level": "HSK classique 1",
      "title": {
        "fr": "Une sœur arrive de France"
      },
      "paragraphs": [
        {
          "id": "lesson-14-p1",
          "hanzi": "今天下午我和朋友在机场。机场里人很多，我们坐这里。我姐姐是学生，从法国来中国。",
          "pinyin": "jīn tiān xià wǔ wǒ hé péng you zài jī chǎng. jī chǎng lǐ rén hěn duō, wǒ men zuò zhè lǐ. wǒ jiě jie shì xué shēng, cóng fǎ guó lái zhōng guó.",
          "translation": {
            "fr": "Cet après-midi, mon ami et moi sommes à l’aéroport. Il y a beaucoup de monde, nous nous asseyons ici. Ma sœur est étudiante et elle vient de France en Chine."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-14-p2",
          "hanzi": "朋友去商店里买茶。姐姐来了，我和朋友都笑了。",
          "pinyin": "péng you qù shāng diàn lǐ mǎi chá. jiě jie lái le, wǒ hé péng you dōu xiào le.",
          "translation": {
            "fr": "Mon ami va acheter du thé à la boutique. Ma sœur arrive, et nous rions tous les deux, mon ami et moi."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l14-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 10
      }
    },
