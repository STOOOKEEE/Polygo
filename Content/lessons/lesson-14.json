    {
      "id": "block-lesson-14-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你怎么去机场？",
          "pinyin": "nǐ zěn me qù jī chǎng？",
          "translation": {
            "fr": "Comment vas-tu à l’aéroport ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我坐出租车，不坐公共汽车。",
          "pinyin": "wǒ zuò chū zū chē， bù zuò gōng gòng qì chē。",
          "translation": {
            "fr": "Je prends un taxi, pas le bus."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "飞机几点走？",
          "pinyin": "fēi jī jǐ diǎn zǒu？",
          "translation": {
            "fr": "À quelle heure part l’avion ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "下午三点。船和火车今天都没有。",
          "pinyin": "xià wǔ sān diǎn。 chuán hé huǒ chē jīn tiān dōu méi yǒu。",
          "translation": {
            "fr": "À trois heures de l’après-midi. Il n’y a ni bateau ni train aujourd’hui."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你正在买票吗？",
          "pinyin": "nǐ zhèng zài mǎi piào ma？",
          "translation": {
            "fr": "Tu es en train d’acheter le billet ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，我买二号票，然后去旅游。",
          "pinyin": "shì， wǒ mǎi èr hào piào， rán hòu qù lǚ yóu。",
          "translation": {
            "fr": "Oui, j’achète le billet numéro deux, puis je pars voyager."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 10
      }
    },
    {
      "id": "block-lesson-14-reading",
      "storyID": "story-lesson-14",
      "level": "HSK classique 2",
      "title": {
        "fr": "Le départ"
      },
      "paragraphs": [
        {
          "id": "lesson-14-p1",
          "hanzi": "下午三点，飞机从机场出发。Tao坐出租车去机场，手里拿着二号票。",
          "pinyin": "xià wǔ sān diǎn， fēi jī cóng jī chǎng chū fā。 Tao zuò chū zū chē qù jī chǎng， shǒu lǐ ná zhe èr hào piào。",
          "translation": {
            "fr": "À trois heures, l’avion part de l’aéroport. Tao prend un taxi pour l’aéroport et tient le billet numéro deux."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-14-p2",
          "hanzi": "他没有坐公共汽车，也没有坐船，因为他正在赶飞机。",
          "pinyin": "tā méi yǒu zuò gōng gòng qì chē， yě méi yǒu zuò chuán， yīn wèi tā zhèng zài gǎn fēi jī。",
          "translation": {
            "fr": "Il n’a pris ni le bus ni le bateau, car il se dépêche pour l’avion."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l14-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 10
      }
    },
