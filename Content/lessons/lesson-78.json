    {
      "id": "block-lesson-78-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "这个孩子很可爱，但是走了一会儿就哭了。",
          "pinyin": "zhè ge hái zi hěn kě ài, dàn shì zǒu le yí huìr jiù kū le.",
          "translation": {
            "fr": "Cet enfant est adorable, mais il s’est mis à pleurer après avoir marché un moment."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "虽然天气很热，但是空调马上就开了。",
          "pinyin": "suī rán tiān qì hěn rè, dàn shì kōng tiáo mǎ shàng jiù kāi le.",
          "translation": {
            "fr": "Même s’il fait chaud, la climatisation sera allumée tout de suite."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "他渴了，给他一点水吧。",
          "pinyin": "tā kě le, gěi tā yì diǎn shuǐ ba.",
          "translation": {
            "fr": "Il a soif, donne-lui un peu d’eau."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，他看到蓝色的气球就笑了。",
          "pinyin": "hǎo, tā kàn dào lán sè de qì qiú jiù xiào le.",
          "translation": {
            "fr": "D’accord, il sourit dès qu’il voit le ballon bleu."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 74
      }
    },
    {
      "id": "block-lesson-78-reading",
      "storyID": "story-lesson-78",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une pause au frais"
      },
      "paragraphs": [
        {
          "id": "lesson-78-p1",
          "hanzi": "孩子走了一会儿觉得渴，因为天气很热。",
          "pinyin": "hái zi zǒu le yí huìr jué de kě, yīn wèi tiān qì hěn rè.",
          "translation": {
            "fr": "Après avoir marché un moment, l’enfant a soif parce qu’il fait chaud."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-78-p2",
          "hanzi": "他们打开空调，给他水；看到蓝色气球后，孩子不哭了。",
          "pinyin": "tā men dǎ kāi kōng tiáo, gěi tā shuǐ; kàn dào lán sè qì qiú hòu, hái zi bù kū le.",
          "translation": {
            "fr": "Ils allument la climatisation et lui donnent de l’eau ; après avoir vu un ballon bleu, l’enfant ne pleure plus."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l78-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 74
      }
    },
