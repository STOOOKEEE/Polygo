    {
      "id": "block-lesson-22-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "喂，你在公司吗？",
          "pinyin": "wèi， nǐ zài gōng sī ma？",
          "translation": {
            "fr": "Allô, tu es à l’entreprise ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我在上班，从家到公司要半小时。",
          "pinyin": "wǒ zài shàng bān， cóng jiā dào gōng sī yào bàn xiǎo shí。",
          "translation": {
            "fr": "Je suis au travail ; de la maison à l’entreprise, il faut une demi-heure."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "外面下雨，你怎么来？",
          "pinyin": "wài miàn xià yǔ， nǐ zěn me lái？",
          "translation": {
            "fr": "Il pleut dehors, comment es-tu venu ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我坐车来的。先生，你喜欢下雨吗？",
          "pinyin": "wǒ zuò chē lái de。 xiān shēng， nǐ xǐ huān xià yǔ ma？",
          "translation": {
            "fr": "Je suis venu en voiture. Monsieur, aimez-vous la pluie ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我不喜欢，但是我们有工作。",
          "pinyin": "wǒ bù xǐ huān， dàn shì wǒ men yǒu gōng zuò。",
          "translation": {
            "fr": "Je n’aime pas ça, mais nous avons du travail."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "没关系，我们五点一起回家。",
          "pinyin": "méi guān xì， wǒ men wǔ diǎn yì qǐ huí jiā。",
          "translation": {
            "fr": "Ce n’est pas grave, nous rentrerons ensemble à cinq heures."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 18
      }
    },
    {
      "id": "block-lesson-22-reading",
      "storyID": "story-lesson-22",
      "level": "HSK classique 2",
      "title": {
        "fr": "Le trajet"
      },
      "paragraphs": [
        {
          "id": "lesson-22-p1",
          "hanzi": "Tao从家到公司上班，路上开始下雨。他坐车，没有迟到。",
          "pinyin": "Tao cóng jiā dào gōng sī shàng bān， lù shàng kāi shǐ xià yǔ。 tā zuò chē， méi yǒu chí dào。",
          "translation": {
            "fr": "Tao va de la maison à l’entreprise pour travailler ; il commence à pleuvoir en route. Il prend une voiture et n’est pas en retard."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-22-p2",
          "hanzi": "下午五点，他和同事一起回家。虽然下雨，但是大家都喜欢今天的工作。",
          "pinyin": "xià wǔ wǔ diǎn， tā hé tóng shì yì qǐ huí jiā。 suī rán xià yǔ， dàn shì dà jiā dōu xǐ huān jīn tiān de gōng zuò。",
          "translation": {
            "fr": "À cinq heures, il rentre avec ses collègues. Même s’il pleut, tout le monde aime le travail d’aujourd’hui."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l22-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 18
      }
    },
