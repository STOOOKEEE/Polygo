    {
      "id": "block-lesson-15-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你好，Lin！你现在在家吗？",
          "pinyin": "nǐ hǎo, Lin! nǐ xiàn zài zài jiā ma?",
          "translation": {
            "fr": "Salut, Lin ! Tu es chez toi en ce moment ?"
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "在。你呢？你现在在中国吗？",
          "pinyin": "zài. nǐ ne? nǐ xiàn zài zài zhōng guó ma?",
          "translation": {
            "fr": "Oui. Et toi ? Tu es en Chine, maintenant ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "在！我在朋友家。他也是我的汉语老师。",
          "pinyin": "zài! wǒ zài péng you jiā. tā yě shì wǒ de hàn yǔ lǎo shī.",
          "translation": {
            "fr": "Oui ! Je suis chez un ami. C’est aussi mon professeur de chinois."
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "你的汉语老师？他叫什么名字？",
          "pinyin": "nǐ de hàn yǔ lǎo shī? tā jiào shén me míng zi?",
          "translation": {
            "fr": "Ton professeur de chinois ? Comment s’appelle-t-il ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "他叫Tao，是一个中国学生。",
          "pinyin": "tā jiào Tao, shì yí gè zhōng guó xué shēng.",
          "translation": {
            "fr": "Il s’appelle Tao, c’est un étudiant chinois."
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "你现在会汉语吗？",
          "pinyin": "nǐ xiàn zài huì hàn yǔ ma?",
          "translation": {
            "fr": "Tu parles chinois, maintenant ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "不多！我现在知道十个字。",
          "pinyin": "bù duō! wǒ xiàn zài zhī dào shí gè zì.",
          "translation": {
            "fr": "Pas beaucoup ! Pour l’instant, je connais dix caractères."
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "十个字？很多！你在中国有电话吗？",
          "pinyin": "shí gè zì? hěn duō! nǐ zài zhōng guó yǒu diàn huà ma?",
          "translation": {
            "fr": "Dix caractères ? C’est déjà beaucoup ! Tu as un téléphone en Chine ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "有，我买了一个电话。你要我的电话吗？",
          "pinyin": "yǒu, wǒ mǎi le yí gè diàn huà. nǐ yào wǒ de diàn huà ma?",
          "translation": {
            "fr": "Oui, j’ai acheté un téléphone. Tu veux mon numéro de téléphone ?"
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "要，谢谢！再见！",
          "pinyin": "yào, xiè xie! zài jiàn!",
          "translation": {
            "fr": "Oui, merci ! Au revoir !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 11
      }
    },
    {
      "id": "block-lesson-15-reading",
      "storyID": "story-lesson-15",
      "level": "HSK classique 1",
      "title": {
        "fr": "Mina en Chine"
      },
      "paragraphs": [
        {
          "id": "lesson-15-p1",
          "hanzi": "现在我在中国。我有一个中国朋友，他也是我的汉语老师。他家有狗，也有猫。",
          "pinyin": "xiàn zài wǒ zài zhōng guó. wǒ yǒu yí gè zhōng guó péng you, tā yě shì wǒ de hàn yǔ lǎo shī. tā jiā yǒu gǒu, yě yǒu māo.",
          "translation": {
            "fr": "Maintenant je suis en Chine. J’ai un ami chinois, qui est aussi mon professeur de chinois. Chez lui, il y a un chien et aussi un chat."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-15-p2",
          "hanzi": "我在他家喝茶，吃米饭。现在我的汉语不多，我想有很多朋友。",
          "pinyin": "wǒ zài tā jiā hē chá, chī mǐ fàn. xiàn zài wǒ de hàn yǔ bù duō, wǒ xiǎng yǒu hěn duō péng you.",
          "translation": {
            "fr": "Chez lui, je bois du thé et je mange du riz. Pour l’instant, mon chinois n’est pas très bon, et j’aimerais avoir beaucoup d’amis."
          },
          "segmentation": [],
          "audio": null
        }
      ],
