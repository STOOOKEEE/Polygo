    {
      "id": "block-lesson-15-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你爱北京吗？",
          "pinyin": "nǐ ài běi jīng ma？",
          "translation": {
            "fr": "Tu aimes Pékin ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "爱。我想学汉语。",
          "pinyin": "ài。 wǒ xiǎng xué hàn yǔ。",
          "translation": {
            "fr": "Oui. Je veux apprendre le chinois."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你有几个杯子？",
          "pinyin": "nǐ yǒu jǐ gè bēi zi？",
          "translation": {
            "fr": "Combien de tasses as-tu ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我有两个杯子，一个是朋友送的。",
          "pinyin": "wǒ yǒu liǎng gè bēi zi， yí gè shì péng yǒu sòng de。",
          "translation": {
            "fr": "J’ai deux tasses ; l’une vient d’un cadeau d’un ami."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我在后面，你来吗？",
          "pinyin": "wǒ zài hòu miàn， nǐ lái ma？",
          "translation": {
            "fr": "Je suis derrière, tu viens ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "来，对不起，我马上到。",
          "pinyin": "lái， duì bù qǐ， wǒ mǎ shàng dào。",
          "translation": {
            "fr": "Oui, désolé, j’arrive tout de suite."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 11
      }
    },
    {
      "id": "block-lesson-15-reading",
      "storyID": "story-lesson-15",
      "level": "HSK classique 2",
      "title": {
        "fr": "Le rendez-vous"
      },
      "paragraphs": [
        {
          "id": "lesson-15-p1",
          "hanzi": "我爱北京，也喜欢学汉语。今天我有两个杯子，一个给朋友。",
          "pinyin": "wǒ ài běi jīng， yě xǐ huān xué hàn yǔ。 jīn tiān wǒ yǒu liǎng gè bēi zi， yí gè gěi péng yǒu。",
          "translation": {
            "fr": "J’aime Pékin et j’aime aussi apprendre le chinois. Aujourd’hui, j’ai deux tasses, dont une pour un ami."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-15-p2",
          "hanzi": "朋友在我后面等我。我说对不起，然后马上来。",
          "pinyin": "péng yǒu zài wǒ hòu miàn děng wǒ。 wǒ shuō duì bù qǐ， rán hòu mǎ shàng lái。",
          "translation": {
            "fr": "Un ami m’attend derrière moi. Je dis désolé, puis j’arrive tout de suite."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l15-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 11
      }
    },
