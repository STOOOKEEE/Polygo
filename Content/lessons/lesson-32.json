    {
      "id": "block-lesson-32-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "这家商店有新衣服吗？",
          "pinyin": "zhè jiā shāng diàn yǒu xīn yī fú ma？",
          "translation": {
            "fr": "Ce magasin a-t-il de nouveaux vêtements ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有。你喜欢什么颜色？",
          "pinyin": "yǒu。 nǐ xǐ huān shén me yán sè？",
          "translation": {
            "fr": "Oui. Quelle couleur aimes-tu ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我想买红色的，但是眼睛有点累。",
          "pinyin": "wǒ xiǎng mǎi hóng sè de， dàn shì yǎn jīng yǒu diǎn lèi。",
          "translation": {
            "fr": "Je veux acheter le rouge, mais mes yeux sont un peu fatigués."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我们一起休息一下，再看。",
          "pinyin": "wǒ men yì qǐ xiū xī yī xià， zài kàn。",
          "translation": {
            "fr": "Reposons-nous un peu ensemble, puis regardons."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那件在右边，已经准备好了吗？",
          "pinyin": "nà jiàn zài yòu biān， yǐ jīng zhǔn bèi hǎo le ma？",
          "translation": {
            "fr": "Celui de droite est-il déjà prêt ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "准备好了。真的很漂亮，商店也不远。",
          "pinyin": "zhǔn bèi hǎo le。 zhēn de hěn piào liàng， shāng diàn yě bù yuǎn。",
          "translation": {
            "fr": "Oui. Il est vraiment joli et le magasin n’est pas loin."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 28
      }
    },
    {
      "id": "block-lesson-32-reading",
      "storyID": "story-lesson-32",
      "level": "HSK classique 2",
      "title": {
        "fr": "Une pause"
      },
      "paragraphs": [
        {
          "id": "lesson-32-p1",
          "hanzi": "顾客和朋友一起看衣服。红色的衣服在右边，新的衣服已经准备好。",
          "pinyin": "gù kè hé péng yǒu yì qǐ kàn yī fú。 hóng sè de yī fú zài yòu biān， xīn de yī fú yǐ jīng zhǔn bèi hǎo。",
          "translation": {
            "fr": "Le client et son ami regardent des vêtements ensemble. Les vêtements rouges sont à droite et les nouveaux sont déjà prêts."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-32-p2",
          "hanzi": "顾客眼睛累了，所以他们先休息，再看衣服。她觉得衣服真的很漂亮。",
          "pinyin": "gù kè yǎn jīng lèi le， suǒ yǐ tā men xiān xiū xī， zài kàn yī fú。 tā jué de yī fú zhēn de hěn piào liàng。",
          "translation": {
            "fr": "Le client a les yeux fatigués, alors ils se reposent puis regardent les vêtements. Elle trouve le vêtement vraiment joli."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l32-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 28
      }
    },
