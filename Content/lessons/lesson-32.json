    {
      "id": "block-lesson-32-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "这家商店有很多漂亮的衣服！",
          "pinyin": "zhè jiā shāng diàn yǒu hěn duō piào liàng de yī fu!",
          "translation": {
            "fr": "Ce magasin a plein de jolis vêtements !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你想买什么颜色的？",
          "pinyin": "nǐ xiǎng mǎi shén me yán sè de?",
          "translation": {
            "fr": "Tu veux acheter quelle couleur ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我喜欢绿的。星期五是朋友的生日。",
          "pinyin": "wǒ xǐ huān lǜ de. xīng qī wǔ shì péng yǒu de shēng rì.",
          "translation": {
            "fr": "J’aime le vert. Vendredi, c’est l’anniversaire d’un ami."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "那你要买漂亮的！这个绿的好不好？",
          "pinyin": "nà nǐ yào mǎi piào liàng de! zhè gè lǜ de hǎo bù hǎo?",
          "translation": {
            "fr": "Alors il te faut quelque chose de joli ! Celui-ci, le vert, qu’en dis-tu ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这个太大了，我不要。有小的吗？",
          "pinyin": "zhè gè tài dà le, wǒ bù yào. yǒu xiǎo de ma?",
          "translation": {
            "fr": "Il est trop grand, je n’en veux pas. Vous en avez un plus petit ?"
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "有，请看，小的在这里。",
          "pinyin": "yǒu, qǐng kàn, xiǎo de zài zhè lǐ.",
          "translation": {
            "fr": "Oui, regardez, les petits sont ici."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这个很漂亮，我买了！",
          "pinyin": "zhè gè hěn piào liàng, wǒ mǎi le!",
          "translation": {
            "fr": "Celui-là est très joli, je le prends !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "现在已经中午了，我们去吃米饭，好吗？",
          "pinyin": "xiàn zài yǐ jīng zhōng wǔ le, wǒ men qù chī mǐ fàn, hǎo ma?",
          "translation": {
            "fr": "Il est déjà midi, on va manger du riz ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好！我准备了钱，今天我请你。",
          "pinyin": "hǎo! wǒ zhǔn bèi le qián, jīn tiān wǒ qǐng nǐ.",
          "translation": {
            "fr": "D’accord ! J’ai prévu de l’argent, aujourd’hui c’est moi qui t’invite."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "谢谢！你的衣服很漂亮，我很喜欢。",
          "pinyin": "xiè xie! nǐ de yī fu hěn piào liàng, wǒ hěn xǐ huān.",
          "translation": {
            "fr": "Merci ! Tes vêtements sont très jolis, ils me plaisent beaucoup."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 28
      }
    },
    {
      "id": "block-lesson-32-reading",
      "storyID": "story-lesson-32",
      "level": "HSK classique 1",
      "title": {
        "fr": "L’anniversaire de vendredi"
      },
      "paragraphs": [
        {
          "id": "lesson-32-p1",
          "hanzi": "星期五是朋友的生日。我已经买了绿衣服，颜色很漂亮。朋友喜欢红的，他的衣服也很漂亮。",
          "pinyin": "xīng qī wǔ shì péng yǒu de shēng rì. wǒ yǐ jīng mǎi le lǜ yī fu, yán sè hěn piào liàng. péng yǒu xǐ huān hóng de, tā de yī fu yě hěn piào liàng.",
          "translation": {
            "fr": "Vendredi, c’est l’anniversaire de mon ami. J’ai déjà acheté des vêtements verts, la couleur est très jolie. Mon ami aime le rouge, et ses vêtements sont jolis aussi."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-32-p2",
          "hanzi": "中午我们在学校吃米饭，喝茶。我希望星期五天气很好。",
          "pinyin": "zhōng wǔ wǒ men zài xué xiào chī mǐ fàn, hē chá. wǒ xī wàng xīng qī wǔ tiān qì hěn hǎo.",
          "translation": {
            "fr": "À midi, nous mangeons du riz et buvons du thé à l’école. J’espère qu’il fera beau vendredi."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l32-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 28
      }
    },
