    {
      "id": "block-lesson-66-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你有什么爱好？",
          "pinyin": "nǐ yǒu shén me ài hào?",
          "translation": {
            "fr": "Quels sont tes loisirs ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我喜欢在春天看草和动物。",
          "pinyin": "wǒ xǐ huan zài chūn tiān kàn cǎo hé dòng wù.",
          "translation": {
            "fr": "J’aime regarder l’herbe et les animaux au printemps."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "虽然冬天很冷，但是公园也很安静。",
          "pinyin": "suī rán dōng tiān hěn lěng, dàn shì gōng yuán yě hěn ān jìng.",
          "translation": {
            "fr": "Même si l’hiver est froid, le parc est aussi très calme."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "那我们冬天再来，带一杯热茶。",
          "pinyin": "nà wǒ men dōng tiān zài lái, dài yì bēi rè chá.",
          "translation": {
            "fr": "Alors revenons en hiver avec une tasse de thé chaud."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 62
      }
    },
    {
      "id": "block-lesson-66-reading",
      "storyID": "story-lesson-66",
      "level": "HSK classique 3",
      "title": {
        "fr": "Deux saisons au parc"
      },
      "paragraphs": [
        {
          "id": "lesson-66-p1",
          "hanzi": "春天，草变绿了，公园里出现很多小动物。",
          "pinyin": "chūn tiān, cǎo biàn lǜ le, gōng yuán lǐ chū xiàn hěn duō xiǎo dòng wù.",
          "translation": {
            "fr": "Au printemps, l’herbe verdit et beaucoup de petits animaux apparaissent dans le parc."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-66-p2",
          "hanzi": "冬天虽然冷，但是这里很安静，Tao还是喜欢来。",
          "pinyin": "dōng tiān suī rán lěng, dàn shì zhè lǐ hěn ān jìng, Tao hái shì xǐ huan lái.",
          "translation": {
            "fr": "Même si l’hiver est froid, l’endroit est calme et Tao aime toujours venir."
          },
          "segmentation": [],
          "audio": null
        }
      ],
