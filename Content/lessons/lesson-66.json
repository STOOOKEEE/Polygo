    {
      "id": "block-lesson-66-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "火车站里人很多，你姐姐是哪一个？",
          "pinyin": "huǒ chē zhàn lǐ rén hěn duō, nǐ jiě jie shì nǎ yí ge?",
          "translation": {
            "fr": "Il y a beaucoup de monde dans la gare, laquelle est ta sœur ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "她的眼睛很大，穿着红衣服。",
          "pinyin": "tā de yǎn jing hěn dà, chuān zhe hóng yī fu.",
          "translation": {
            "fr": "Elle a de grands yeux et elle est habillée en rouge."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "左边那个女人吗？她在看手机。",
          "pinyin": "zuǒ biān nà ge nǚ rén ma? tā zài kàn shǒu jī.",
          "translation": {
            "fr": "La femme, là, sur la gauche ? Elle regarde son téléphone."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不是，她的眼睛小，我姐姐的眼睛大。",
          "pinyin": "bú shì, tā de yǎn jing xiǎo, wǒ jiě jie de yǎn jing dà.",
          "translation": {
            "fr": "Non, elle a de petits yeux, ma sœur en a de grands."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "前面有一个男人和一个女人，那两个人在笑。",
          "pinyin": "qián miàn yǒu yí ge nán rén hé yí ge nǚ rén, nà liǎng ge rén zài xiào.",
          "translation": {
            "fr": "Devant, il y a un homme et une femme, et ils rient."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "对，那就是我姐姐和她丈夫！",
          "pinyin": "duì, nà jiù shì wǒ jiě jie hé tā zhàng fu!",
          "translation": {
            "fr": "Oui, ce sont ma sœur et son mari !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我看见了，她笑的时候眼睛很漂亮。",
          "pinyin": "wǒ kàn jiàn le, tā xiào de shí hou yǎn jing hěn piào liang.",
          "translation": {
            "fr": "Je la vois, ses yeux sont très beaux quand elle rit."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我姐姐爱笑，我们都喜欢笑。",
          "pinyin": "wǒ jiě jie ài xiào, wǒ men dōu xǐ huān xiào.",
          "translation": {
            "fr": "Ma sœur adore rire, chez nous tout le monde aime ça."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我也喜欢笑！我们快走吧。",
          "pinyin": "wǒ yě xǐ huān xiào! wǒ men kuài zǒu ba.",
          "translation": {
            "fr": "Moi aussi, j’aime rire ! Allons vite les rejoindre."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，她在等我们。",
          "pinyin": "hǎo, tā zài děng wǒ men.",
          "translation": {
            "fr": "Oui, elle nous attend."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 62
      }
    },
    {
      "id": "block-lesson-66-reading",
      "storyID": "story-lesson-66",
      "level": "HSK classique 2",
      "title": {
        "fr": "Ma camarade de classe"
      },
      "paragraphs": [
        {
          "id": "lesson-66-p1",
          "hanzi": "我的同学是一个很漂亮的女人，她的眼睛很大。她坐在我的左边，我们都喜欢学习汉语。",
          "pinyin": "wǒ de tóng xué shì yí ge hěn piào liang de nǚ rén, tā de yǎn jing hěn dà. tā zuò zài wǒ de zuǒ biān, wǒ men dōu xǐ huān xué xí hàn yǔ.",
          "translation": {
            "fr": "Ma camarade de classe est une très belle femme, avec de grands yeux. Elle est assise à ma gauche, et nous aimons toutes les deux apprendre le chinois."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-66-p2",
          "hanzi": "她的丈夫是一个很好的男人，有时候来学校找她。她爱笑，我们上课的时候也很高兴。我觉得，爱笑的人最漂亮。",
          "pinyin": "tā de zhàng fu shì yí ge hěn hǎo de nán rén, yǒu shí hou lái xué xiào zhǎo tā. tā ài xiào, wǒ men shàng kè de shí hou yě hěn gāo xìng. wǒ jué de, ài xiào de rén zuì piào liang.",
          "translation": {
            "fr": "Son mari est un homme très gentil, qui vient parfois la chercher à l’école. Elle aime rire, alors nous sommes contents en cours aussi. Je trouve que les gens qui aiment rire sont les plus beaux."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l66-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 62
      }
    },
