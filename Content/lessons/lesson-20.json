  "blocks": [
    {
      "kind": "introduction",
      "id": "block-lesson-20-grammar-01",
      "title": {
        "fr": "Grammaire — 比较 + adjectif"
      },
      "body": {
        "fr": "比较 se place avant un adjectif pour atténuer la description : la phrase est assez longue.\nExemple 1 : 这句话比较长。\nzhè jù huà bǐ jiào zhǎng。\nCette phrase est assez longue."
      },
      "metadata": {
        "stage": "introduce",
        "skill": "recognition",
        "lessonDay": 16
      }
    },
