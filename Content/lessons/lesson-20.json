    {
      "id": "block-lesson-20-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "请问，这个问题是什么意思？",
          "pinyin": "qǐng wèn， zhè ge wèn tí shì shén me yì si？",
          "translation": {
            "fr": "Excusez-moi, que signifie cette question ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "请你再说一遍，我听不清楚。",
          "pinyin": "qǐng nǐ zài shuō yī biàn， wǒ tīng bù qīng chǔ。",
          "translation": {
            "fr": "Répétez, s’il vous plaît, je n’entends pas clairement."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这句话比较长，那句话比较短。",
          "pinyin": "zhè jù huà bǐ jiào zhǎng， nà jù huà bǐ jiào duǎn。",
          "translation": {
            "fr": "Cette phrase est plus longue, cette autre est plus courte."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我认识那个姓李的男人。",
          "pinyin": "wǒ rèn shí nà ge xìng lǐ de nán rén。",
          "translation": {
            "fr": "Je connais l’homme qui s’appelle Li."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "他是你的丈夫吗？",
          "pinyin": "tā shì nǐ de zhàng fū ma？",
          "translation": {
            "fr": "Est-ce ton mari ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不是，他是朋友。请坐在我旁边。",
          "pinyin": "bú shì， tā shì péng yǒu。 qǐng zuò zài wǒ páng biān。",
          "translation": {
            "fr": "Non, c’est un ami. Asseyez-vous à côté de moi."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 16
      }
    },
    {
      "id": "block-lesson-20-reading",
      "storyID": "story-lesson-20",
      "level": "HSK classique 1",
      "title": {
        "fr": "Une précision"
      },
      "paragraphs": [
        {
          "id": "lesson-20-p1",
          "hanzi": "学生请老师解释问题的意思。老师把长句子写在黑板上。",
          "pinyin": "xué shēng qǐng lǎo shī jiě shì wèn tí de yì si。 lǎo shī bǎ cháng jù zi xiě zài hēi bǎn shàng。",
          "translation": {
            "fr": "L’étudiant demande au professeur d’expliquer le sens de la question. Le professeur écrit la longue phrase au tableau."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-20-p2",
          "hanzi": "短句子在上面，学生在旁边听。后来他认识了那个姓李的人。",
          "pinyin": "duǎn jù zi zài shàng miàn， xué shēng zài páng biān tīng。 hòu lái tā rèn shí le nà ge xìng lǐ de rén。",
          "translation": {
            "fr": "La phrase courte est au-dessus et l’étudiant écoute à côté. Plus tard, il fait connaissance avec la personne appelée Li."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l20-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 16
      }
    },
