      "id": "pinyin-05-hear",
      "required": true,
      "statement": {
        "fr": "Distinguer à l’oreille les voyelles (u/ü/i, ai/ei/ao/ou) et les finales en -n et en -ng."
      }
    },
    {
      "id": "pinyin-05-link",
      "required": true,
      "statement": {
        "fr": "Décrire la prononciation de ü, de -n / -ng et de ian, et les redire."
      }
    }
