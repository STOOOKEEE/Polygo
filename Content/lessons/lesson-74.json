    {
      "id": "block-lesson-74-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你要吃面条吗？",
          "pinyin": "nǐ yào chī miàn tiáo ma?",
          "translation": {
            "fr": "Tu veux manger des nouilles ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "要，但是除了葡萄以外，糖要少吃。",
          "pinyin": "yào, dàn shì chú le pú tao yǐ wài, táng yào shǎo chī.",
          "translation": {
            "fr": "Oui, mais à part les raisins, il faut manger peu de sucre."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "啤酒也要少喝。",
          "pinyin": "pí jiǔ yě yào shǎo hē.",
          "translation": {
            "fr": "Il faut aussi boire peu de bière."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我把面条放在盘子里，慢慢吃。",
          "pinyin": "wǒ bǎ miàn tiáo fàng zài pán zi lǐ, màn màn chī.",
          "translation": {
            "fr": "Je mets les nouilles dans l’assiette et je mange lentement."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 70
      }
    },
