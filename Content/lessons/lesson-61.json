    {
      "id": "block-lesson-61-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "这条裙子好看吗？",
          "pinyin": "zhè tiáo qún zi hǎo kàn ma?",
          "translation": {
            "fr": "Cette jupe est-elle jolie ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "如果你不满意，就换一条。",
          "pinyin": "rú guǒ nǐ bù mǎn yì, jiù huàn yì tiáo.",
          "translation": {
            "fr": "Si tu n’es pas satisfaite, change-la."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我喜欢这顶帽子，但是鞋有点小。",
          "pinyin": "wǒ xǐ huan zhè dǐng mào zi, dàn shì xié yǒu diǎn xiǎo.",
          "translation": {
            "fr": "J’aime ce chapeau, mais les chaussures sont un peu petites."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "别生气，我们再看看。",
          "pinyin": "bié shēng qì, wǒ men zài kàn kan.",
          "translation": {
            "fr": "Ne te fâche pas, regardons encore."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 57
      }
    },
    {
