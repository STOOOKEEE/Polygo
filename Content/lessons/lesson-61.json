      },
      "paragraphs": [
        {
          "id": "lesson-61-p1",
          "hanzi": "Mina喜欢一条裙子，但是对鞋不满意。",
          "pinyin": "Mina xǐ huan yì tiáo qún zi, dàn shì duì xié bù mǎn yì.",
          "translation": {
            "fr": "Mina aime une jupe, mais elle n’est pas satisfaite des chaussures."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-61-p2",
          "hanzi": "如果鞋太小，她就换一双。",
          "pinyin": "rú guǒ xié tài xiǎo, tā jiù huàn yì shuāng.",
          "translation": {
            "fr": "Si les chaussures sont trop petites, elle en changera une paire."
          },
          "segmentation": [],
          "audio": null
        }
