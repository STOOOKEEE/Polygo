    {
      "id": "block-l7-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "今天是几月几日？",
          "pinyin": "jīn tiān shì jǐ yuè jǐ rì?",
          "translation": {
            "fr": "Quelle date sommes-nous ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "今天是九月三日。",
          "pinyin": "jīn tiān shì jiǔ yuè sān rì.",
          "translation": {
            "fr": "Nous sommes le 3 septembre."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我妈妈和我爸爸在家。",
          "pinyin": "wǒ mā ma hé wǒ bà ba zài jiā.",
          "translation": {
            "fr": "Ma maman et mon papa sont à la maison."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "她的儿子在家。",
          "pinyin": "tā de ér zi zài jiā.",
          "translation": {
            "fr": "Son fils est à la maison."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我的女儿在家。",
          "pinyin": "wǒ de nǚ ér zài jiā.",
          "translation": {
            "fr": "Ma fille est à la maison."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你呢？",
          "pinyin": "nǐ ne?",
          "translation": {
            "fr": "Et toi ?"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 3
      }
