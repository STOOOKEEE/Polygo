    {
      "id": "block-l7-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "你好！这是我家。",
          "pinyin": "nǐ hǎo! zhè shì wǒ jiā.",
          "translation": {
            "fr": "Salut ! Voici chez moi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你家不小！妈妈和爸爸都在吗？",
          "pinyin": "nǐ jiā bù xiǎo! mā ma hé bà ba dōu zài ma?",
          "translation": {
            "fr": "Elle n’est pas petite, ta maison ! Ta mère et ton père sont là ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "妈妈在，爸爸不在。",
          "pinyin": "mā ma zài, bà ba bú zài.",
          "translation": {
            "fr": "Ma mère est là, mon père non."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "爸爸星期几在家？",
          "pinyin": "bà ba xīng qī jǐ zài jiā?",
          "translation": {
            "fr": "Ton père est à la maison quel jour ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "星期日。今天是七月五日，星期五。",
          "pinyin": "xīng qī rì. jīn tiān shì qī yuè wǔ rì, xīng qī wǔ.",
          "translation": {
            "fr": "Le dimanche. Aujourd’hui, c’est le 5 juillet, un vendredi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "请喝茶。这是妈妈的茶。",
          "pinyin": "qǐng hē chá. zhè shì mā ma de chá.",
          "translation": {
            "fr": "Bois du thé, je t’en prie. C’est le thé de ma mère."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "谢谢！是白茶吗？",
          "pinyin": "xiè xie! shì bái chá ma?",
          "translation": {
            "fr": "Merci ! C’est du thé blanc ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，也有红茶和绿茶。",
          "pinyin": "shì, yě yǒu hóng chá hé lǜ chá.",
          "translation": {
            "fr": "Oui, il y a aussi du thé noir et du thé vert."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我喝绿茶。你家的茶多！",
          "pinyin": "wǒ hē lǜ chá. nǐ jiā de chá duō!",
          "translation": {
            "fr": "Je prendrai du thé vert. Tu as plein de thés chez toi !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 3
      }
    },
    {
      "id": "block-l7-reading",
      "storyID": "story-l7-family",
      "title": {
        "fr": "Ma famille"
      },
      "paragraphs": [
        {
          "id": "lesson-07-p1",
          "hanzi": "我家有妈妈、爸爸和哥哥。哥哥在中国，爸爸和妈妈在法国。",
          "pinyin": "wǒ jiā yǒu mā ma, bà ba hé gē ge. gē ge zài zhōng guó, bà ba hé mā ma zài fǎ guó.",
          "translation": {
            "fr": "Chez moi, il y a maman, papa et mon grand frère. Mon frère est en Chine, papa et maman sont en France."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-07-p2",
          "hanzi": "妈妈星期一和星期五在家，爸爸星期日在家。今天是星期五，妈妈在家，爸爸不在。",
          "pinyin": "mā ma xīng qī yī hé xīng qī wǔ zài jiā, bà ba xīng qī rì zài jiā. jīn tiān shì xīng qī wǔ, mā ma zài jiā, bà ba bú zài.",
          "translation": {
            "fr": "Maman est à la maison le lundi et le vendredi, papa le dimanche. Aujourd’hui, on est vendredi : maman est là, papa non."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l7-reading"
      ],
      "kind": "reading",
      "metadata": {
