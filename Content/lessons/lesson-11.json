    {
      "id": "block-lesson-11-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "中午我们去饭馆吗？",
          "pinyin": "zhōng wǔ wǒ men qù fàn guǎn ma？",
          "translation": {
            "fr": "Nous allons au restaurant à midi ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，我要米饭和鱼。",
          "pinyin": "hǎo， wǒ yào mǐ fàn hé yú。",
          "translation": {
            "fr": "D’accord, je veux du riz et du poisson."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这里还有鸡蛋、水果和牛奶。",
          "pinyin": "zhè lǐ hái yǒu jī dàn、 shuǐ guǒ hé niú nǎi。",
          "translation": {
            "fr": "Il y a aussi des œufs, des fruits et du lait."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我不喝咖啡，我喝牛奶。",
          "pinyin": "wǒ bù hē kā fēi， wǒ hē niú nǎi。",
          "translation": {
            "fr": "Je ne bois pas de café, je bois du lait."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "天气很热，吃西瓜吧。",
          "pinyin": "tiān qì hěn rè， chī xī guā ba。",
          "translation": {
            "fr": "Il fait très chaud, mangeons de la pastèque."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，吃完我们去买衣服。",
          "pinyin": "hǎo， chī wán wǒ men qù mǎi yī fú。",
          "translation": {
            "fr": "D’accord, après le repas nous irons acheter des vêtements."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 7
      }
    },
    {
      "id": "block-lesson-11-reading",
      "storyID": "story-lesson-11",
      "level": "HSK classique 2",
      "title": {
        "fr": "Le déjeuner"
      },
      "paragraphs": [
        {
          "id": "lesson-11-p1",
          "hanzi": "中午我和朋友在饭馆吃米饭、鱼和鸡蛋。",
          "pinyin": "zhōng wǔ wǒ hé péng yǒu zài fàn guǎn chī mǐ fàn、 yú hé jī dàn。",
          "translation": {
            "fr": "À midi, mon ami et moi mangeons du riz, du poisson et des œufs au restaurant."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-11-p2",
          "hanzi": "我喝牛奶，不喝咖啡。吃完饭，我们买了一件衣服。",
          "pinyin": "wǒ hē niú nǎi， bù hē kā fēi。 chī wán fàn， wǒ men mǎi le yī jiàn yī fú。",
          "translation": {
            "fr": "Je bois du lait, pas de café. Après le repas, nous achetons un vêtement."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l11-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 7
      }
