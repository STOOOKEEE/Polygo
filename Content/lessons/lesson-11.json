    {
      "id": "block-lesson-11-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "你好！这是我妹妹。",
          "pinyin": "nǐ hǎo! zhè shì wǒ mèi mei.",
          "translation": {
            "fr": "Salut ! Voici ma petite sœur."
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "你好！我家有米饭，也有鱼。鱼很大！",
          "pinyin": "nǐ hǎo! wǒ jiā yǒu mǐ fàn, yě yǒu yú. yú hěn dà!",
          "translation": {
            "fr": "Bonjour ! Chez nous, il y a du riz et du poisson. Il est gros, le poisson !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "谢谢！我们吃鱼，也吃菜。",
          "pinyin": "xiè xie! wǒ men chī yú, yě chī cài.",
          "translation": {
            "fr": "Merci ! On mange du poisson, et des légumes aussi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你喝茶吗？我妹妹不喝茶，喝牛奶。",
          "pinyin": "nǐ hē chá ma? wǒ mèi mei bù hē chá, hē niú nǎi.",
          "translation": {
            "fr": "Tu bois du thé ? Ma petite sœur n’en boit pas, elle boit du lait."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我喝茶。牛奶热吗？",
          "pinyin": "wǒ hē chá. niú nǎi rè ma?",
          "translation": {
            "fr": "Moi, du thé. Le lait est chaud ?"
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "很热！你也喝牛奶吗？",
          "pinyin": "hěn rè! nǐ yě hē niú nǎi ma?",
          "translation": {
            "fr": "Très chaud ! Tu en veux aussi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "喝！茶和牛奶我都喝。",
          "pinyin": "hē! chá hé niú nǎi wǒ dōu hē.",
          "translation": {
            "fr": "Oui ! Le thé et le lait, je bois les deux."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你有妹妹吗？",
          "pinyin": "nǐ yǒu mèi mei ma?",
          "translation": {
            "fr": "Et toi, tu as une petite sœur ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我有哥哥和姐姐。我家有爸爸、妈妈、哥哥、姐姐和我。",
          "pinyin": "wǒ yǒu gē ge hé jiě jie. wǒ jiā yǒu bà ba, mā ma, gē ge, jiě jie hé wǒ.",
          "translation": {
            "fr": "J’ai un grand frère et une grande sœur. Chez moi, il y a papa, maman, mon frère, ma sœur et moi."
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "请吃！米饭很多。",
          "pinyin": "qǐng chī! mǐ fàn hěn duō.",
          "translation": {
            "fr": "Servez-vous ! Il y a plein de riz."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 7
      }
    },
    {
      "id": "block-lesson-11-reading",
      "storyID": "story-lesson-11",
      "level": "HSK classique 1",
      "title": {
        "fr": "Chez mon ami"
      },
      "paragraphs": [
        {
          "id": "lesson-11-p1",
          "hanzi": "今天我们在朋友家吃米饭。鱼很大，菜也多。",
          "pinyin": "jīn tiān wǒ men zài péng yǒu jiā chī mǐ fàn. yú hěn dà, cài yě duō.",
          "translation": {
            "fr": "Aujourd’hui, nous mangeons du riz chez mon ami. Le poisson est gros et il y a beaucoup de légumes."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-11-p2",
          "hanzi": "朋友的妹妹很小，不喝茶，喝牛奶。吃了米饭，我们喝茶和牛奶。",
          "pinyin": "péng yǒu de mèi mei hěn xiǎo, bù hē chá, hē niú nǎi. chī le mǐ fàn, wǒ men hē chá hé niú nǎi.",
          "translation": {
            "fr": "La petite sœur de mon ami est toute petite : elle ne boit pas de thé, elle boit du lait. Après le riz, nous buvons du thé et du lait."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l11-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 7
      }
    },
