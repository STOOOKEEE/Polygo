    {
      "id": "block-lesson-46-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "这几位是你的同事吗？",
          "pinyin": "zhè jǐ wèi shì nǐ de tóng shì ma？",
          "translation": {
            "fr": "Ces personnes sont-elles tes collègues ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，一共五位。",
          "pinyin": "shì， yī gòng wǔ wèi。",
          "translation": {
            "fr": "Oui, cinq personnes au total."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那位老人是你爷爷吗？",
          "pinyin": "nà wèi lǎo rén shì nǐ yé yé ma？",
          "translation": {
            "fr": "La personne âgée est-elle ton grand-père ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是。他来看我们的工作。",
          "pinyin": "shì。 tā lái kàn wǒ men de gōng zuò。",
          "translation": {
            "fr": "Oui. Il vient voir notre travail."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你拍的照片表示什么？",
          "pinyin": "nǐ pāi de zhào piān biǎo shì shén me？",
          "translation": {
            "fr": "Qu’exprime la photo que tu prends ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "表示欢迎。请大家一起看照片。",
          "pinyin": "biǎo shì huān yíng。 qǐng dà jiā yì qǐ kàn zhào piān。",
          "translation": {
            "fr": "Elle exprime la bienvenue. Regardons tous la photo ensemble."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 42
      }
    },
    {
      "id": "block-lesson-46-reading",
      "storyID": "story-lesson-46",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une équipe"
      },
      "paragraphs": [
        {
          "id": "lesson-46-p1",
          "hanzi": "五位同事在办公室见面，爷爷也来看他们的工作。",
          "pinyin": "wǔ wèi tóng shì zài bàn gōng shì jiàn miàn， yé yé yě lái kàn tā men de gōng zuò。",
          "translation": {
            "fr": "Cinq collègues se retrouvent au bureau ; le grand-père vient aussi voir leur travail."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-46-p2",
          "hanzi": "Tao用照相机拍下大家的样子。这张照片表示欢迎，所有人都很高兴。",
          "pinyin": "Tao yòng zhào xiàng jī pāi xià dà jiā de yàng zi。 zhè zhāng zhào piān biǎo shì huān yíng， suǒ yǒu rén dōu hěn gāo xìng。",
          "translation": {
            "fr": "Tao prend tout le monde en photo. Cette photo exprime la bienvenue et tout le monde est heureux."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l46-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 42
      }
