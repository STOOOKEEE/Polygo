    {
      "id": "block-lesson-53-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你打算在哪里开会？",
          "pinyin": "nǐ dǎ suàn zài nǎ lǐ kāi huì?",
          "translation": {
            "fr": "Où comptes-tu tenir la réunion ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "在办公室。因为会议很早，所以我提前到了。",
          "pinyin": "zài bàn gōng shì. yīn wèi huì yì hěn zǎo, suǒ yǐ wǒ tí qián dào le.",
          "translation": {
            "fr": "Au bureau. Comme la réunion est tôt, je suis arrivé en avance."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你担心桌子太低吗？",
          "pinyin": "nǐ dān xīn zhuō zi tài dī ma?",
          "translation": {
            "fr": "Tu crains que la table soit trop basse ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不用担心，这个地方当然可以。",
          "pinyin": "bú yòng dān xīn, zhè ge dì fāng dāng rán kě yǐ.",
          "translation": {
            "fr": "Ne t’inquiète pas, cet endroit convient bien sûr."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 49
      }
    },
    {
      "id": "block-lesson-53-reading",
      "storyID": "story-lesson-53",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une salle prête à temps"
      },
      "paragraphs": [
        {
          "id": "lesson-53-p1",
          "hanzi": "Tao打算在办公室开会。",
          "pinyin": "Tao dǎ suàn zài bàn gōng shì kāi huì.",
          "translation": {
            "fr": "Tao compte tenir une réunion au bureau."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-53-p2",
          "hanzi": "因为会议很早，所以他提前到了。桌子虽然有点低，但是地方很方便。",
          "pinyin": "yīn wèi huì yì hěn zǎo, suǒ yǐ tā tí qián dào le. zhuō zi suī rán yǒu diǎn dī, dàn shì dì fāng hěn fāng biàn.",
          "translation": {
            "fr": "Comme la réunion est tôt, il est arrivé en avance. Même si la table est un peu basse, l’endroit est pratique."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l53-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 49
      }
    },
