    {
      "id": "block-lesson-53-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你打算在哪里开会？",
          "pinyin": "nǐ dǎ suàn zài nǎ lǐ kāi huì?",
          "translation": {
            "fr": "Où comptes-tu tenir la réunion ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "在办公室。因为会议很早，所以我提前到了。",
          "pinyin": "zài bàn gōng shì. yīn wèi huì yì hěn zǎo, suǒ yǐ wǒ tí qián dào le.",
          "translation": {
            "fr": "Au bureau. Comme la réunion est tôt, je suis arrivé en avance."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你担心桌子太低吗？",
          "pinyin": "nǐ dān xīn zhuō zi tài dī ma?",
          "translation": {
            "fr": "Tu crains que la table soit trop basse ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不用担心，这个地方当然可以。",
          "pinyin": "bú yòng dān xīn, zhè ge dì fāng dāng rán kě yǐ.",
          "translation": {
            "fr": "Ne t’inquiète pas, cet endroit convient bien sûr."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 49
      }
    },
    {
      "id": "block-lesson-53-reading",
