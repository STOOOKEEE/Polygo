    {
      "id": "block-lesson-25-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "明天是星期日，你想做什么运动？",
          "pinyin": "míng tiān shì xīng qī rì, nǐ xiǎng zuò shén me yùn dòng?",
          "translation": {
            "fr": "Demain, c’est dimanche. Tu as envie de faire quel sport ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我想游泳。你会游泳吗？",
          "pinyin": "wǒ xiǎng yóu yǒng. nǐ huì yóu yǒng ma?",
          "translation": {
            "fr": "Moi, j’ai envie de nager. Tu sais nager ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "会，我很想游泳。明天天气好吗？",
          "pinyin": "huì, wǒ hěn xiǎng yóu yǒng. míng tiān tiān qì hǎo ma?",
          "translation": {
            "fr": "Oui, j’en ai très envie. Il fera beau demain ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我看一下电脑。明天不下雨，天气很好！",
          "pinyin": "wǒ kàn yī xià diàn nǎo. míng tiān bú xià yǔ, tiān qì hěn hǎo!",
          "translation": {
            "fr": "Je regarde sur l’ordinateur. Demain il ne pleut pas, il fait très beau !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好！我们几点去？",
          "pinyin": "hǎo! wǒ men jǐ diǎn qù?",
          "translation": {
            "fr": "Super ! On y va à quelle heure ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "下午三点，好吗？",
          "pinyin": "xià wǔ sān diǎn, hǎo ma?",
          "translation": {
            "fr": "À trois heures de l’après-midi, ça te va ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好。你的书在桌子上，明天不学习汉语吗？",
          "pinyin": "hǎo. nǐ de shū zài zhuō zi shàng, míng tiān bù xué xí hàn yǔ ma?",
          "translation": {
            "fr": "D’accord. Ton livre est sur la table : tu n’étudies pas le chinois demain ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "不学习了，明天我们运动！",
          "pinyin": "bù xué xí le, míng tiān wǒ men yùn dòng!",
          "translation": {
            "fr": "Non, demain on fait du sport !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你的汉语很好，我也想运动！",
          "pinyin": "nǐ de hàn yǔ hěn hǎo, wǒ yě xiǎng yùn dòng!",
          "translation": {
            "fr": "Ton chinois est très bien, et moi aussi j’ai envie de bouger !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那明天下午三点，再见！",
          "pinyin": "nà míng tiān xià wǔ sān diǎn, zài jiàn!",
          "translation": {
            "fr": "Alors demain à trois heures, à demain !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 21
      }
    },
    {
      "id": "block-lesson-25-reading",
      "storyID": "story-lesson-25",
      "level": "HSK classique 1",
      "title": {
        "fr": "Un bon dimanche"
      },
      "paragraphs": [
        {
          "id": "lesson-25-p1",
          "hanzi": "星期日天气很好，不下雨。我和朋友下午三点去游泳。",
          "pinyin": "xīng qī rì tiān qì hěn hǎo, bú xià yǔ. wǒ hé péng you xià wǔ sān diǎn qù yóu yǒng.",
          "translation": {
            "fr": "Dimanche, il fait très beau et il ne pleut pas. Mon ami et moi allons nager à trois heures de l’après-midi."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-25-p2",
          "hanzi": "我的书在桌子上，今天我不看书。我们都想运动，不想学习汉语。",
          "pinyin": "wǒ de shū zài zhuō zi shàng, jīn tiān wǒ bú kàn shū. wǒ men dōu xiǎng yùn dòng, bù xiǎng xué xí hàn yǔ.",
          "translation": {
            "fr": "Mon livre est sur la table, mais aujourd’hui je ne lis pas. Nous avons tous les deux envie de bouger, pas d’étudier le chinois."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l25-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 21
      }
