    {
      "id": "block-lesson-25-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "周末你想做什么运动？",
          "pinyin": "zhōu mò nǐ xiǎng zuò shén me yùn dòng？",
          "translation": {
            "fr": "Quel sport veux-tu faire ce week-end ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我想跑步，也想打篮球。",
          "pinyin": "wǒ xiǎng pǎo bù， yě xiǎng dǎ lán qiú。",
          "translation": {
            "fr": "Je veux courir et jouer aussi au basket."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你会踢足球吗？",
          "pinyin": "nǐ huì tī zú qiú ma？",
          "translation": {
            "fr": "Tu sais jouer au football ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "会，但是今天要下雨。",
          "pinyin": "huì， dàn shì jīn tiān yào xià yǔ。",
          "translation": {
            "fr": "Oui, mais il va pleuvoir aujourd’hui."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那我们在家唱歌、跳舞吧。",
          "pinyin": "nà wǒ men zài jiā chàng gē、 tiào wǔ ba。",
          "translation": {
            "fr": "Alors chantons et dansons à la maison."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，明天天气好再去游泳。",
          "pinyin": "hǎo， míng tiān tiān qì hǎo zài qù yóu yǒng。",
          "translation": {
            "fr": "D’accord, nous irons nager demain s’il fait beau."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 21
      }
    },
    {
      "id": "block-lesson-25-reading",
      "storyID": "story-lesson-25",
      "level": "HSK classique 2",
      "title": {
        "fr": "Au parc"
      },
      "paragraphs": [
        {
          "id": "lesson-25-p1",
          "hanzi": "周末天气很好，我坐在公园里看朋友跑步。",
          "pinyin": "zhōu mò tiān qì hěn hǎo， wǒ zuò zài gōng yuán lǐ kàn péng yǒu pǎo bù。",
          "translation": {
            "fr": "Le temps est beau ce week-end ; je suis assis dans le parc et je regarde mon ami courir."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-25-p2",
          "hanzi": "下午我们打篮球、踢足球。下雨以后，我们回家唱歌和跳舞。",
          "pinyin": "xià wǔ wǒ men dǎ lán qiú、 tī zú qiú。 xià yǔ yǐ hòu， wǒ men huí jiā chàng gē hé tiào wǔ。",
          "translation": {
            "fr": "L’après-midi, nous jouons au basket et au football. Après la pluie, nous rentrons chanter et danser."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l25-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 21
      }
    },
