    {
      "id": "block-lesson-34-dialogue",
      "lines": [
        {
          "speaker": "An",
          "hanzi": "昨天你去哪里了？",
          "pinyin": "zuó tiān nǐ qù nǎ lǐ le?",
          "translation": {
            "fr": "Tu es allée où, hier ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我和Tao去饭馆了。昨天下雨，我们坐出租车去。",
          "pinyin": "wǒ hé Tao qù fàn guǎn le. zuó tiān xià yǔ, wǒ men zuò chū zū chē qù.",
          "translation": {
            "fr": "Tao et moi, on est allés au restaurant. Hier, il pleuvait, alors on y est allés en taxi."
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "出租车多少钱？",
          "pinyin": "chū zū chē duō shǎo qián?",
          "translation": {
            "fr": "Le taxi, c’était combien ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "三十块，很便宜！饭馆在学校前面。",
          "pinyin": "sān shí kuài, hěn pián yi! fàn guǎn zài xué xiào qián miàn.",
          "translation": {
            "fr": "Trente yuans, ce n’est pas cher ! Le restaurant est devant l’école."
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "饭馆的菜好吃吗？",
          "pinyin": "fàn guǎn de cài hǎo chī ma?",
          "translation": {
            "fr": "On y mange bien ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "很好吃！鱼比菜好吃，我很高兴。",
          "pinyin": "hěn hǎo chī! yú bǐ cài hǎo chī, wǒ hěn gāo xìng.",
          "translation": {
            "fr": "Très bon ! Le poisson est meilleur que les légumes, j’étais très contente."
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "我也想去，明天中午可以吗？",
          "pinyin": "wǒ yě xiǎng qù, míng tiān zhōng wǔ kě yǐ ma?",
          "translation": {
            "fr": "Moi aussi, j’ai envie d’y aller. Demain midi, ça te va ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "可以！饭馆的门是红的，很漂亮。",
          "pinyin": "kě yǐ! fàn guǎn de mén shì hóng de, hěn piào liàng.",
          "translation": {
            "fr": "Oui ! La porte du restaurant est rouge, elle est très jolie."
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "好！我明天要坐出租车去，你呢？",
          "pinyin": "hǎo! wǒ míng tiān yào zuò chū zū chē qù, nǐ ne?",
          "translation": {
            "fr": "Super ! Demain, je prendrai un taxi, et toi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我也坐出租车，我们都很高兴！",
          "pinyin": "wǒ yě zuò chū zū chē, wǒ men dōu hěn gāo xìng!",
          "translation": {
            "fr": "Moi aussi ! On sera tous contents !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 30
      }
    },
    {
      "id": "block-lesson-34-reading",
      "storyID": "story-lesson-34",
      "level": "HSK classique 1",
      "title": {
        "fr": "Un déjeuner au restaurant"
      },
      "paragraphs": [
        {
          "id": "lesson-34-p1",
          "hanzi": "昨天中午，我坐出租车去饭馆。饭馆里有很多人，也很热。",
          "pinyin": "zuó tiān zhōng wǔ, wǒ zuò chū zū chē qù fàn guǎn. fàn guǎn lǐ yǒu hěn duō rén, yě hěn rè.",
          "translation": {
            "fr": "Hier à midi, j’ai pris un taxi pour aller au restaurant. Il y avait beaucoup de monde et il faisait chaud."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-34-p2",
          "hanzi": "我要了鱼和米饭，也喝了茶。饭馆的鱼很好吃，我很高兴。明天我也想和妈妈去。",
          "pinyin": "wǒ yào le yú hé mǐ fàn, yě hē le chá. fàn guǎn de yú hěn hǎo chī, wǒ hěn gāo xìng. míng tiān wǒ yě xiǎng hé mā ma qù.",
          "translation": {
            "fr": "J’ai pris du poisson et du riz, et j’ai aussi bu du thé. Le poisson du restaurant était très bon, j’étais très contente. Demain, j’ai aussi envie d’y aller avec maman."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l34-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 30
      }
