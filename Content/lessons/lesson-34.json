    {
      "id": "block-lesson-34-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "今天我们复习什么？",
          "pinyin": "jīn tiān wǒ men fù xí shén me？",
          "translation": {
            "fr": "Que révisons-nous aujourd’hui ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我们复习在家、吃饭和去学校。",
          "pinyin": "wǒ men fù xí zài jiā、 chī fàn hé qù xué xiào。",
          "translation": {
            "fr": "Nous révisons la maison, les repas et l’école."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你能说说昨天的安排吗？",
          "pinyin": "nǐ néng shuō shuō zuó tiān de ān pái ma？",
          "translation": {
            "fr": "Peux-tu parler du programme d’hier ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我先去饭馆，然后去了学校。",
          "pinyin": "wǒ xiān qù fàn guǎn， rán hòu qù le xué xiào。",
          "translation": {
            "fr": "Je suis d’abord allé au restaurant, puis à l’école."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "为什么你回家很晚？",
          "pinyin": "wèi shén me nǐ huí jiā hěn wǎn？",
          "translation": {
            "fr": "Pourquoi es-tu rentré tard ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "因为下雨，所以我坐出租车。现在我懂了。",
          "pinyin": "yīn wèi xià yǔ， suǒ yǐ wǒ zuò chū zū chē。 xiàn zài wǒ dǒng le。",
          "translation": {
            "fr": "Comme il pleuvait, j’ai pris un taxi. Maintenant j’ai compris."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 30
      }
    },
    {
      "id": "block-lesson-34-reading",
      "storyID": "story-lesson-34",
      "level": "HSK classique 1",
      "title": {
        "fr": "Le parcours"
      },
      "paragraphs": [
        {
          "id": "lesson-34-p1",
          "hanzi": "前三十天，我们在家、学校和商店练习说话。",
          "pinyin": "qián sān shí tiān， wǒ men zài jiā、 xué xiào hé shāng diàn liàn xí shuō huà。",
          "translation": {
            "fr": "Pendant les trente premiers jours, nous avons pratiqué la conversation à la maison, à l’école et au magasin."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-34-p2",
          "hanzi": "昨天我先吃饭，然后坐出租车回家。因为下雨，所以回家很晚，但是我很高兴。",
          "pinyin": "zuó tiān wǒ xiān chī fàn， rán hòu zuò chū zū chē huí jiā。 yīn wèi xià yǔ， suǒ yǐ huí jiā hěn wǎn， dàn shì wǒ hěn gāo xìng。",
          "translation": {
            "fr": "Hier, j’ai d’abord mangé puis pris un taxi pour rentrer. Comme il pleuvait, je suis rentré tard, mais je suis content."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l34-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 30
      }
    },
