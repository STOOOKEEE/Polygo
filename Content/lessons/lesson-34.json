    {
      "id": "block-lesson-34-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "今天我们复习什么？",
          "pinyin": "jīn tiān wǒ men fù xí shén me？",
          "translation": {
            "fr": "Que révisons-nous aujourd’hui ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我们复习在家、吃饭和去学校。",
          "pinyin": "wǒ men fù xí zài jiā、 chī fàn hé qù xué xiào。",
          "translation": {
            "fr": "Nous révisons la maison, les repas et l’école."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你能说说昨天的安排吗？",
          "pinyin": "nǐ néng shuō shuō zuó tiān de ān pái ma？",
          "translation": {
            "fr": "Peux-tu parler du programme d’hier ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我先去饭馆，然后去了学校。",
          "pinyin": "wǒ xiān qù fàn guǎn， rán hòu qù le xué xiào。",
          "translation": {
            "fr": "Je suis d’abord allé au restaurant, puis à l’école."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "为什么你回家很晚？",
          "pinyin": "wèi shén me nǐ huí jiā hěn wǎn？",
          "translation": {
            "fr": "Pourquoi es-tu rentré tard ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "因为下雨，所以我坐出租车。现在我懂了。",
          "pinyin": "yīn wèi xià yǔ， suǒ yǐ wǒ zuò chū zū chē。 xiàn zài wǒ dǒng le。",
          "translation": {
            "fr": "Comme il pleuvait, j’ai pris un taxi. Maintenant j’ai compris."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 30
      }
