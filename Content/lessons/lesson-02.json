  "title": {
    "fr": "Dire son nom"
  },
  "summary": {
    "fr": "Demander et dire un nom avec une question courte."
  },
  "estimatedMinutes": 7,
  "objectives": [
    {
      "id": "l2-name-ask",
      "statement": {
        "fr": "Demander le nom d'une personne avec 你叫什么名字？"
      },
      "required": true
    },
    {
      "id": "l2-name-answer",
      "statement": {
        "fr": "Répondre 我叫 + nom et reconnaître 什么 comme mot interrogatif."
      },
      "required": true
    },
    {
      "id": "l2-name-reuse",
      "statement": {
        "fr": "Réutiliser une salutation et une formule de politesse dans un échange."
      },
      "required": true
    },
    {
      "id": "l2-name-write",
      "statement": {
        "fr": "Tracer 我 à partir d'un guide de traits, avec auto-évaluation."
      },
      "required": true
    }
  ],
