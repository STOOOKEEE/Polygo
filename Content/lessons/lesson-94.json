        "vocab-hsk20-309"
      ],
      "metadata": {
        "stage": "observe",
        "skill": "recognition",
        "lessonDay": 90
      }
    },
    {
      "id": "block-lesson-94-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "这九十天你学会了什么？",
          "pinyin": "zhè jiǔ shí tiān nǐ xué huì le shén me?",
          "translation": {
            "fr": "Qu’as-tu appris pendant ces quatre-vingt-dix jours ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我能听懂短对话，也能用地图安排旅行。",
          "pinyin": "wǒ néng tīng dǒng duǎn duì huà, yě néng yòng dì tú ān pái lǚ xíng.",
          "translation": {
            "fr": "Je peux comprendre de courts dialogues et organiser un voyage avec une carte."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "遇到问题时，你会怎么做？",
          "pinyin": "yù dào wèn tí shí, nǐ huì zěn me zuò?",
          "translation": {
            "fr": "Que fais-tu quand tu rencontres un problème ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我会注意信息：先听清楚，再说明办法，最后自己完成。",
          "pinyin": "wǒ huì zhù yì xìn xī: xiān tīng qīng chu, zài shuō míng bàn fǎ, zuì hòu zì jǐ wán chéng.",
          "translation": {
            "fr": "Je fais attention aux informations : j’écoute d’abord clairement, j’explique ensuite la solution et je termine moi-même."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 90
      }
    },
    {
      "id": "block-lesson-94-reading",
      "storyID": "story-lesson-94",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une tâche pour conclure"
      },
      "paragraphs": [
        {
          "id": "lesson-94-p1",
          "hanzi": "在最后一天，Tao听一段对话，读一张地图，再回答问题。",
          "pinyin": "zài zuì hòu yì tiān, Tao tīng yí duàn duì huà, dú yì zhāng dì tú, zài huí dá wèn tí.",
          "translation": {
            "fr": "Le dernier jour, Tao écoute un dialogue, lit une carte, puis répond aux questions."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-94-p2",
          "hanzi": "他遇到困难时先检查信息，再说明办法，最后自己完成任务。",
          "pinyin": "tā yù dào kùn nán shí xiān jiǎn chá xìn xī, zài shuō míng bàn fǎ, zuì hòu zì jǐ wán chéng rèn wù.",
          "translation": {
            "fr": "Quand il rencontre une difficulté, il vérifie d’abord les informations, explique ensuite la solution et termine la tâche lui-même."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l94-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 90
      }
    },
