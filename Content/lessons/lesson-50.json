  "blocks": [
    {
      "kind": "introduction",
      "id": "block-lesson-50-grammar-01",
      "title": {
        "fr": "Grammaire — 把 + objet + verbe"
      },
      "body": {
        "fr": "把 place l’objet avant l’action et met en relief ce qu’on en fait.\nExemple 1 : 我把水放在桌上。\nwǒ bǎ shuǐ fàng zài zhuō shàng.\nJe pose l’eau sur la table."
      },
      "metadata": {
        "stage": "introduce",
        "skill": "recognition",
        "lessonDay": 46
      }
    },
