    {
      "id": "block-lesson-50-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你跑步以后，腿还疼吗？",
          "pinyin": "nǐ pǎo bù yǐ hòu, tuǐ hái téng ma?",
          "translation": {
            "fr": "Après ta course, ta jambe te fait encore mal ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好多了。我先刷牙，再洗脸。",
          "pinyin": "hǎo duō le. wǒ xiān shuā yá, zài xǐ liǎn.",
          "translation": {
            "fr": "Ça va beaucoup mieux. Je me brosse d’abord les dents, puis je me lave le visage."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你的头发也湿了，先休息吧。",
          "pinyin": "nǐ de tóu fa yě shī le, xiān xiū xi ba.",
          "translation": {
            "fr": "Tes cheveux sont aussi mouillés, repose-toi d’abord."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "谢谢你帮忙，我会照顾好自己。",
          "pinyin": "xiè xie nǐ bāng máng, wǒ huì zhào gù hǎo zì jǐ.",
          "translation": {
            "fr": "Merci de m’aider, je vais bien prendre soin de moi."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 46
      }
    },
    {
      "id": "block-lesson-50-reading",
      "storyID": "story-lesson-50",
      "level": "HSK classique 2",
      "title": {
        "fr": "Une routine après la course"
      },
      "paragraphs": [
        {
          "id": "lesson-50-p1",
          "hanzi": "跑步以后，Tao的腿有一点疼。",
          "pinyin": "pǎo bù yǐ hòu, Tao de tuǐ yǒu yì diǎn téng.",
          "translation": {
            "fr": "Après avoir couru, la jambe de Tao lui fait un peu mal."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-50-p2",
          "hanzi": "他把水放在桌上，刷牙、洗脸，然后休息。",
          "pinyin": "tā bǎ shuǐ fàng zài zhuō shàng, shuā yá, xǐ liǎn, rán hòu xiū xi.",
          "translation": {
            "fr": "Il pose l’eau sur la table, se brosse les dents, se lave le visage, puis se repose."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l50-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 46
      }
    },
