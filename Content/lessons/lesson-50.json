    {
      "id": "block-lesson-50-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "今天我们跑步了，你身体怎么样？",
          "pinyin": "jīn tiān wǒ men pǎo bù le, nǐ shēn tǐ zěn me yàng?",
          "translation": {
            "fr": "On a couru aujourd’hui, comment tu te sens ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我很热，想喝水。",
          "pinyin": "wǒ hěn rè, xiǎng hē shuǐ.",
          "translation": {
            "fr": "J’ai très chaud, je voudrais de l’eau."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "水在这里。你坐下休息吧。",
          "pinyin": "shuǐ zài zhè lǐ. nǐ zuò xià xiū xī ba.",
          "translation": {
            "fr": "Voilà l’eau. Assieds-toi et repose-toi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "谢谢！我们跑步多长时间了？",
          "pinyin": "xiè xie! wǒ men pǎo bù duō cháng shí jiān le?",
          "translation": {
            "fr": "Merci ! Ça fait combien de temps qu’on court ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "四十分钟，比昨天多。",
          "pinyin": "sì shí fēn zhōng, bǐ zuó tiān duō.",
          "translation": {
            "fr": "Quarante minutes, plus qu’hier."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "明天我们也去跑步，好吗？",
          "pinyin": "míng tiān wǒ men yě qù pǎo bù, hǎo ma?",
          "translation": {
            "fr": "Demain, on va courir aussi, d’accord ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "明天要下雨，可能不能去。",
          "pinyin": "míng tiān yào xià yǔ, kě néng bù néng qù.",
          "translation": {
            "fr": "Demain, il va pleuvoir, on ne pourra peut-être pas y aller."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "没关系。那我想在家洗衣服，你呢？",
          "pinyin": "méi guān xì. nà wǒ xiǎng zài jiā xǐ yī fu, nǐ ne?",
          "translation": {
            "fr": "Ce n’est pas grave. Alors moi, je vais laver des vêtements à la maison, et toi ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我在家休息，看电视。",
          "pinyin": "wǒ zài jiā xiū xī, kàn diàn shì.",
          "translation": {
            "fr": "Moi, je me repose à la maison et je regarde la télé."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好吧，今天我们都早点睡觉。",
          "pinyin": "hǎo ba, jīn tiān wǒ men dōu zǎo diǎn shuì jiào.",
          "translation": {
            "fr": "D’accord, aujourd’hui on se couche tous les deux tôt."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 46
      }
    },
    {
      "id": "block-lesson-50-reading",
      "storyID": "story-lesson-50",
      "level": "HSK classique 2",
      "title": {
        "fr": "Une journée sportive"
      },
      "paragraphs": [
        {
          "id": "lesson-50-p1",
          "hanzi": "我喜欢跑步。今天上午我跑步，时间很长，有四十分钟。到家，我洗了衣服，喝了很多水。",
          "pinyin": "wǒ xǐ huān pǎo bù. jīn tiān shàng wǔ wǒ pǎo bù, shí jiān hěn cháng, yǒu sì shí fēn zhōng. dào jiā, wǒ xǐ le yī fu, hē le hěn duō shuǐ.",
          "translation": {
            "fr": "J’aime courir. Ce matin, j’ai couru longtemps : quarante minutes. Arrivé à la maison, j’ai lavé mes vêtements et bu beaucoup d’eau."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-50-p2",
          "hanzi": "下午我在家休息。朋友打电话来，想明天一起去看电影。",
          "pinyin": "xià wǔ wǒ zài jiā xiū xī. péng yǒu dǎ diàn huà lái, xiǎng míng tiān yì qǐ qù kàn diàn yǐng.",
          "translation": {
            "fr": "L’après-midi, je me repose à la maison. Un ami m’appelle : il voudrait aller voir un film avec moi demain."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l50-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 46
      }
    },
