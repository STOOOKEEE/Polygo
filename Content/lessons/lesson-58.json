    {
      "id": "block-lesson-58-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你要吃蛋糕吗？",
          "pinyin": "nǐ yào chī dàn gāo ma?",
          "translation": {
            "fr": "Tu veux manger du gâteau ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "虽然蛋糕很甜，但是我只喝果汁。",
          "pinyin": "suī rán dàn gāo hěn tián, dàn shì wǒ zhǐ hē guǒ zhī.",
          "translation": {
            "fr": "Même si le gâteau est sucré, je ne bois que du jus de fruit."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "用筷子吃饭要小心，别碰到盘子。",
          "pinyin": "yòng kuài zi chī fàn yào xiǎo xīn, bié pèng dào pán zi.",
          "translation": {
            "fr": "Fais attention en mangeant avec les baguettes, ne touche pas l’assiette."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "这两杯果汁的味道相同。",
          "pinyin": "zhè liǎng bēi guǒ zhī de wèi dào xiāng tóng.",
          "translation": {
            "fr": "Le goût de ces deux jus est identique."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 54
      }
    },
    {
      "id": "block-lesson-58-reading",
      "storyID": "story-lesson-58",
      "level": "HSK classique 3",
      "title": {
        "fr": "Choisir une boisson"
      },
      "paragraphs": [
        {
          "id": "lesson-58-p1",
          "hanzi": "桌上有蛋糕和果汁，Tao选择了果汁。",
          "pinyin": "zhuō shàng yǒu dàn gāo hé guǒ zhī, Tao xuǎn zé le guǒ zhī.",
          "translation": {
            "fr": "Il y a du gâteau et du jus sur la table ; Tao choisit le jus."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-58-p2",
          "hanzi": "他用筷子吃了一点饭，小心地没有碰倒盘子。",
          "pinyin": "tā yòng kuài zi chī le yì diǎn fàn, xiǎo xīn de méi yǒu pèng dǎo pán zi.",
          "translation": {
            "fr": "Il mange un peu de riz avec des baguettes et fait attention à ne pas renverser l’assiette."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l58-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 54
      }
