      },
      "paragraphs": [
        {
          "id": "lesson-82-p1",
          "hanzi": "Tao认为活动很好，因为大家都很热情。",
          "pinyin": "Tao rèn wéi huó dòng hěn hǎo, yīn wèi dà jiā dōu hěn rè qíng.",
          "translation": {
            "fr": "Tao trouve l’activité très bien parce que tout le monde est chaleureux."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-82-p2",
          "hanzi": "如果时间够，他们就一起去公园。",
          "pinyin": "rú guǒ shí jiān gòu, tā men jiù yì qǐ qù gōng yuán.",
          "translation": {
            "fr": "S’ils ont assez de temps, ils iront ensemble au parc."
          },
          "segmentation": [],
          "audio": null
        }
      ],
