    {
      "id": "block-lesson-82-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你认为这个活动怎么样？",
          "pinyin": "nǐ rèn wéi zhè ge huó dòng zěn me yàng?",
          "translation": {
            "fr": "Que penses-tu de cette activité ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我认为很好，大家都很热情。",
          "pinyin": "wǒ rèn wéi hěn hǎo, dà jiā dōu hěn rè qíng.",
          "translation": {
            "fr": "Je la trouve très bien, tout le monde est chaleureux."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "如果时间够，我们就去公园。",
          "pinyin": "rú guǒ shí jiān gòu, wǒ men jiù qù gōng yuán.",
          "translation": {
            "fr": "Si nous avons assez de temps, nous irons au parc."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "可以。我会认真安排路线。",
          "pinyin": "kě yǐ. wǒ huì rèn zhēn ān pái lù xiàn.",
          "translation": {
            "fr": "Oui. Je préparerai l’itinéraire sérieusement."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 78
      }
    },
    {
      "id": "block-lesson-82-reading",
      "storyID": "story-lesson-82",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une proposition après l’activité"
      },
      "paragraphs": [
        {
          "id": "lesson-82-p1",
          "hanzi": "Tao认为活动很好，因为大家都很热情。",
          "pinyin": "Tao rèn wéi huó dòng hěn hǎo, yīn wèi dà jiā dōu hěn rè qíng.",
          "translation": {
            "fr": "Tao trouve l’activité très bien parce que tout le monde est chaleureux."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-82-p2",
          "hanzi": "如果时间够，他们就一起去公园。",
          "pinyin": "rú guǒ shí jiān gòu, tā men jiù yì qǐ qù gōng yuán.",
          "translation": {
            "fr": "S’ils ont assez de temps, ils iront ensemble au parc."
          },
          "segmentation": [],
          "audio": null
        }
      ],
