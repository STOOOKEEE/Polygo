          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "电脑和电视在家。",
          "pinyin": "diàn nǎo hé diàn shì zài jiā.",
          "translation": {
            "fr": "L’ordinateur et la télévision sont à la maison."
