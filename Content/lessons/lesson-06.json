    {
      "id": "block-l6-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你好！明天有汉语，你有书吗？",
          "pinyin": "nǐ hǎo! míng tiān yǒu hàn yǔ, nǐ yǒu shū ma?",
          "translation": {
            "fr": "Salut ! Demain, on a cours de chinois. Tu as ton livre ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有，书在这。你有电脑吗？",
          "pinyin": "yǒu, shū zài zhè. nǐ yǒu diàn nǎo ma?",
          "translation": {
            "fr": "Oui, le voilà. Et toi, tu as ton ordinateur ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我也有，电脑在这。",
          "pinyin": "wǒ yě yǒu, diàn nǎo zài zhè.",
          "translation": {
            "fr": "Moi aussi, il est là."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "书和电脑都在这。你有水吗？",
          "pinyin": "shū hé diàn nǎo dōu zài zhè. nǐ yǒu shuǐ ma?",
          "translation": {
            "fr": "Le livre et l’ordinateur sont là, tout est là. Tu as de l’eau ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "水不在这，茶在这。你喝茶吗？",
          "pinyin": "shuǐ bú zài zhè, chá zài zhè. nǐ hē chá ma?",
          "translation": {
            "fr": "Pas d’eau ici, mais voilà du thé. Tu en bois ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我也喝茶。谢谢！",
          "pinyin": "wǒ yě hē chá. xiè xie!",
          "translation": {
            "fr": "Moi aussi, je bois du thé. Merci !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "不客气。老师明天在吗？",
          "pinyin": "bú kè qi. lǎo shī míng tiān zài ma?",
          "translation": {
            "fr": "De rien. Le professeur sera là demain ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "在，学生都在。再见！",
          "pinyin": "zài, xué shēng dōu zài. zài jiàn!",
          "translation": {
            "fr": "Oui, et tous les élèves aussi. Salut !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 2
      }
    },
    {
      "id": "block-l6-reading",
      "storyID": "story-l6-home",
      "title": {
        "fr": "Un jour sans les parents"
      },
      "paragraphs": [
        {
          "id": "lesson-06-p1",
          "hanzi": "今天爸爸和妈妈都不在，哥哥也不在。我和猫在这，电脑也在这。猫喝水，我喝茶。",
          "pinyin": "jīn tiān bà ba hé mā ma dōu bú zài, gē ge yě bú zài. wǒ hé māo zài zhè, diàn nǎo yě zài zhè. māo hē shuǐ, wǒ hē chá.",
          "translation": {
            "fr": "Aujourd’hui, papa et maman ne sont pas là, mon grand frère non plus. Le chat et moi, nous sommes ici, et l’ordinateur aussi. Le chat boit de l’eau, moi je bois du thé."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-06-p2",
          "hanzi": "我是学生，明天有汉语。电脑和书都在这，我知道！",
          "pinyin": "wǒ shì xué shēng, míng tiān yǒu hàn yǔ. diàn nǎo hé shū dōu zài zhè, wǒ zhī dào!",
          "translation": {
            "fr": "Je suis étudiante et demain j’ai cours de chinois. L’ordinateur et le livre sont bien là, je le sais !"
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l6-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 2
      }
    },
