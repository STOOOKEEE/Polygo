    {
      "id": "block-lesson-83-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你听得见我的声音吗？",
          "pinyin": "nǐ tīng de jiàn wǒ de shēng yīn ma?",
          "translation": {
            "fr": "Entends-tu ma voix ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "声音太小，我先上网检查。",
          "pinyin": "shēng yīn tài xiǎo, wǒ xiān shàng wǎng jiǎn chá.",
          "translation": {
            "fr": "Le son est trop faible, je vais d’abord vérifier en ligne."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这次调整会使通话更清楚。",
          "pinyin": "zhè cì tiáo zhěng huì shǐ tōng huà gèng qīng chu.",
          "translation": {
            "fr": "Cet ajustement rendra l’appel plus clair."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好了。你穿哪一双鞋？",
          "pinyin": "hǎo le. nǐ chuān nǎ yì shuāng xié?",
          "translation": {
            "fr": "C’est bon. Quelle paire de chaussures portes-tu ?"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 79
      }
    },
    {
      "id": "block-lesson-83-reading",
      "storyID": "story-lesson-83",
      "level": "HSK classique 3",
      "title": {
        "fr": "Un son trop faible"
      },
      "paragraphs": [
        {
          "id": "lesson-83-p1",
          "hanzi": "Tao上网检查声音，因为Mina听不清楚。",
          "pinyin": "Tao shàng wǎng jiǎn chá shēng yīn, yīn wèi Mina tīng bù qīng chu.",
          "translation": {
            "fr": "Tao vérifie le son en ligne parce que Mina n’entend pas clairement."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-83-p2",
          "hanzi": "调整以后，通话更清楚，两个人可以继续说话。",
          "pinyin": "tiáo zhěng yǐ hòu, tōng huà gèng qīng chu, liǎng ge rén kě yǐ jì xù shuō huà.",
          "translation": {
            "fr": "Après l’ajustement, l’appel est plus clair et les deux personnes peuvent continuer à parler."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l83-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 79
      }
    },
