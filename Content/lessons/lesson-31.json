    {
      "id": "block-lesson-31-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你可以送饭到外面吗？",
          "pinyin": "nǐ kě yǐ sòng fàn dào wài miàn ma？",
          "translation": {
            "fr": "Peux-tu livrer le repas dehors ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "可以，请问你要什么？",
          "pinyin": "kě yǐ， qǐng wèn nǐ yào shén me？",
          "translation": {
            "fr": "Oui, que veux-tu ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我要新菜，还希望有水果。",
          "pinyin": "wǒ yào xīn cài， hái xī wàng yǒu shuǐ guǒ。",
          "translation": {
            "fr": "Je veux un nouveau plat et j’espère qu’il y aura des fruits."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "请告诉我地址，我马上送。",
          "pinyin": "qǐng gào sù wǒ dì zhǐ， wǒ mǎ shàng sòng。",
          "translation": {
            "fr": "Dis-moi l’adresse, je livre tout de suite."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "地址在学校左边。洗手间在里面。",
          "pinyin": "dì zhǐ zài xué xiào zuǒ biān。 xǐ shǒu jiān zài lǐ miàn。",
          "translation": {
            "fr": "L’adresse est à gauche de l’école. Les toilettes sont à l’intérieur."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，事情做完以后我们笑一笑。",
          "pinyin": "hǎo， shì qíng zuò wán yǐ hòu wǒ men xiào yī xiào。",
          "translation": {
            "fr": "D’accord, après cette tâche nous sourirons un peu."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 27
      }
    },
    {
      "id": "block-lesson-31-reading",
      "storyID": "story-lesson-31",
      "level": "HSK classique 2",
      "title": {
        "fr": "La livraison"
      },
      "paragraphs": [
        {
          "id": "lesson-31-p1",
          "hanzi": "餐馆准备了新菜和水果。服务员问客人的地址，然后把饭送到外面。",
          "pinyin": "cān guǎn zhǔn bèi le xīn cài hé shuǐ guǒ。 fú wù yuán wèn kè rén de dì zhǐ， rán hòu bǎ fàn sòng dào wài miàn。",
          "translation": {
            "fr": "Le restaurant prépare un nouveau plat et des fruits. Le serveur demande l’adresse du client puis livre le repas dehors."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-31-p2",
          "hanzi": "地址在学校左边。客人洗手以后开始吃饭，大家都笑了。",
          "pinyin": "dì zhǐ zài xué xiào zuǒ biān。 kè rén xǐ shǒu yǐ hòu kāi shǐ chī fàn， dà jiā dōu xiào le。",
          "translation": {
            "fr": "L’adresse est à gauche de l’école. Après s’être lavé les mains, le client commence à manger et tout le monde sourit."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l31-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 27
      }
    },
