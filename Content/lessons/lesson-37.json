    {
      "id": "block-lesson-37-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你的鼻子和耳朵怎么样？",
          "pinyin": "nǐ de bí zi hé ěr duǒ zěn me yàng？",
          "translation": {
            "fr": "Comment vont ton nez et tes oreilles ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "鼻子不舒服，耳朵也有一点疼。",
          "pinyin": "bí zi bù shū fú， ěr duǒ yě yǒu yì diǎn téng。",
          "translation": {
            "fr": "Mon nez est gênant et j’ai aussi un peu mal aux oreilles."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你发烧了吗？",
          "pinyin": "nǐ fā shāo le ma？",
          "translation": {
            "fr": "As-tu de la fièvre ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "发烧了，还感冒。",
          "pinyin": "fā shāo le， hái gǎn mào。",
          "translation": {
            "fr": "Oui, et je suis enrhumé."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "医生说你健康吗？",
          "pinyin": "yī shēng shuō nǐ jiàn kāng ma？",
          "translation": {
            "fr": "Le médecin dit-il que tu es en bonne santé ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "他说休息以后会好，我的脚也不疼了。",
          "pinyin": "tā shuō xiū xī yǐ hòu huì hǎo， wǒ de jiǎo yě bù téng le。",
          "translation": {
            "fr": "Il dit que j’irai mieux après du repos ; mon pied ne me fait plus mal non plus."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 33
      }
    },
    {
      "id": "block-lesson-37-reading",
      "storyID": "story-lesson-37",
      "level": "HSK classique 3",
      "title": {
        "fr": "Chez le médecin"
      },
      "paragraphs": [
        {
          "id": "lesson-37-p1",
          "hanzi": "Tao感冒发烧，鼻子和耳朵不舒服，所以去看医生。",
          "pinyin": "Tao gǎn mào fā shāo， bí zi hé ěr duǒ bù shū fú， suǒ yǐ qù kàn yī shēng。",
          "translation": {
            "fr": "Tao est enrhumé et fiévreux ; son nez et ses oreilles le gênent, alors il va voir le médecin."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-37-p2",
          "hanzi": "医生检查他的身体和脚，让他回家休息。明天他应该更健康。",
          "pinyin": "yī shēng jiǎn chá tā de shēn tǐ hé jiǎo， ràng tā huí jiā xiū xī。 míng tiān tā yīng gāi gèng jiàn kāng。",
          "translation": {
            "fr": "Le médecin examine son corps et son pied et lui demande de rentrer se reposer. Demain, il devrait être en meilleure santé."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l37-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 33
      }
    },
