    {
      "id": "block-lesson-37-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你好！你现在去哪里？",
          "pinyin": "nǐ hǎo! nǐ xiàn zài qù nǎ lǐ?",
          "translation": {
            "fr": "Salut ! Où vas-tu comme ça ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我去医院。朋友的儿子生病了。",
          "pinyin": "wǒ qù yī yuàn. péng yǒu de ér zi shēng bìng le.",
          "translation": {
            "fr": "Je vais à l’hôpital. Le fils d’un ami est malade."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "他怎么样？他吃米饭了吗？",
          "pinyin": "tā zěn me yàng? tā chī mǐ fàn le ma?",
          "translation": {
            "fr": "Comment va-t-il ? Il a mangé du riz ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "没有，他不吃米饭，也不喝水。",
          "pinyin": "méi yǒu, tā bù chī mǐ fàn, yě bù hē shuǐ.",
          "translation": {
            "fr": "Non, il ne mange pas de riz et ne boit pas d’eau."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你打电话了吗？医生知道吗？",
          "pinyin": "nǐ dǎ diàn huà le ma? yī shēng zhī dào ma?",
          "translation": {
            "fr": "Tu as téléphoné ? Le médecin est au courant ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "知道，我打电话了。医生五点在医院。",
          "pinyin": "zhī dào, wǒ dǎ diàn huà le. yī shēng wǔ diǎn zài yī yuàn.",
          "translation": {
            "fr": "Oui, j’ai téléphoné. Le médecin est à l’hôpital à cinq heures."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "现在四点。我也去，好吗？",
          "pinyin": "xiàn zài sì diǎn. wǒ yě qù, hǎo ma?",
          "translation": {
            "fr": "Il est quatre heures. Je viens aussi, d’accord ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好！我们坐出租车去。",
          "pinyin": "hǎo! wǒ men zuò chū zū chē qù.",
          "translation": {
            "fr": "D’accord ! On y va en taxi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "希望他没问题。",
          "pinyin": "xī wàng tā méi wèn tí.",
          "translation": {
            "fr": "J’espère qu’il n’a rien de grave."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "谢谢你！我们现在去。",
          "pinyin": "xiè xie nǐ! wǒ men xiàn zài qù.",
          "translation": {
            "fr": "Merci ! Allons-y maintenant."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 33
      }
    },
    {
      "id": "block-lesson-37-reading",
      "storyID": "story-lesson-37",
      "level": "HSK classique 1",
      "title": {
        "fr": "Un ami malade"
      },
      "paragraphs": [
        {
          "id": "lesson-37-p1",
          "hanzi": "我们的朋友有一个儿子。今天他生病了，不吃米饭，也不喝水。",
          "pinyin": "wǒ men de péng yǒu yǒu yí gè ér zi. jīn tiān tā shēng bìng le, bù chī mǐ fàn, yě bù hē shuǐ.",
          "translation": {
            "fr": "Notre ami a un fils. Aujourd’hui, il est tombé malade : il ne mange pas de riz et ne boit pas d’eau."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-37-p2",
          "hanzi": "朋友打电话，五点我们在医院。医生看了他的身体，没有问题。现在他怎么样？他吃米饭了，很高兴。",
          "pinyin": "péng yǒu dǎ diàn huà, wǔ diǎn wǒ men zài yī yuàn. yī shēng kàn le tā de shēn tǐ, méi yǒu wèn tí. xiàn zài tā zěn me yàng? tā chī mǐ fàn le, hěn gāo xìng.",
          "translation": {
            "fr": "Notre ami a téléphoné, et à cinq heures nous étions à l’hôpital. Le médecin a examiné le petit : ce n’est pas grave. Et maintenant, comment va-t-il ? Il a mangé du riz et il est content."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l37-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 33
      }
    },
