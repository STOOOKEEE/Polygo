    {
      "id": "block-lesson-33-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "今天是晴天还是阴天？",
          "pinyin": "jīn tiān shì qíng tiān hái shì yīn tiān？",
          "translation": {
            "fr": "Aujourd’hui, le ciel est-il dégagé ou couvert ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "早上是晴天，下午可能下雪。",
          "pinyin": "zǎo shàng shì qíng tiān， xià wǔ kě néng xià xuě。",
          "translation": {
            "fr": "Le matin, le ciel est dégagé, mais il pourrait neiger l’après-midi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我准备去城市左边的公园。",
          "pinyin": "wǒ zhǔn bèi qù chéng shì zuǒ biān de gōng yuán。",
          "translation": {
            "fr": "Je me prépare à aller au parc à gauche de la ville."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "因为天气会变，所以我们先回家。",
          "pinyin": "yīn wèi tiān qì huì biàn， suǒ yǐ wǒ men xiān huí jiā。",
          "translation": {
            "fr": "Comme le temps va changer, rentrons d’abord à la maison."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那只狗是谁的？",
          "pinyin": "nà zhǐ gǒu shì shéi de？",
          "translation": {
            "fr": "À qui est ce chien ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不知道。最重要的是先走左边。",
          "pinyin": "bù zhī dào。 zuì zhòng yào de shì xiān zǒu zuǒ biān。",
          "translation": {
            "fr": "Je ne sais pas. Le plus important est de prendre d’abord à gauche."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 29
      }
    },
    {
      "id": "block-lesson-33-reading",
      "storyID": "story-lesson-33",
      "level": "HSK classique 2",
      "title": {
        "fr": "La météo en ville"
      },
      "paragraphs": [
        {
          "id": "lesson-33-p1",
          "hanzi": "早上是晴天，下午的天气可能变成阴天或下雪。",
          "pinyin": "zǎo shàng shì qíng tiān， xià wǔ de tiān qì kě néng biàn chéng yīn tiān huò xià xuě。",
          "translation": {
            "fr": "Le matin, le ciel est dégagé ; l’après-midi, le temps pourrait devenir couvert ou neigeux."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-33-p2",
          "hanzi": "我们准备去左边的公园。因为天气不好，所以先回家，晚上再出门。",
          "pinyin": "wǒ men zhǔn bèi qù zuǒ biān de gōng yuán。 yīn wèi tiān qì bù hǎo， suǒ yǐ xiān huí jiā， wǎn shàng zài chū mén。",
          "translation": {
            "fr": "Nous nous préparons à aller au parc à gauche. Comme le temps est mauvais, nous rentrons d’abord à la maison et ressortons le soir."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l33-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 29
      }
    },
