    {
      "id": "block-lesson-36-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "你知道吗？An住在北京。",
          "pinyin": "nǐ zhī dào ma? An zhù zài běi jīng.",
          "translation": {
            "fr": "Tu savais ? An habite à Pékin."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "不知道！An，北京大吗？",
          "pinyin": "bù zhī dào! An, běi jīng dà ma?",
          "translation": {
            "fr": "Non ! An, Pékin, c’est grand ?"
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "很大，人也很多。你去过北京吗？",
          "pinyin": "hěn dà, rén yě hěn duō. nǐ qù guo běi jīng ma?",
          "translation": {
            "fr": "Très grand, et il y a beaucoup de monde. Tu es déjà allée à Pékin ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "没去过，我想去！你现在在这里，住在哪里？",
          "pinyin": "méi qù guo, wǒ xiǎng qù! nǐ xiàn zài zài zhè lǐ, zhù zài nǎ lǐ?",
          "translation": {
            "fr": "Jamais ! J’ai très envie d’y aller. Et ici, tu loges où ?"
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "我现在住在朋友家里。你买了什么？",
          "pinyin": "wǒ xiàn zài zhù zài péng yǒu jiā lǐ. nǐ mǎi le shén me?",
          "translation": {
            "fr": "En ce moment, je loge chez un ami. Tu as acheté quoi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "五个苹果和一本汉语书。你吃苹果吗？",
          "pinyin": "wǔ gè píng guǒ hé yì běn hàn yǔ shū. nǐ chī píng guǒ ma?",
          "translation": {
            "fr": "Cinq pommes et un livre de chinois. Tu manges des pommes ?"
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "吃！我喜欢苹果。书我能看看吗？",
          "pinyin": "chī! wǒ xǐ huān píng guǒ. shū wǒ néng kàn kan ma?",
          "translation": {
            "fr": "Oui ! J’adore les pommes. Je peux regarder le livre ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "可以！这本书是老师送我的。",
          "pinyin": "kě yǐ! zhè běn shū shì lǎo shī sòng wǒ de.",
          "translation": {
            "fr": "Bien sûr ! C’est mon professeur qui me l’a offert."
          },
          "audio": null
        },
        {
          "speaker": "An",
          "hanzi": "你想去北京，我可以帮助你。",
          "pinyin": "nǐ xiǎng qù běi jīng, wǒ kě yǐ bāng zhù nǐ.",
          "translation": {
            "fr": "Si tu veux aller à Pékin, je peux t’aider."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "谢谢！我会去北京的！",
          "pinyin": "xiè xie! wǒ huì qù běi jīng de!",
          "translation": {
            "fr": "Merci ! J’irai à Pékin, c’est sûr !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 32
      }
    },
    {
