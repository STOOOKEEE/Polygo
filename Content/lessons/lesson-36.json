    {
      "id": "block-lesson-36-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你知道邻居要结婚吗？",
          "pinyin": "nǐ zhī dào lín jū yào jié hūn ma？",
          "translation": {
            "fr": "Sais-tu que le voisin va se marier ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "知道。阿姨和叔叔也要来。",
          "pinyin": "zhī dào。 ā yí hé shū shū yě yào lái。",
          "translation": {
            "fr": "Oui. La tante et l’oncle vont venir aussi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "奶奶是今天的客人吗？",
          "pinyin": "nǎi nǎi shì jīn tiān de kè rén ma？",
          "translation": {
            "fr": "La grand-mère est-elle l’invitée d’aujourd’hui ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，她和很多客人一起坐。",
          "pinyin": "shì， tā hé hěn duō kè rén yì qǐ zuò。",
          "translation": {
            "fr": "Oui, elle s’assoit avec beaucoup d’invités."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你会帮助邻居吗？",
          "pinyin": "nǐ huì bāng zhù lín jū ma？",
          "translation": {
            "fr": "Vas-tu aider le voisin ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "会。结婚以后，他们住在这座楼里。",
          "pinyin": "huì。 jié hūn yǐ hòu， tā men zhù zài zhè zuò lóu lǐ。",
          "translation": {
            "fr": "Oui. Après le mariage, ils habiteront dans cet immeuble."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 32
      }
    },
    {
      "id": "block-lesson-36-reading",
      "storyID": "story-lesson-36",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une fête"
      },
      "paragraphs": [
        {
          "id": "lesson-36-p1",
          "hanzi": "邻居结婚，阿姨、叔叔和奶奶都来参加。",
          "pinyin": "lín jū jié hūn， ā yí、 shū shū hé nǎi nǎi dōu lái cān jiā。",
          "translation": {
            "fr": "Le voisin se marie ; la tante, l’oncle et la grand-mère participent tous à la fête."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-36-p2",
          "hanzi": "客人们坐在一起。婚礼以后，新人住在附近的楼里。",
          "pinyin": "kè rén men zuò zài yì qǐ。 hūn lǐ yǐ hòu， xīn rén zhù zài fù jìn de lóu lǐ。",
          "translation": {
            "fr": "Les invités s’assoient ensemble. Après le mariage, les jeunes mariés habitent dans un immeuble voisin."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l36-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 32
      }
    },
