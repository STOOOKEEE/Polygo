    {
      "id": "block-lesson-38-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你在哪个班？",
          "pinyin": "nǐ zài nǎ ge bān？",
          "translation": {
            "fr": "Dans quelle classe es-tu ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我在二班，必须复习词语。",
          "pinyin": "wǒ zài èr bān， bì xū fù xí cí yǔ。",
          "translation": {
            "fr": "Je suis dans la classe deux et je dois réviser les mots."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "老师检查句子了吗？",
          "pinyin": "lǎo shī jiǎn chá jù zi le ma？",
          "translation": {
            "fr": "Le professeur a-t-il vérifié les phrases ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "检查了。他说第一句很清楚。",
          "pinyin": "jiǎn chá le。 tā shuō dì yī jù hěn qīng chǔ。",
          "translation": {
            "fr": "Oui. Il a dit que la première phrase était très claire."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你复习完了吗？",
          "pinyin": "nǐ fù xí wán le ma？",
          "translation": {
            "fr": "As-tu fini de réviser ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "还没有，明天考试，我要再读一遍。",
          "pinyin": "hái méi yǒu， míng tiān kǎo shì， wǒ yào zài dú yī biàn。",
          "translation": {
            "fr": "Pas encore ; l’examen est demain, je dois relire encore une fois."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 34
      }
    },
    {
      "id": "block-lesson-38-reading",
      "storyID": "story-lesson-38",
      "level": "HSK classique 3",
      "title": {
        "fr": "Le travail de classe"
      },
      "paragraphs": [
        {
          "id": "lesson-38-p1",
          "hanzi": "二班的学生复习词语，老师检查每个人写的句子。",
          "pinyin": "èr bān de xué shēng fù xí cí yǔ， lǎo shī jiǎn chá měi gè rén xiě de jù zi。",
          "translation": {
            "fr": "Les élèves de la classe deux révisent les mots ; le professeur vérifie les phrases écrites par chacun."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-38-p2",
          "hanzi": "有一个句子不清楚，学生改了以后再读。明天考试，所以大家必须认真。",
          "pinyin": "yǒu yí gè jù zi bù qīng chǔ， xué shēng gǎi le yǐ hòu zài dú。 míng tiān kǎo shì， suǒ yǐ dà jiā bì xū rèn zhēn。",
          "translation": {
            "fr": "Une phrase n’est pas claire ; l’élève la corrige puis la relit. Comme l’examen est demain, tout le monde doit être sérieux."
          },
          "segmentation": [],
          "audio": null
        }
      ],
