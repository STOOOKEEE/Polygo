    {
      "id": "block-lesson-38-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "今天几月几日？老师要我们写。",
          "pinyin": "jīn tiān jǐ yuè jǐ rì? lǎo shī yào wǒ men xiě.",
          "translation": {
            "fr": "On est le combien aujourd’hui ? Le professeur veut qu’on l’écrive."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "今天二月七日。你写了吗？",
          "pinyin": "jīn tiān èr yuè qī rì. nǐ xiě le ma?",
          "translation": {
            "fr": "Aujourd’hui, c’est le 7 février. Tu l’as écrit ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "写了，你看：二月七日，星期一。",
          "pinyin": "xiě le, nǐ kàn: èr yuè qī rì, xīng qī yī.",
          "translation": {
            "fr": "Oui, regarde : 7 février, lundi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "今天不是星期一，是星期二。",
          "pinyin": "jīn tiān bú shì xīng qī yī, shì xīng qī èr.",
          "translation": {
            "fr": "Aujourd’hui, ce n’est pas lundi, c’est mardi."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "对不起，我写了星期一。我不是好学生！",
          "pinyin": "duì bù qǐ, wǒ xiě le xīng qī yī. wǒ bú shì hǎo xué shēng!",
          "translation": {
            "fr": "Pardon, j’ai écrit lundi. Je ne suis pas une bonne élève !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "没关系！学生都有问题。",
          "pinyin": "méi guān xì! xué shēng dōu yǒu wèn tí.",
          "translation": {
            "fr": "Ce n’est pas grave ! Tous les élèves ont des difficultés."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你看，我会写二和七。",
          "pinyin": "nǐ kàn, wǒ huì xiě èr hé qī.",
          "translation": {
            "fr": "Regarde, je sais écrire deux et sept."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "很好看！明天老师看，你会很高兴。",
          "pinyin": "hěn hǎo kàn! míng tiān lǎo shī kàn, nǐ huì hěn gāo xìng.",
          "translation": {
            "fr": "Très joli ! Demain, quand le professeur regardera, tu seras contente."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 34
      }
    },
