    {
      "id": "block-lesson-56-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你饿了吗？",
          "pinyin": "nǐ è le ma?",
          "translation": {
            "fr": "As-tu faim ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "有一点。这个词的作用是什么？",
          "pinyin": "yǒu yì diǎn. zhè ge cí de zuò yòng shì shén me?",
          "translation": {
            "fr": "Un peu. Quel est le rôle de ce mot ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "它使句子更清楚，而且意思越来越自然。",
          "pinyin": "tā shǐ jù zi gèng qīng chu, ér qiě yì si yuè lái yuè zì rán.",
          "translation": {
            "fr": "Il rend la phrase plus claire et le sens devient de plus en plus naturel."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我发现这样说比较好，我们吃饭吧。",
          "pinyin": "wǒ fā xiàn zhè yàng shuō bǐ jiào hǎo, wǒ men chī fàn ba.",
          "translation": {
            "fr": "Je constate que c’est mieux ainsi ; mangeons."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 52
      }
    },
    {
      "id": "block-lesson-56-reading",
      "storyID": "story-lesson-56",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une phrase plus claire"
      },
      "paragraphs": [
        {
          "id": "lesson-56-p1",
          "hanzi": "Tao有一点饿，但是他先问一个词的作用。",
          "pinyin": "Tao yǒu yì diǎn è, dàn shì tā xiān wèn yí ge cí de zuò yòng.",
          "translation": {
            "fr": "Tao a un peu faim, mais il demande d’abord le rôle d’un mot."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-56-p2",
          "hanzi": "Mina解释以后，句子的意思越来越清楚。",
          "pinyin": "Mina jiě shì yǐ hòu, jù zi de yì si yuè lái yuè qīng chu.",
          "translation": {
            "fr": "Après l’explication de Mina, le sens de la phrase devient de plus en plus clair."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l56-reading"
      ],
      "kind": "reading",
      "metadata": {
