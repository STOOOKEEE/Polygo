  "grammarPoints": [
    {
      "id": "gram-bu-mei",
      "pattern": "不 + verbe ; 没(有) + verbe",
      "function": "不 ou 没 : deux façons de dire non",
      "markers": [
        "不",
        "没"
      ],
      "errors": [
        "Ne dis jamais 不有 : 有 se nie toujours avec 没 (我没有鱼). Pour « je n’ai pas acheté », dis 没买 : 不买 veut dire « je n’achète pas » ou « je n’achèterai pas »."
      ]
    }
  ]
