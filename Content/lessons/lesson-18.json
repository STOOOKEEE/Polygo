    {
      "id": "block-lesson-18-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你的猫在哪里？",
          "pinyin": "nǐ de māo zài nǎ lǐ？",
          "translation": {
            "fr": "Où est ton chat ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "它在房间里，不在门前面。",
          "pinyin": "tā zài fáng jiān lǐ， bù zài mén qián miàn。",
          "translation": {
            "fr": "Il est dans la chambre, pas devant la porte."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那只猫刚才出来了吗？",
          "pinyin": "nà zhǐ māo gāng cái chū lái le ma？",
          "translation": {
            "fr": "Ce chat est-il sorti tout à l’heure ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "它出来了，现在在桌子后面。",
          "pinyin": "tā chū lái le， xiàn zài zài zhuō zi hòu miàn。",
          "translation": {
            "fr": "Il est sorti ; maintenant il est derrière la table."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你能找到它吗？",
          "pinyin": "nǐ néng zhǎo dào tā ma？",
          "translation": {
            "fr": "Peux-tu le trouver ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "能。没关系，我马上把它带回家。",
          "pinyin": "néng。 méi guān xì， wǒ mǎ shàng bǎ tā dài huí jiā。",
          "translation": {
            "fr": "Oui. Ce n’est pas grave, je le ramène tout de suite à la maison."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 14
      }
    },
    {
      "id": "block-lesson-18-reading",
      "storyID": "story-lesson-18",
      "level": "HSK classique 1",
      "title": {
        "fr": "Où est le chat ?"
      },
      "paragraphs": [
        {
          "id": "lesson-18-p1",
          "hanzi": "我的猫在房间里。它刚才在门前面，现在到了桌子后面。",
          "pinyin": "wǒ de māo zài fáng jiān lǐ。 tā gāng cái zài mén qián miàn， xiàn zài dào le zhuō zi hòu miàn。",
          "translation": {
            "fr": "Mon chat est dans la chambre. Il était devant la porte tout à l’heure ; il est maintenant derrière la table."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-18-p2",
          "hanzi": "我没有找到它，所以请朋友帮忙。朋友说：没关系，它在这里。",
          "pinyin": "wǒ méi yǒu zhǎo dào tā， suǒ yǐ qǐng péng yǒu bāng máng。 péng yǒu shuō： méi guān xì， tā zài zhè lǐ。",
          "translation": {
            "fr": "Je ne l’ai pas trouvé, alors je demande de l’aide à un ami. L’ami dit : ce n’est pas grave, il est ici."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l18-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 14
      }
    },
