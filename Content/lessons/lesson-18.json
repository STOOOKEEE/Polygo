    {
      "id": "block-lesson-18-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "请你来我家！我的猫没在家里。",
          "pinyin": "qǐng nǐ lái wǒ jiā! wǒ de māo méi zài jiā lǐ.",
          "translation": {
            "fr": "Viens chez moi, s’il te plaît ! Mon chat n’est pas à la maison."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你去过门那里吗？",
          "pinyin": "nǐ qù guo mén nà lǐ ma?",
          "translation": {
            "fr": "Tu es déjà allée près de la porte ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "去过了。家里没有，门那里也没有。",
          "pinyin": "qù guo le. jiā lǐ méi yǒu, mén nà lǐ yě méi yǒu.",
          "translation": {
            "fr": "Oui, j’y suis allée. Il n’est pas dans la maison, ni près de la porte."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "猫吃鱼吗？你有鱼吗？",
          "pinyin": "māo chī yú ma? nǐ yǒu yú ma?",
          "translation": {
            "fr": "Il mange du poisson, ton chat ? Tu en as ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "有！我今天买了鱼。",
          "pinyin": "yǒu! wǒ jīn tiān mǎi le yú.",
          "translation": {
            "fr": "Oui ! J’en ai acheté aujourd’hui."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我们去门那里，请猫来吃鱼。",
          "pinyin": "wǒ men qù mén nà lǐ, qǐng māo lái chī yú.",
          "translation": {
            "fr": "Allons près de la porte, et invitons le chat à venir manger du poisson."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "猫！请来吃鱼！",
          "pinyin": "māo! qǐng lái chī yú!",
          "translation": {
            "fr": "Minou ! Viens manger du poisson !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "那里！猫在那里！",
          "pinyin": "nà lǐ! māo zài nà lǐ!",
          "translation": {
            "fr": "Là ! Il est là-bas !"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "猫来吃鱼了！谢谢你，Tao！",
          "pinyin": "māo lái chī yú le! xiè xie nǐ, Tao!",
          "translation": {
            "fr": "Le chat vient manger le poisson ! Merci, Tao !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不客气！你的猫吃很多鱼。",
          "pinyin": "bú kè qi! nǐ de māo chī hěn duō yú.",
          "translation": {
            "fr": "De rien ! Ton chat mange beaucoup de poisson."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 14
      }
    },
    {
      "id": "block-lesson-18-reading",
      "storyID": "story-lesson-18",
      "level": "HSK classique 1",
      "title": {
        "fr": "Un chien et un chat"
      },
      "paragraphs": [
        {
          "id": "lesson-18-p1",
          "hanzi": "我家有猫，也有狗。狗大，猫小，狗在门那里，猫在家里。",
          "pinyin": "wǒ jiā yǒu māo, yě yǒu gǒu. gǒu dà, māo xiǎo, gǒu zài mén nà lǐ, māo zài jiā lǐ.",
          "translation": {
            "fr": "Chez moi, il y a un chat et aussi un chien. Le chien est grand, le chat est petit ; le chien est près de la porte et le chat est dans la maison."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-18-p2",
          "hanzi": "我的朋友没去过我家。明天我请他来我家吃鱼。狗和猫也都想吃鱼！",
          "pinyin": "wǒ de péng you méi qù guo wǒ jiā. míng tiān wǒ qǐng tā lái wǒ jiā chī yú. gǒu hé māo yě dōu xiǎng chī yú!",
          "translation": {
            "fr": "Mon ami n’est jamais venu chez moi. Demain, je l’invite à venir manger du poisson. Le chien et le chat en veulent aussi !"
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l18-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 14
      }
