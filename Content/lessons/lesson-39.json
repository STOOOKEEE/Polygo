    {
      "id": "block-lesson-39-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你明天上午有时间吗？",
          "pinyin": "nǐ míng tiān shàng wǔ yǒu shí jiān ma?",
          "translation": {
            "fr": "Tu as du temps demain matin ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "上午我八点开会。有什么问题吗？",
          "pinyin": "shàng wǔ wǒ bā diǎn kāi huì. yǒu shén me wèn tí ma?",
          "translation": {
            "fr": "Demain matin, j’ai une réunion à huit heures. Il y a un souci ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "没有。会开多长时间？",
          "pinyin": "méi yǒu. huì kāi duō zhǎng shí jiān?",
          "translation": {
            "fr": "Non. Elle dure combien de temps, ta réunion ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "五十分钟。九点我有时间。",
          "pinyin": "wǔ shí fēn zhōng. jiǔ diǎn wǒ yǒu shí jiān.",
          "translation": {
            "fr": "Cinquante minutes. À neuf heures, je suis libre."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "太好了！下午我要去学校，上午来你家可以吗？",
          "pinyin": "tài hǎo le! xià wǔ wǒ yào qù xué xiào, shàng wǔ lái nǐ jiā kě yǐ ma?",
          "translation": {
            "fr": "Super ! L’après-midi, je dois aller à l’école : je peux passer chez toi le matin ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "可以！你九点来，我开门。",
          "pinyin": "kě yǐ! nǐ jiǔ diǎn lái, wǒ kāi mén.",
          "translation": {
            "fr": "Bien sûr ! Viens à neuf heures, je t’ouvrirai la porte."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我买苹果去你家，你喜欢吗？",
          "pinyin": "wǒ mǎi píng guǒ qù nǐ jiā, nǐ xǐ huān ma?",
          "translation": {
            "fr": "J’apporterai des pommes chez toi, tu aimes ça ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "喜欢！我也有茶。",
          "pinyin": "xǐ huān! wǒ yě yǒu chá.",
          "translation": {
            "fr": "Oui ! Moi, j’ai du thé."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好！明天九点，再见！",
          "pinyin": "hǎo! míng tiān jiǔ diǎn, zài jiàn!",
          "translation": {
            "fr": "Parfait ! À demain neuf heures, au revoir !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "再见！",
          "pinyin": "zài jiàn!",
          "translation": {
            "fr": "À demain !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 35
      }
    },
    {
      "id": "block-lesson-39-reading",
      "storyID": "story-lesson-39",
      "level": "HSK classique 1",
      "title": {
        "fr": "Un rendez-vous après la réunion"
      },
      "paragraphs": [
        {
          "id": "lesson-39-p1",
          "hanzi": "明天上午，朋友八点开会，开五十分钟。九点我去他家，他开门。",
          "pinyin": "míng tiān shàng wǔ, péng yǒu bā diǎn kāi huì, kāi wǔ shí fēn zhōng. jiǔ diǎn wǒ qù tā jiā, tā kāi mén.",
          "translation": {
            "fr": "Demain matin, mon ami a une réunion à huit heures, qui dure cinquante minutes. À neuf heures, j’irai chez lui et il m’ouvrira la porte."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-39-p2",
          "hanzi": "我买苹果，我们喝茶。下午我去学校。",
          "pinyin": "wǒ mǎi píng guǒ, wǒ men hē chá. xià wǔ wǒ qù xué xiào.",
          "translation": {
            "fr": "J’achèterai des pommes et nous boirons du thé. L’après-midi, j’irai à l’école."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l39-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 35
      }
    },
