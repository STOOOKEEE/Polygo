    {
      "id": "block-lesson-39-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你几点到办公室？",
          "pinyin": "nǐ jǐ diǎn dào bàn gōng shì？",
          "translation": {
            "fr": "À quelle heure arrives-tu au bureau ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我八点半到，会议九点开始。",
          "pinyin": "wǒ bā diǎn bàn dào， huì yì jiǔ diǎn kāi shǐ。",
          "translation": {
            "fr": "J’arrive à huit heures et demie ; la réunion commence à neuf heures."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "经理在办公室吗？",
          "pinyin": "jīng lǐ zài bàn gōng shì ma？",
          "translation": {
            "fr": "Le manager est-il au bureau ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "在。他让大家安静地听。",
          "pinyin": "zài。 tā ràng dà jiā ān jìng dì tīng。",
          "translation": {
            "fr": "Oui. Il demande à tout le monde d’écouter calmement."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "今天的工作努力做完了吗？",
          "pinyin": "jīn tiān de gōng zuò nǔ lì zuò wán le ma？",
          "translation": {
            "fr": "As-tu fini sérieusement le travail d’aujourd’hui ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "做完了，下午还要开会。",
          "pinyin": "zuò wán le， xià wǔ hái yào kāi huì。",
          "translation": {
            "fr": "Oui, c’est fini ; nous avons encore une réunion l’après-midi."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 35
      }
    },
    {
      "id": "block-lesson-39-reading",
      "storyID": "story-lesson-39",
      "level": "HSK classique 3",
      "title": {
        "fr": "Au bureau"
      },
      "paragraphs": [
        {
          "id": "lesson-39-p1",
          "hanzi": "早上八点半，员工到办公室。经理九点开始会议。",
          "pinyin": "zǎo shàng bā diǎn bàn， yuán gōng dào bàn gōng shì。 jīng lǐ jiǔ diǎn kāi shǐ huì yì。",
          "translation": {
            "fr": "À huit heures et demie, les employés arrivent au bureau. Le manager commence la réunion à neuf heures."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-39-p2",
          "hanzi": "会议的时候大家安静地听。上午的工作做完以后，下午还有一次会议。",
          "pinyin": "huì yì de shí hòu dà jiā ān jìng dì tīng。 shàng wǔ de gōng zuò zuò wán yǐ hòu， xià wǔ hái yǒu yī cì huì yì。",
          "translation": {
            "fr": "Pendant la réunion, tout le monde écoute calmement. Après le travail du matin, il y a encore une réunion l’après-midi."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l39-reading"
      ],
      "kind": "reading",
      "metadata": {
