    {
      "id": "block-lesson-47-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你在图书馆学习什么？",
          "pinyin": "nǐ zài tú shū guǎn xué xí shén me？",
          "translation": {
            "fr": "Qu’étudies-tu à la bibliothèque ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我学习数学，准备考试。",
          "pinyin": "wǒ xué xí shù xué， zhǔn bèi kǎo shì。",
          "translation": {
            "fr": "J’étudie les mathématiques et je prépare l’examen."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "校长说今天要考试吗？",
          "pinyin": "xiào zhǎng shuō jīn tiān yào kǎo shì ma？",
          "translation": {
            "fr": "Le directeur dit-il qu’il y a un examen aujourd’hui ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不是，明天考试。我们一定要努力。",
          "pinyin": "bú shì， míng tiān kǎo shì。 wǒ men yí dìng yào nǔ lì。",
          "translation": {
            "fr": "Non, l’examen est demain. Nous devons absolument travailler dur."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你应该先读书还是先写字？",
          "pinyin": "nǐ yīng gāi xiān dú shū hái shì xiān xiě zì？",
          "translation": {
            "fr": "Devrais-tu d’abord lire ou écrire ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我应该先读书，然后写答案。",
          "pinyin": "wǒ yīng gāi xiān dú shū， rán hòu xiě dá àn。",
          "translation": {
            "fr": "Je devrais d’abord lire, puis écrire les réponses."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 43
      }
    },
    {
      "id": "block-lesson-47-reading",
      "storyID": "story-lesson-47",
      "level": "HSK classique 2",
      "title": {
        "fr": "La préparation"
      },
      "paragraphs": [
        {
          "id": "lesson-47-p1",
          "hanzi": "学生在图书馆学习数学。校长告诉大家明天考试。",
          "pinyin": "xué shēng zài tú shū guǎn xué xí shù xué。 xiào zhǎng gào sù dà jiā míng tiān kǎo shì。",
          "translation": {
            "fr": "Les étudiants étudient les mathématiques à la bibliothèque. Le directeur leur dit que l’examen est demain."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-47-p2",
          "hanzi": "他们一定要努力。学生应该先读书，再写答案。",
          "pinyin": "tā men yí dìng yào nǔ lì。 xué shēng yīng gāi xiān dú shū， zài xiě dá àn。",
          "translation": {
            "fr": "Ils doivent absolument travailler dur. Les étudiants devraient d’abord lire, puis écrire les réponses."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l47-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 43
      }
    },
