    {
      "id": "block-lesson-65-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你想去哪个国家？",
          "pinyin": "nǐ xiǎng qù nǎ ge guó jiā?",
          "translation": {
            "fr": "Dans quel pays veux-tu aller ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我想去法国。关于这个国家，我还想了解更多。",
          "pinyin": "wǒ xiǎng qù Fǎ guó. guān yú zhè ge guó jiā, wǒ hái xiǎng liǎo jiě gèng duō.",
          "translation": {
            "fr": "Je veux aller en France. Je veux encore mieux connaître ce pays."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "别忘记关窗，也要关心天气。",
          "pinyin": "bié wàng jì guān chuāng, yě yào guān xīn tiān qì.",
          "translation": {
            "fr": "N’oublie pas de fermer la fenêtre et pense aussi à la météo."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我记得。过去的旅行经验会帮助我。",
          "pinyin": "wǒ jì de. guò qù de lǚ xíng jīng yàn huì bāng zhù wǒ.",
          "translation": {
            "fr": "Je m’en souviens. Mon expérience passée du voyage m’aidera."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 61
      }
    },
    {
      "id": "block-lesson-65-reading",
      "storyID": "story-lesson-65",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une destination à découvrir"
      },
      "paragraphs": [
        {
          "id": "lesson-65-p1",
          "hanzi": "Tao准备去法国，想了解这个国家的生活。",
          "pinyin": "Tao zhǔn bèi qù Fǎ guó, xiǎng liǎo jiě zhè ge guó jiā de shēng huó.",
          "translation": {
            "fr": "Tao se prépare à aller en France et veut connaître la vie de ce pays."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-65-p2",
          "hanzi": "他关心天气，也记得离开以前关好窗。",
          "pinyin": "tā guān xīn tiān qì, yě jì de lí kāi yǐ qián guān hǎo chuāng.",
          "translation": {
            "fr": "Il pense à la météo et se souvient de bien fermer la fenêtre avant de partir."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l65-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 61
      }
