    {
      "id": "block-lesson-35-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你带什么回家？",
          "pinyin": "nǐ dài shén me huí jiā？",
          "translation": {
            "fr": "Qu’as-tu rapporté à la maison ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我带一个包，里面有菜。",
          "pinyin": "wǒ dài yí gè bāo， lǐ miàn yǒu cài。",
          "translation": {
            "fr": "J’ai rapporté un sac qui contient des légumes."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "冰箱在厨房吗？",
          "pinyin": "bīng xiāng zài chú fáng ma？",
          "translation": {
            "fr": "Le réfrigérateur est-il dans la cuisine ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是。灯在门上面，电梯在外面。",
          "pinyin": "shì。 dēng zài mén shàng miàn， diàn tī zài wài miàn。",
          "translation": {
            "fr": "Oui. La lampe est au-dessus de la porte et l’ascenseur est dehors."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你把牛奶放进去了吗？",
          "pinyin": "nǐ bǎ niú nǎi fàng jìn qù le ma？",
          "translation": {
            "fr": "As-tu mis le lait dedans ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "放好了，我要下楼拿另一个包。",
          "pinyin": "fàng hǎo le， wǒ yào xià lóu ná lìng yí gè bāo。",
          "translation": {
            "fr": "Oui, je l’ai rangé ; je vais descendre prendre un autre sac."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 31
      }
    },
    {
      "id": "block-lesson-35-reading",
      "storyID": "story-lesson-35",
      "level": "HSK classique 3",
      "title": {
        "fr": "Ranger les courses"
      },
      "paragraphs": [
        {
          "id": "lesson-35-p1",
          "hanzi": "Tao带着一个包进入厨房，把菜和牛奶放进冰箱。",
          "pinyin": "Tao dài zhe yí gè bāo jìn rù chú fáng， bǎ cài hé niú nǎi fàng jìn bīng xiāng。",
          "translation": {
            "fr": "Tao entre dans la cuisine avec un sac et met les légumes et le lait dans le réfrigérateur."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-35-p2",
          "hanzi": "厨房的灯很亮。电梯在门外，他下楼再拿一个包。",
          "pinyin": "chú fáng de dēng hěn liàng。 diàn tī zài mén wài， tā xià lóu zài ná yí gè bāo。",
          "translation": {
            "fr": "La lampe de la cuisine éclaire bien. L’ascenseur est devant la porte ; il redescend chercher un autre sac."
          },
          "segmentation": [],
          "audio": null
        }
      ],
