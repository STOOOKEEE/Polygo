    {
      "id": "block-lesson-35-dialogue",
      "lines": [
        {
          "speaker": "Tao",
          "hanzi": "你家有几个人？",
          "pinyin": "nǐ jiā yǒu jǐ gè rén?",
          "translation": {
            "fr": "Vous êtes combien chez toi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我家有五个人，爸爸、妈妈、哥哥、姐姐和我。",
          "pinyin": "wǒ jiā yǒu wǔ gè rén, bà ba, mā ma, gē ge, jiě jie hé wǒ.",
          "translation": {
            "fr": "On est cinq à la maison : papa, maman, mon frère, ma sœur et moi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你爸爸妈妈在法国吗？",
          "pinyin": "nǐ bà ba mā ma zài fǎ guó ma?",
          "translation": {
            "fr": "Tes parents sont en France ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "在！我想爸爸妈妈，也想家里的猫。",
          "pinyin": "zài! wǒ xiǎng bà ba mā ma, yě xiǎng jiā lǐ de māo.",
          "translation": {
            "fr": "Oui ! Mes parents me manquent, et le chat de la maison aussi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你的猫叫什么名字？",
          "pinyin": "nǐ de māo jiào shén me míng zi?",
          "translation": {
            "fr": "Comment il s’appelle, ton chat ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "叫白白，是白的，很小。",
          "pinyin": "jiào bái bái, shì bái de, hěn xiǎo.",
          "translation": {
            "fr": "Il s’appelle Baibai. Il est blanc et tout petit."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "白白喜欢在哪里？",
          "pinyin": "bái bái xǐ huān zài nǎ lǐ?",
          "translation": {
            "fr": "Où est-ce qu’il aime se mettre, Baibai ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "在门后面！爸爸喜欢白白，也喜欢我这个女儿！",
          "pinyin": "zài mén hòu miàn! bà ba xǐ huān bái bái, yě xǐ huān wǒ zhè gè nǚ ér!",
          "translation": {
            "fr": "Derrière la porte ! Papa adore Baibai, et moi, sa fille, aussi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你是爸爸的好女儿！你想回家吗？",
          "pinyin": "nǐ shì bà ba de hǎo nǚ ér! nǐ xiǎng huí jiā ma?",
          "translation": {
            "fr": "Tu es une bonne fille pour ton père ! Tu as envie de rentrer chez toi ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "很想！我想回家看猫，也想在这里学习汉语。",
          "pinyin": "hěn xiǎng! wǒ xiǎng huí jiā kàn māo, yě xiǎng zài zhè lǐ xué xí hàn yǔ.",
          "translation": {
            "fr": "Très envie ! J’aimerais rentrer voir mon chat, mais je veux aussi apprendre le chinois ici."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 31
      }
    },
    {
      "id": "block-lesson-35-reading",
      "storyID": "story-lesson-35",
      "level": "HSK classique 1",
      "title": {
        "fr": "Chez une amie"
      },
      "paragraphs": [
        {
          "id": "lesson-35-p1",
          "hanzi": "我的朋友在家，她的猫在桌子后面。猫很小，也很漂亮。",
          "pinyin": "wǒ de péng yǒu zài jiā, tā de māo zài zhuō zi hòu miàn. māo hěn xiǎo, yě hěn piào liàng.",
          "translation": {
            "fr": "Mon amie est chez elle, et son chat est derrière la table. Le chat est tout petit et très joli."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-35-p2",
          "hanzi": "桌子上有四个杯子，她爸爸和妈妈也在家。大家喝茶，猫在后面看我们。我很喜欢这个家，也想有猫。",
          "pinyin": "zhuō zi shàng yǒu sì gè bēi zi, tā bà ba hé mā ma yě zài jiā. dà jiā hē chá, māo zài hòu miàn kàn wǒ men. wǒ hěn xǐ huān zhè gè jiā, yě xiǎng yǒu māo.",
          "translation": {
            "fr": "Sur la table, il y a quatre tasses, et son père et sa mère sont là aussi. Tout le monde boit du thé, et le chat nous regarde de derrière. J’aime beaucoup cette maison et j’aimerais avoir un chat."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l35-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 31
      }
    },
