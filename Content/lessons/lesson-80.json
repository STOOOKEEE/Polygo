    {
      "id": "block-lesson-80-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你去过南方的农场吗？",
          "pinyin": "nǐ qù guo nán fāng de nóng chǎng ma?",
          "translation": {
            "fr": "Es-tu déjà allé dans une ferme du sud ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "去过。那里有一匹马，离车站三米远。",
          "pinyin": "qù guo. nà lǐ yǒu yì pǐ mǎ, lí chē zhàn sān mǐ yuǎn.",
          "translation": {
            "fr": "Oui. Il y a un cheval là-bas, à trois mètres de la gare."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你拿什么去农场？",
          "pinyin": "nǐ ná shén me qù nóng chǎng?",
          "translation": {
            "fr": "Qu’emportes-tu pour aller à la ferme ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "拿一袋米。马上出发。",
          "pinyin": "ná yí dài mǐ. mǎ shàng chū fā.",
          "translation": {
            "fr": "Un sac de riz. Je pars tout de suite."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 76
      }
    },
