    {
      "id": "block-lesson-42-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你哥哥坐几点的飞机？",
          "pinyin": "nǐ gē ge zuò jǐ diǎn de fēi jī?",
          "translation": {
            "fr": "Ton frère est dans l’avion de quelle heure ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "下午三点的。现在一点，我们去喝茶，好吗？",
          "pinyin": "xià wǔ sān diǎn de. xiàn zài yì diǎn, wǒ men qù hē chá, hǎo ma?",
          "translation": {
            "fr": "Celui de trois heures de l’après-midi. Il est une heure, on va boire un thé ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好！他在法国工作，是吗？",
          "pinyin": "hǎo! tā zài fǎ guó gōng zuò, shì ma?",
          "translation": {
            "fr": "Oui ! Il travaille en France, c’est ça ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "是，他二零一九年去的，我很想他。",
          "pinyin": "shì, tā èr líng yī jiǔ nián qù de, wǒ hěn xiǎng tā.",
          "translation": {
            "fr": "Oui, il y est allé en 2019, il me manque beaucoup."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我二零二二年来中国，也很想我的妈妈。",
          "pinyin": "wǒ èr líng èr èr nián lái zhōng guó, yě hěn xiǎng wǒ de mā ma.",
          "translation": {
            "fr": "Moi, je suis venue en Chine en 2022, et ma maman me manque aussi."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你想她，可以打电话。",
          "pinyin": "nǐ xiǎng tā, kě yǐ dǎ diàn huà.",
          "translation": {
            "fr": "Si elle te manque, tu peux lui téléphoner."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "昨天打电话了。你看，那个飞机来了！",
          "pinyin": "zuó tiān dǎ diàn huà le. nǐ kàn, nà ge fēi jī lái le!",
          "translation": {
            "fr": "Je l’ai fait hier. Regarde, l’avion arrive !"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我看见了！是三点的飞机。",
          "pinyin": "wǒ kàn jiàn le! shì sān diǎn de fēi jī.",
          "translation": {
            "fr": "Je le vois ! C’est l’avion de trois heures."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你看见你哥哥了吗？",
          "pinyin": "nǐ kàn jiàn nǐ gē ge le ma?",
          "translation": {
            "fr": "Tu vois ton frère ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "没有，人太多了。",
          "pinyin": "méi yǒu, rén tài duō le.",
          "translation": {
            "fr": "Non, il y a trop de monde."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我们去门旁边看，好吗？",
          "pinyin": "wǒ men qù mén páng biān kàn, hǎo ma?",
          "translation": {
            "fr": "On va regarder du côté de la porte ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好！你看，他在那里！",
          "pinyin": "hǎo! nǐ kàn, tā zài nà lǐ!",
          "translation": {
            "fr": "Oui ! Regarde, il est là-bas !"
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 38
      }
    },
    {
      "id": "block-lesson-42-reading",
      "storyID": "story-lesson-42",
      "level": "HSK classique 1",
      "title": {
        "fr": "Ma sœur revient de France"
      },
      "paragraphs": [
        {
          "id": "lesson-42-p1",
          "hanzi": "我哥哥二零一九年去法国工作。他在法国有很多朋友。今天他坐飞机回北京。",
          "pinyin": "wǒ gē ge èr líng yī jiǔ nián qù fǎ guó gōng zuò. tā zài fǎ guó yǒu hěn duō péng yǒu. jīn tiān tā zuò fēi jī huí běi jīng.",
          "translation": {
            "fr": "Mon frère est parti travailler en France en 2019. Il y a beaucoup d’amis. Aujourd’hui, il rentre à Pékin en avion."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-42-p2",
          "hanzi": "我们下午在机场看见了他。他很高兴，我也很高兴。",
          "pinyin": "wǒ men xià wǔ zài jī chǎng kàn jiàn le tā. tā hěn gāo xìng, wǒ yě hěn gāo xìng.",
          "translation": {
            "fr": "L’après-midi, nous l’avons vu à l’aéroport. Il est content, et moi aussi."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l42-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 38
      }
    },
