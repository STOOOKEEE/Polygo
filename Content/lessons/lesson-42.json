    {
      "id": "block-lesson-42-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你的行李箱在哪里？",
          "pinyin": "nǐ de xíng lǐ xiāng zài nǎ lǐ？",
          "translation": {
            "fr": "Où est ta valise ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "刚才还在这里，现在不见了。",
          "pinyin": "gāng cái hái zài zhè lǐ， xiàn zài bú jiàn le。",
          "translation": {
            "fr": "Elle était encore ici tout à l’heure, maintenant elle a disparu."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你坐火车还是坐飞机？",
          "pinyin": "nǐ zuò huǒ chē hái shì zuò fēi jī？",
          "translation": {
            "fr": "Tu prends le train ou l’avion ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "坐火车。我们回去找，或者问服务员。",
          "pinyin": "zuò huǒ chē。 wǒ men huí qù zhǎo， huò zhě wèn fú wù yuán。",
          "translation": {
            "fr": "Le train. Nous pouvons retourner la chercher ou demander au serveur."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "别难过，一会儿就能找到。",
          "pinyin": "bié nán guò， yī huì er jiù néng zhǎo dào。",
          "translation": {
            "fr": "Ne sois pas triste, nous la trouverons dans un moment."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，现在是三点一刻，我们还有时间。",
          "pinyin": "hǎo， xiàn zài shì sān diǎn yī kè， wǒ men hái yǒu shí jiān。",
          "translation": {
            "fr": "D’accord, il est trois heures et quart, nous avons encore le temps."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 38
      }
    },
    {
      "id": "block-lesson-42-reading",
      "storyID": "story-lesson-42",
      "level": "HSK classique 1",
      "title": {
        "fr": "À la gare"
      },
      "paragraphs": [
        {
          "id": "lesson-42-p1",
          "hanzi": "Tao刚才把行李箱放在车站，现在找不到了。他没有坐飞机，要坐火车。",
          "pinyin": "Tao gāng cái bǎ xíng lǐ xiāng fàng zài chē zhàn， xiàn zài zhǎo bú dào le。 tā méi yǒu zuò fēi jī， yào zuò huǒ chē。",
          "translation": {
            "fr": "Tao a posé sa valise à la gare tout à l’heure et ne la trouve plus. Il ne prend pas l’avion, il prend le train."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-42-p2",
          "hanzi": "他问服务员，决定回去找。三点一刻以后，他终于看见行李箱。",
          "pinyin": "tā wèn fú wù yuán， jué dìng huí qù zhǎo。 sān diǎn yī kè yǐ hòu， tā zhōng yú kàn jiàn xíng lǐ xiāng。",
          "translation": {
            "fr": "Il demande au serveur et décide de retourner la chercher. Après trois heures et quart, il voit enfin la valise."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l42-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 38
      }
    },
