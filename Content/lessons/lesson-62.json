    {
      "id": "block-lesson-62-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你对这张地图满意吗？",
          "pinyin": "nǐ duì zhè zhāng dì tú mǎn yì ma?",
          "translation": {
            "fr": "Es-tu satisfait de cette carte ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我不太满意，但是这条路比较难。",
          "pinyin": "wǒ bú tài mǎn yì, dàn shì zhè tiáo lù bǐ jiào nán.",
          "translation": {
            "fr": "Je ne suis pas très satisfait, mais cette route est assez difficile."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那个胖叔叔也在找车站。",
          "pinyin": "nà ge pàng shū shu yě zài zhǎo chē zhàn.",
          "translation": {
            "fr": "Cet oncle corpulent cherche aussi la gare."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "走另一边吧，那里更容易。",
          "pinyin": "zǒu lìng yì biān ba, nà lǐ gèng róng yì.",
          "translation": {
            "fr": "Prenons l’autre côté, c’est plus facile par là."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 58
      }
    },
    {
      "id": "block-lesson-62-reading",
      "storyID": "story-lesson-62",
      "level": "HSK classique 2",
      "title": {
        "fr": "Trouver une route plus facile"
      },
      "paragraphs": [
        {
          "id": "lesson-62-p1",
          "hanzi": "Tao对地图不太满意，一条路比较难，另一条路更容易。",
          "pinyin": "Tao duì dì tú bú tài mǎn yì, yì tiáo lù bǐ jiào nán, lìng yì tiáo lù gèng róng yì.",
          "translation": {
            "fr": "Tao n’est pas très satisfait de la carte : une route est assez difficile, l’autre est plus facile."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-62-p2",
          "hanzi": "Mina和Tao跟着另一条路去车站。",
          "pinyin": "Mina hé Tao gēn zhe lìng yì tiáo lù qù chē zhàn.",
          "translation": {
            "fr": "Mina et Tao suivent l’autre route jusqu’à la gare."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l62-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 58
      }
