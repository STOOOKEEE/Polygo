    {
      "id": "block-lesson-62-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你对这张地图满意吗？",
          "pinyin": "nǐ duì zhè zhāng dì tú mǎn yì ma?",
          "translation": {
            "fr": "Es-tu satisfait de cette carte ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我不太满意，但是这条路比较难。",
          "pinyin": "wǒ bú tài mǎn yì, dàn shì zhè tiáo lù bǐ jiào nán.",
          "translation": {
            "fr": "Je ne suis pas très satisfait, mais cette route est assez difficile."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "那个胖叔叔也在找车站。",
          "pinyin": "nà ge pàng shū shu yě zài zhǎo chē zhàn.",
          "translation": {
            "fr": "Cet oncle corpulent cherche aussi la gare."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "走另一边吧，那里更容易。",
          "pinyin": "zǒu lìng yì biān ba, nà lǐ gèng róng yì.",
          "translation": {
            "fr": "Prenons l’autre côté, c’est plus facile par là."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 58
      }
    },
    {
