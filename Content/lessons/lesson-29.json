    {
      "id": "block-lesson-29-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "天气冷了，我想买衣服。",
          "pinyin": "tiān qì lěng le, wǒ xiǎng mǎi yī fu.",
          "translation": {
            "fr": "Il fait froid maintenant, je veux acheter des vêtements."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "这家商店的衣服都很便宜。",
          "pinyin": "zhè jiā shāng diàn de yī fu dōu hěn pián yi.",
          "translation": {
            "fr": "Dans ce magasin, tous les vêtements sont bon marché."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你好，这个红的多少钱？",
          "pinyin": "nǐ hǎo, zhè gè hóng de duō shǎo qián?",
          "translation": {
            "fr": "Bonjour, il coûte combien, celui-ci, le rouge ?"
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "五十块。",
          "pinyin": "wǔ shí kuài.",
          "translation": {
            "fr": "Cinquante yuans."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这个太大了。有小的吗？",
          "pinyin": "zhè gè tài dà le. yǒu xiǎo de ma?",
          "translation": {
            "fr": "Celui-ci est trop grand. Vous en avez un plus petit ?"
          },
          "audio": null
        },
        {
          "speaker": "Lin",
          "hanzi": "有，小的都在这里。",
          "pinyin": "yǒu, xiǎo de dōu zài zhè lǐ.",
          "translation": {
            "fr": "Oui, les petits sont tous ici."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "太好了！我要这个小的。",
          "pinyin": "tài hǎo le! wǒ yào zhè gè xiǎo de.",
          "translation": {
            "fr": "Super ! Je prends celui-ci, le petit."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "五十块，很便宜！我也想买衣服。",
          "pinyin": "wǔ shí kuài, hěn pián yi! wǒ yě xiǎng mǎi yī fu.",
          "translation": {
            "fr": "Cinquante yuans, c’est vraiment pas cher ! Moi aussi, je veux acheter des vêtements."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "好！你买大的，我买小的。",
          "pinyin": "hǎo! nǐ mǎi dà de, wǒ mǎi xiǎo de.",
          "translation": {
            "fr": "Bonne idée ! Toi, tu prends le grand, moi le petit."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 25
      }
    },
    {
      "id": "block-lesson-29-reading",
      "storyID": "story-lesson-29",
      "level": "HSK classique 1",
      "title": {
        "fr": "Le rouge ou le blanc ?"
      },
      "paragraphs": [
        {
          "id": "lesson-29-p1",
          "hanzi": "今天很冷，我的妹妹想买衣服。她和朋友去商店，红衣服五十块，白衣服四十块。",
          "pinyin": "jīn tiān hěn lěng, wǒ de mèi mei xiǎng mǎi yī fu. tā hé péng yǒu qù shāng diàn, hóng yī fu wǔ shí kuài, bái yī fu sì shí kuài.",
          "translation": {
            "fr": "Aujourd’hui, il fait froid et ma petite sœur veut acheter des vêtements. Elle va au magasin avec un ami : les vêtements rouges coûtent cinquante yuans, les blancs quarante."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-29-p2",
          "hanzi": "白的比红的便宜，妹妹想买白的。朋友看了看，白的太小，天气很冷，要买大的。妹妹想了想，买了大的。",
          "pinyin": "bái de bǐ hóng de pián yi, mèi mei xiǎng mǎi bái de. péng yǒu kàn le kàn, bái de tài xiǎo, tiān qì hěn lěng, yào mǎi dà de. mèi mei xiǎng le xiǎng, mǎi le dà de.",
          "translation": {
            "fr": "Le blanc est moins cher que le rouge, alors ma sœur veut prendre le blanc. Son ami regarde : le blanc est trop petit, et il fait très froid, il faut prendre le grand. Ma sœur réfléchit un instant, puis achète le grand."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l29-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 25
      }
    },
