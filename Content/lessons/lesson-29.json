    {
      "id": "block-lesson-29-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "这件衣服多少钱？",
          "pinyin": "zhè jiàn yī fú duō shǎo qián？",
          "translation": {
            "fr": "Combien coûte ce vêtement ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "三百元，但是那件比较便宜。",
          "pinyin": "sān bǎi yuán， dàn shì nà jiàn bǐ jiào pián yi。",
          "translation": {
            "fr": "Trois cents yuans, mais celui-là est moins cher."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "这件很贵，我不买。",
          "pinyin": "zhè jiàn hěn guì， wǒ bù mǎi。",
          "translation": {
            "fr": "Celui-ci est très cher, je ne l’achète pas."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "你穿什么颜色？",
          "pinyin": "nǐ chuān shén me yán sè？",
          "translation": {
            "fr": "Quelle couleur portes-tu ?"
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "我穿红衣服。请找两件小的。",
          "pinyin": "wǒ chuān hóng yī fú。 qǐng zhǎo liǎng jiàn xiǎo de。",
          "translation": {
            "fr": "Je porte des vêtements rouges. Cherche deux petites tailles, s’il te plaît."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "好，离门近的衣服都在这里。",
          "pinyin": "hǎo， lí mén jìn de yī fú dōu zài zhè lǐ。",
          "translation": {
            "fr": "D’accord, les vêtements près de la porte sont tous ici."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 25
      }
    },
    {
      "id": "block-lesson-29-reading",
      "storyID": "story-lesson-29",
      "level": "HSK classique 2",
      "title": {
        "fr": "Au magasin"
      },
      "paragraphs": [
        {
          "id": "lesson-29-p1",
          "hanzi": "商店里有两件衣服：红的很贵，白的比较便宜。",
          "pinyin": "shāng diàn lǐ yǒu liǎng jiàn yī fú： hóng de hěn guì， bái de bǐ jiào pián yi。",
          "translation": {
            "fr": "Dans le magasin, il y a deux vêtements : le rouge est cher et le blanc est moins cher."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-29-p2",
          "hanzi": "顾客找小的衣服，最后买了两件，一共三百元。",
          "pinyin": "gù kè zhǎo xiǎo de yī fú， zuì hòu mǎi le liǎng jiàn， yī gòng sān bǎi yuán。",
          "translation": {
            "fr": "Le client cherche de petits vêtements et en achète finalement deux, pour trois cents yuans au total."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l29-reading"
      ],
      "kind": "reading",
      "metadata": {
