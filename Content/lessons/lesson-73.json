    {
      "id": "block-lesson-73-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "夏天的太阳很强，你想去哪里？",
          "pinyin": "xià tiān de tài yáng hěn qiáng, nǐ xiǎng qù nǎ lǐ?",
          "translation": {
            "fr": "Le soleil est fort en été ; où veux-tu aller ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "去动物园看熊猫，再听音乐。",
          "pinyin": "qù dòng wù yuán kàn xióng māo, zài tīng yīn yuè.",
          "translation": {
            "fr": "Au zoo pour voir les pandas, puis écouter de la musique."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你一边玩游戏，一边听吗？",
          "pinyin": "nǐ yì biān wán yóu xì, yì biān tīng ma?",
          "translation": {
            "fr": "Tu écoutes tout en jouant à un jeu ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "不，先看熊猫，晚上再玩游戏。",
          "pinyin": "bù, xiān kàn xióng māo, wǎn shang zài wán yóu xì.",
          "translation": {
            "fr": "Non, je regarde d’abord les pandas et je jouerai le soir."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 69
      }
    },
    {
      "id": "block-lesson-73-reading",
      "storyID": "story-lesson-73",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une sortie au zoo"
      },
      "paragraphs": [
        {
          "id": "lesson-73-p1",
          "hanzi": "夏天太阳很强，Tao和Mina先去动物园。",
          "pinyin": "xià tiān tài yáng hěn qiáng, Tao hé Mina xiān qù dòng wù yuán.",
          "translation": {
            "fr": "En été le soleil est fort ; Tao et Mina vont d’abord au zoo."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-73-p2",
          "hanzi": "他们看了熊猫，晚上回家听音乐、玩游戏。",
          "pinyin": "tā men kàn le xióng māo, wǎn shang huí jiā tīng yīn yuè, wán yóu xì.",
          "translation": {
            "fr": "Ils regardent les pandas puis rentrent le soir écouter de la musique et jouer."
          },
          "segmentation": [],
          "audio": null
        }
      ],
