  "id": "lesson-01",
  "moduleID": "unit-01",
  "order": 1,
  "title": {
    "fr": "Dire bonjour"
  },
  "summary": {
    "fr": "Saluer, remercier et prendre congé en faisant attention aux tons."
  },
  "estimatedMinutes": 7,
  "objectives": [
    {
      "id": "l1-greet-understand",
      "statement": {
        "fr": "Comprendre et choisir une salutation ou une formule de politesse simple."
      },
      "required": true
    },
    {
      "id": "l1-greet-tones",
      "statement": {
        "fr": "Identifier le ton principal de 早 et entendre la différence entre 你好 et 再见."
      },
      "required": true
    },
    {
      "id": "l1-greet-say",
      "statement": {
        "fr": "Dire 你好 et une formule de départ avec une intonation attentive."
      },
      "required": true
    },
    {
      "id": "l1-greet-write",
      "statement": {
        "fr": "Recopier 你 en respectant le modèle de traits fourni par l'application."
      },
      "required": true
    }
  ],
