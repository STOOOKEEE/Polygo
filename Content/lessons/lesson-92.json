    {
      "id": "block-lesson-92-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "谁照顾学校中间的花园？",
          "pinyin": "shuí zhào gù xué xiào zhōng jiān de huā yuán?",
          "translation": {
            "fr": "Qui s’occupe du jardin au milieu de l’école ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "学生们。我们种了两种花。",
          "pinyin": "xué shēng men. wǒ men zhòng le liǎng zhǒng huā.",
          "translation": {
            "fr": "Les élèves. Nous avons planté deux sortes de fleurs."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "主要的问题解决了吗？",
          "pinyin": "zhǔ yào de wèn tí jiě jué le ma?",
          "translation": {
            "fr": "Le problème principal est-il résolu ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "终于解决了，花也长大了。",
          "pinyin": "zhōng yú jiě jué le, huā yě zhǎng dà le.",
          "translation": {
            "fr": "Il est enfin résolu, et les fleurs ont grandi."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 88
      }
    },
    {
      "id": "block-lesson-92-reading",
      "storyID": "story-lesson-92",
      "level": "HSK classique 3",
      "title": {
        "fr": "Le jardin au centre de l’école"
      },
      "paragraphs": [
        {
          "id": "lesson-92-p1",
          "hanzi": "学生在学校中间种了两种花，老师和同学一起照顾。",
          "pinyin": "xué shēng zài xué xiào zhōng jiān zhòng le liǎng zhǒng huā, lǎo shī hé tóng xué yì qǐ zhào gù.",
          "translation": {
            "fr": "Les élèves ont planté deux sortes de fleurs au milieu de l’école ; le professeur et les camarades s’en occupent ensemble."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-92-p2",
          "hanzi": "主要问题是没有水，后来他们找到办法，花终于长大了。",
          "pinyin": "zhǔ yào wèn tí shì méi yǒu shuǐ, hòu lái tā men zhǎo dào bàn fǎ, huā zhōng yú zhǎng dà le.",
          "translation": {
            "fr": "Le problème principal était le manque d’eau ; ils ont trouvé une solution et les fleurs ont enfin grandi."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l92-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 88
      }
    },
