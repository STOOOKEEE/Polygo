      },
      "paragraphs": [
        {
          "id": "lesson-93-p1",
          "hanzi": "最近Tao自己安排学习和休息，不再着急。",
          "pinyin": "zuì jìn Tao zì jǐ ān pái xué xí hé xiū xi, bú zài zháo jí.",
          "translation": {
            "fr": "Récemment, Tao organise lui-même ses études et son repos sans se presser."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-93-p2",
          "hanzi": "他注意每天的节奏，也祝朋友学习顺利。",
          "pinyin": "tā zhù yì měi tiān de jié zòu, yě zhù péng you xué xí shùn lì.",
          "translation": {
            "fr": "Il fait attention au rythme de chaque journée et souhaite aussi de bonnes études à son ami."
          },
          "segmentation": [],
          "audio": null
