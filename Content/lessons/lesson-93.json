    {
      "id": "block-lesson-93-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "最近你的学习怎么样？",
          "pinyin": "zuì jìn nǐ de xué xí zěn me yàng?",
          "translation": {
            "fr": "Comment se passent tes études récemment ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我自己安排时间，已经不着急了。",
          "pinyin": "wǒ zì jǐ ān pái shí jiān, yǐ jīng bù zháo jí le.",
          "translation": {
            "fr": "J’organise moi-même mon temps et je ne suis plus pressé."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你注意休息了吗？",
          "pinyin": "nǐ zhù yì xiū xi le ma?",
          "translation": {
            "fr": "As-tu pensé à te reposer ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "注意了。祝你也找到自己的节奏。",
          "pinyin": "zhù yì le. zhù nǐ yě zhǎo dào zì jǐ de jié zòu.",
          "translation": {
            "fr": "Oui. Je te souhaite aussi de trouver ton propre rythme."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 89
      }
    },
    {
      "id": "block-lesson-93-reading",
      "storyID": "story-lesson-93",
      "level": "HSK classique 3",
      "title": {
        "fr": "Une semaine mieux organisée"
      },
      "paragraphs": [
        {
          "id": "lesson-93-p1",
          "hanzi": "最近Tao自己安排学习和休息，不再着急。",
          "pinyin": "zuì jìn Tao zì jǐ ān pái xué xí hé xiū xi, bú zài zháo jí.",
          "translation": {
            "fr": "Récemment, Tao organise lui-même ses études et son repos sans se presser."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-93-p2",
          "hanzi": "他注意每天的节奏，也祝朋友学习顺利。",
          "pinyin": "tā zhù yì měi tiān de jié zòu, yě zhù péng you xué xí shùn lì.",
          "translation": {
            "fr": "Il fait attention au rythme de chaque journée et souhaite aussi de bonnes études à son ami."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l93-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 89
      }
