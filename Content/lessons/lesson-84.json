        "vocab-wo",
        "vocab-hsk20-115"
      ],
      "metadata": {
        "stage": "observe",
        "skill": "recognition",
        "lessonDay": 80
      }
    },
    {
      "id": "block-lesson-84-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "虽然这篇文章很难，但是很有文化。",
          "pinyin": "suī rán zhè piān wén zhāng hěn nán, dàn shì hěn yǒu wén huà.",
          "translation": {
            "fr": "Même si cet article est difficile, il est très riche culturellement."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "我的中文水平提高了。",
          "pinyin": "wǒ de Zhōng wén shuǐ píng tí gāo le.",
          "translation": {
            "fr": "Mon niveau de chinois s’est amélioré."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "你最喜欢哪一段？",
          "pinyin": "nǐ zuì xǐ huan nǎ yí duàn?",
          "translation": {
            "fr": "Quel passage préfères-tu ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "最后一段，故事特别有意思，而且很有文化。",
          "pinyin": "zuì hòu yí duàn, gù shi tè bié yǒu yì si, ér qiě hěn yǒu wén huà.",
          "translation": {
            "fr": "Le dernier passage : l’histoire est particulièrement intéressante et riche culturellement."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 80
      }
    },
    {
      "id": "block-lesson-84-reading",
      "storyID": "story-lesson-84",
      "level": "HSK classique 3",
      "title": {
        "fr": "Un passage qui fait progresser"
      },
      "paragraphs": [
        {
          "id": "lesson-84-p1",
          "hanzi": "文章虽然难，但是Tao认真学习，中文水平提高了。",
          "pinyin": "wén zhāng suī rán nán, dàn shì Tao rèn zhēn xué xí, Zhōng wén shuǐ píng tí gāo le.",
          "translation": {
            "fr": "Même si l’article est difficile, Tao étudie sérieusement et son niveau de chinois s’améliore."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-84-p2",
          "hanzi": "他最喜欢最后一段，因为故事特别有意思。",
          "pinyin": "tā zuì xǐ huan zuì hòu yí duàn, yīn wèi gù shi tè bié yǒu yì si.",
          "translation": {
            "fr": "Il préfère le dernier passage parce que l’histoire est particulièrement intéressante."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l84-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 80
      }
    },
