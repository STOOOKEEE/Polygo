    {
      "id": "block-lesson-76-dialogue",
      "lines": [
        {
          "speaker": "Mina",
          "hanzi": "你看今天的节目吗？",
          "pinyin": "nǐ kàn jīn tiān de jié mù ma?",
          "translation": {
            "fr": "Tu regardes l’émission d’aujourd’hui ?"
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "看。先看表演，然后听老师讲节日。",
          "pinyin": "kàn. xiān kàn biǎo yǎn, rán hòu tīng lǎo shī jiǎng jié rì.",
          "translation": {
            "fr": "Oui. Je regarde d’abord le spectacle, puis j’écoute le professeur parler de la fête."
          },
          "audio": null
        },
        {
          "speaker": "Mina",
          "hanzi": "天上的云很好看。",
          "pinyin": "tiān shàng de yún hěn hǎo kàn.",
          "translation": {
            "fr": "Les nuages dans le ciel sont très beaux."
          },
          "audio": null
        },
        {
          "speaker": "Tao",
          "hanzi": "节目结束以后，我们一起回家。",
          "pinyin": "jié mù jié shù yǐ hòu, wǒ men yì qǐ huí jiā.",
          "translation": {
            "fr": "Quand l’émission sera finie, nous rentrerons ensemble."
          },
          "audio": null
        }
      ],
      "kind": "dialogue",
      "metadata": {
        "stage": "understand",
        "skill": "listening",
        "lessonDay": 72
      }
    },
    {
      "id": "block-lesson-76-reading",
      "storyID": "story-lesson-76",
      "level": "HSK classique 3",
      "title": {
        "fr": "Le programme de la fête"
      },
      "paragraphs": [
        {
          "id": "lesson-76-p1",
          "hanzi": "节目先介绍节日，再播放一个表演。",
          "pinyin": "jié mù xiān jiè shào jié rì, zài bō fàng yí ge biǎo yǎn.",
          "translation": {
            "fr": "L’émission présente d’abord la fête, puis diffuse un spectacle."
          },
          "segmentation": [],
          "audio": null
        },
        {
          "id": "lesson-76-p2",
          "hanzi": "云在天上慢慢移动，节目结束时大家一起回家。",
          "pinyin": "yún zài tiān shàng màn man yí dòng, jié mù jié shù shí dà jiā yì qǐ huí jiā.",
          "translation": {
            "fr": "Les nuages se déplacent lentement dans le ciel ; à la fin de l’émission, tout le monde rentre ensemble."
          },
          "segmentation": [],
          "audio": null
        }
      ],
      "comprehensionExerciseIDs": [
        "ex-l76-reading"
      ],
      "kind": "reading",
      "metadata": {
        "stage": "transfer",
        "skill": "reading",
        "lessonDay": 72
      }
    },
